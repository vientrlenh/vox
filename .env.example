# Copy this file to `.env` and replace the placeholder values. Never commit `.env` or real secrets.
# Every variable that is not commented out below has no default in src/main/resources/application.yaml,
# so the application will not start without it.

# ---------------------------------------------------------------------------
# Database (PostgreSQL 18)
# DB_URL is host:port only; the JDBC prefix and DB_NAME are added by application.yaml.
# ---------------------------------------------------------------------------
DB_URL=localhost:5432
DB_NAME=vox
DB_USER=postgres
DB_PASSWORD=postgres

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-secret
JWT_STREAM_SECRET=replace-with-another-long-random-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend URLs the backend redirects to.
OAUTH2_URL=http://localhost:3000
PASSWORD_SETUP_URL=http://localhost:3000/setup-password

# ---------------------------------------------------------------------------
# Admin console (/admin). The application refuses to start when either is blank.
# ---------------------------------------------------------------------------
SBA_ADMIN_USERNAME=admin
SBA_ADMIN_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Mail (SMTP)
# ---------------------------------------------------------------------------
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-smtp-password
# MAIL_FROM=your-email@example.com
# MAIL_FROM_DISPLAY_NAME=VOX

# ---------------------------------------------------------------------------
# Initial system admin account, created on first startup
# ---------------------------------------------------------------------------
SYS_ADMIN_EMAIL=admin@example.com
SYS_ADMIN_PASSWORD=change-me
SYS_ADMIN_PHONE=0123456789
SYS_ADMIN_FULLNAME=System Admin
SYS_ADMIN_DATE_OF_BIRTH=1990-01-01
SYS_ADMIN_ADDRESS=Admin address

# ---------------------------------------------------------------------------
# Host ports published by docker-compose.yml
# ---------------------------------------------------------------------------
APP_PORT=8081
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092
KAFKA_UI_PORT=8089

# ---------------------------------------------------------------------------
# Optional. The values shown are the defaults unless noted otherwise.
# ---------------------------------------------------------------------------

# Redis and Kafka
# REDIS_HOST=localhost
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Web security
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# COOKIE_SECURE=false
# COOKIE_SAME_SITE=Lax
# COOKIE_DOMAIN=
# JWT_EXPIRATION_MS=900000

# Link to the vox-streaming service. GRPC_SERVICE_TOKEN must match the one configured there.
# VOX_STREAMING_GRPC_TARGET=0.0.0.0:9096
# GRPC_SERVICE_TOKEN=

# Object storage (S3 or S3-compatible). STORAGE_PROVIDER is empty by default.
# STORAGE_PROVIDER=
# AWS_REGION=ap-southeast-1
# AWS_S3_BUCKET=
# AWS_S3_ENDPOINT=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# RECORDING_S3_BUCKET=

# Payments: PayOS
# PAYOS_CLIENT_ID=
# PAYOS_API_KEY=
# PAYOS_CHECKSUM_KEY=
# PAYOS_RETURN_URL=
# PAYOS_CANCEL_URL=

# Payments: SePay (SEPAY_ENV is SANDBOX or PRODUCTION)
# SEPAY_ENV=SANDBOX
# SEPAY_MERCHANT_ID=
# SEPAY_SECRET_KEY=
# SEPAY_IPN_SECRET_KEY=
# SEPAY_PAYMENT_METHOD=BANK_TRANSFER

# Push notifications (Firebase). Set either the credentials path or the JSON, not both.
# FIREBASE_ENABLED=false
# FIREBASE_CREDENTIALS_PATH=
# FIREBASE_CREDENTIALS_JSON=

# Seed data
# DATA_INITIALIZER=true
# DEMO_DATA_ENABLED=false
# DEMO_DATA_PASSWORD=Password@123
