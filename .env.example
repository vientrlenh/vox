# Copy this file to `.env` and replace the placeholder values. Never commit `.env` or real secrets.
# Every variable that is not commented out below has no default in src/main/resources/application.yaml,
# so the application will not start without it.

# ---------------------------------------------------------------------------
# Database (PostgreSQL 18)
# DB_URL is host:port only; the JDBC prefix and DB_NAME are added by application.yaml.
# ---------------------------------------------------------------------------
DB_URL=localhost:5432
DB_NAME=vox
DB_USER=postgres
DB_PASSWORD=postgres

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-secret
JWT_STREAM_SECRET=replace-with-another-long-random-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend URLs the backend redirects to.
OAUTH2_URL=http://localhost:3000
PASSWORD_SETUP_URL=http://localhost:3000/setup-password

# ---------------------------------------------------------------------------
# Admin console (/admin). The application refuses to start when either is blank.
# ---------------------------------------------------------------------------
SBA_ADMIN_USERNAME=admin
SBA_ADMIN_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Mail (SMTP)
# ---------------------------------------------------------------------------
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-smtp-password
# MAIL_FROM=your-email@example.com
# MAIL_FROM_DISPLAY_NAME=VOX

# ---------------------------------------------------------------------------
# Initial system admin account, created on first startup
# ---------------------------------------------------------------------------
SYS_ADMIN_EMAIL=admin@example.com
SYS_ADMIN_PASSWORD=change-me
SYS_ADMIN_PHONE=0123456789
SYS_ADMIN_FULLNAME=System Admin
SYS_ADMIN_DATE_OF_BIRTH=1990-01-01
SYS_ADMIN_ADDRESS=Admin address

# ---------------------------------------------------------------------------
# Host ports published by docker-compose.yml
# ---------------------------------------------------------------------------
APP_PORT=8081
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092
KAFKA_UI_PORT=8089

# ---------------------------------------------------------------------------
# Optional. The values shown are the defaults unless noted otherwise.
# ---------------------------------------------------------------------------

# Redis and Kafka (KAFKA_*_TOPIC and KAFKA_*_GROUP_ID can also be overridden; see application.yaml)
# REDIS_HOST=localhost
# REDIS_TIMEOUT=2s
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# KAFKA_GROUP_ID=vox

# Flyway: keep clean disabled outside throwaway databases
# FLYWAY_CLEAN_DISABLED=true

# HTTPS
# SSL_ENABLED=false
# SSL_CERT_PATH=
# SSL_KEY_PATH=

# Frontend and sign-in
# GOOGLE_ALLOWED_AUDIENCES=
# NOTIFICATION_URL=
# AVATAR_ALLOWED_HOSTS=

# Practice and personalization
# PRACTICE_INTERNAL_SECRET=
# PRACTICE_HEARTBEAT_CLEANUP_MS=30000
# PERSONALIZATION_QUIZ_ITEM_COUNT=7
# PERSONALIZATION_PAPER_TARGET_QUESTION_COUNT=4
# PERSONALIZATION_ONLINE_CANDIDATE_COUNT=2
# PERSONALIZATION_ONLINE_GENERATION_BUDGET=45s

# Push notification device retention
# NOTIFICATION_DEVICE_RETENTION_DAYS=90

# Web security
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# COOKIE_SECURE=false
# COOKIE_SAME_SITE=Lax
# COOKIE_DOMAIN=
# JWT_EXPIRATION_MS=900000

# Link to the vox-streaming service. GRPC_SERVICE_TOKEN must match the one configured there.
# VOX_STREAMING_GRPC_TARGET=0.0.0.0:9096
# GRPC_SERVICE_TOKEN=

# Object storage (S3 or S3-compatible). STORAGE_PROVIDER is empty by default.
# STORAGE_PROVIDER=
# AWS_REGION=ap-southeast-1
# AWS_S3_BUCKET=
# AWS_S3_ENDPOINT=
# AWS_S3_KEY_PREFIX=
# AWS_S3_PUBLIC_BASE_URL=
# AWS_S3_PATH_STYLE=false
# AWS_S3_PUBLIC_READ=true
# AWS_S3_ENSURE_BUCKET=false
# AWS_S3_ENSURE_FAIL_FAST=false
# AWS_S3_UPLOADER_ARN=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# RECORDING_S3_BUCKET=

# Payments: PayOS
# PAYOS_CLIENT_ID=
# PAYOS_API_KEY=
# PAYOS_CHECKSUM_KEY=
# PAYOS_RETURN_URL=
# PAYOS_CANCEL_URL=

# Payments: SePay (SEPAY_ENV is SANDBOX or PRODUCTION)
# SEPAY_ENV=SANDBOX
# SEPAY_MERCHANT_ID=
# SEPAY_SECRET_KEY=
# SEPAY_IPN_SECRET_KEY=
# SEPAY_PAYMENT_METHOD=BANK_TRANSFER
# SEPAY_RETURN_BASE_URL=   (falls back to BASE_URL)
# BASE_URL=

# Quota and exchange rate tuning (empty means the built-in default)
# VOX_QUOTA_ESTIMATED_COST_PER_ASSESSMENT_SECOND_USD=
# VOX_QUOTA_ESTIMATED_COST_PER_PRACTICE_SECOND_USD=
# VOX_QUOTA_CALIBRATION_WINDOW_DAYS=
# VOX_QUOTA_CALIBRATION_MIN_SAMPLE_SESSIONS=
# VOX_QUOTA_CALIBRATION_MAX_CHANGE_RATIO=
# VOX_QUOTA_CALIBRATION_MIN_RATE_BOUND=
# VOX_QUOTA_CALIBRATION_MAX_RATE_BOUND=
# VOX_QUOTA_DEBT_CAP_RATIO=
# VOX_QUOTA_USAGE_WARNING_RATIO=
# VOX_QUOTA_USD_TO_VND_RATE=
# VOX_QUOTA_SERVICE_FEE_RATIO=
# VOX_EXCHANGE_RATE_API_BASE_URL=
# VOX_EXCHANGE_RATE_MIN_RATE_BOUND=
# VOX_EXCHANGE_RATE_MAX_RATE_BOUND=

# Push notifications (Firebase). Set either the credentials path or the JSON, not both.
# FIREBASE_ENABLED=false
# FIREBASE_CREDENTIALS_PATH=
# FIREBASE_CREDENTIALS_JSON=

# Seed data
# DATA_INITIALIZER=true
# DEMO_DATA_ENABLED=false
# DEMO_DATA_PASSWORD=Password@123
