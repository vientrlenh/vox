%% Gộp toàn bộ state machine của nhóm entity "exam" vào 1 diagram (mỗi entity là 1 composite state)
stateDiagram-v2
    state "Exam" as Exam {
        state "DRAFT" as EX_DRAFT
        state "SCHEDULED" as EX_SCHEDULED
        state "IN_PROGRESS" as EX_IN_PROGRESS
        state "CLOSED" as EX_CLOSED
        state "RESULTS_PUBLISHED" as EX_RESULTS_PUBLISHED
        state "CANCELLED" as EX_CANCELLED
        [*] --> EX_DRAFT : tạo kỳ thi
        EX_DRAFT --> EX_SCHEDULED : lên lịch thi
        EX_SCHEDULED --> EX_IN_PROGRESS : đến giờ, mở ca thi
        EX_IN_PROGRESS --> EX_CLOSED : hết thời gian thi
        EX_CLOSED --> EX_RESULTS_PUBLISHED : công bố kết quả
        EX_DRAFT --> EX_CANCELLED : huỷ kỳ thi
        EX_SCHEDULED --> EX_CANCELLED : huỷ kỳ thi
        EX_RESULTS_PUBLISHED --> [*]
        EX_CANCELLED --> [*]
    }

    state "ExamSecurePool" as ExamSecurePool {
        state "SEALED" as SP_SEALED
        state "RELEASED" as SP_RELEASED
        [*] --> SP_SEALED : tạo bộ đề bảo mật
        SP_SEALED --> SP_RELEASED : mở niêm phong
        SP_RELEASED --> [*]
    }

    state "ExamPaper" as ExamPaper {
        state "DRAFT" as EP_DRAFT
        state "IN_REVIEW" as EP_IN_REVIEW
        state "APPROVED" as EP_APPROVED
        state "LOCKED" as EP_LOCKED
        [*] --> EP_DRAFT : tạo đề thi
        EP_DRAFT --> EP_IN_REVIEW : gửi duyệt đề
        EP_IN_REVIEW --> EP_DRAFT : yêu cầu chỉnh sửa lại
        EP_IN_REVIEW --> EP_APPROVED : duyệt đề đạt
        EP_APPROVED --> EP_LOCKED : khoá đề khi đến giờ thi
        EP_LOCKED --> [*]
    }

    state "ExamCandidate" as ExamCandidate {
        state "ASSIGNED" as EC_ASSIGNED
        state "COMPLETED" as EC_COMPLETED
        state "ABSENT" as EC_ABSENT
        state "EXEMPTED" as EC_EXEMPTED
        state "CANCELLED" as EC_CANCELLED
        [*] --> EC_ASSIGNED : gán thí sinh vào ca thi
        EC_ASSIGNED --> EC_COMPLETED : hoàn thành bài thi
        EC_ASSIGNED --> EC_ABSENT : vắng thi
        EC_ASSIGNED --> EC_EXEMPTED : được miễn / hoãn thi
        EC_ASSIGNED --> EC_CANCELLED : huỷ tư cách dự thi
        EC_COMPLETED --> [*]
        EC_ABSENT --> [*]
        EC_EXEMPTED --> [*]
        EC_CANCELLED --> [*]
    }

    state "ExamSession" as ExamSession {
        state "IN_PROGRESS" as ES_IN_PROGRESS
        state "SUBMITTED" as ES_SUBMITTED
        state "GRADING" as ES_GRADING
        state "GRADED" as ES_GRADED
        state "EXPIRED" as ES_EXPIRED
        state "GRADING_FAILED" as ES_GRADING_FAILED
        [*] --> ES_IN_PROGRESS : thí sinh bắt đầu làm bài
        ES_IN_PROGRESS --> ES_SUBMITTED : nộp bài
        ES_IN_PROGRESS --> ES_EXPIRED : hết giờ chưa nộp
        ES_SUBMITTED --> ES_GRADING : hệ thống (AI) chấm bài
        ES_GRADING --> ES_GRADED : chấm xong
        ES_GRADING --> ES_GRADING_FAILED : AI chấm lỗi
        ES_GRADING_FAILED --> ES_GRADING : chấm lại
        ES_GRADED --> [*]
        ES_EXPIRED --> [*]
    }

    state "ExamItemEvaluation" as ExamItemEvaluation {
        state "AUTO_GRADED" as EIE_AUTO_GRADED
        state "UNDER_REVIEW" as EIE_UNDER_REVIEW
        state "FINALIZED" as EIE_FINALIZED
        state "SUPERSEDED" as EIE_SUPERSEDED
        [*] --> EIE_AUTO_GRADED : AI chấm câu trả lời
        EIE_AUTO_GRADED --> EIE_FINALIZED : không cần review, chốt điểm
        EIE_AUTO_GRADED --> EIE_UNDER_REVIEW : đưa vào hàng chờ người chấm
        EIE_UNDER_REVIEW --> EIE_FINALIZED : người chấm xác nhận / sửa điểm
        EIE_FINALIZED --> EIE_SUPERSEDED : có lượt chấm lại thay thế
        EIE_FINALIZED --> [*]
        EIE_SUPERSEDED --> [*]
    }

    state "ExamCandidateResult" as ExamCandidateResult {
        state "PENDING_REVIEW" as ECR_PENDING_REVIEW
        state "RELEASED" as ECR_RELEASED
        state "APPEALED" as ECR_APPEALED
        state "RE_GRADING" as ECR_RE_GRADING
        state "FINAL" as ECR_FINAL
        state "INVALID" as ECR_INVALID
        state "RETAKE_REQUIRED" as ECR_RETAKE_REQUIRED
        [*] --> ECR_PENDING_REVIEW : có câu cần người chấm review
        ECR_PENDING_REVIEW --> ECR_RELEASED : công bố kết quả
        ECR_RELEASED --> ECR_FINAL : hết hạn khiếu nại, chốt kết quả
        ECR_RELEASED --> ECR_APPEALED : thí sinh khiếu nại
        ECR_APPEALED --> ECR_RE_GRADING : chấm lại theo khiếu nại
        ECR_RE_GRADING --> ECR_FINAL : kết quả chấm lại được chốt
        ECR_RE_GRADING --> ECR_INVALID : kết quả bị huỷ
        ECR_RE_GRADING --> ECR_RETAKE_REQUIRED : yêu cầu thi lại
        ECR_FINAL --> [*]
        ECR_INVALID --> [*]
        ECR_RETAKE_REQUIRED --> [*]
    }

    state "ExamAppeal" as ExamAppeal {
        state "PENDING" as EA_PENDING
        state "AUTO_REGRADING" as EA_AUTO_REGRADING
        state "RESOLVED_NO_CHANGE" as EA_RESOLVED_NO_CHANGE
        state "RESOLVED_CHANGED" as EA_RESOLVED_CHANGED
        state "ESCALATED" as EA_ESCALATED
        state "HUMAN_RESOLVED" as EA_HUMAN_RESOLVED
        state "REJECTED" as EA_REJECTED
        [*] --> EA_PENDING : thí sinh gửi khiếu nại
        EA_PENDING --> EA_AUTO_REGRADING : hệ thống tự chấm lại (bậc 1)
        EA_PENDING --> EA_REJECTED : khiếu nại không hợp lệ
        EA_AUTO_REGRADING --> EA_RESOLVED_NO_CHANGE : chấm lại, không đổi điểm
        EA_AUTO_REGRADING --> EA_RESOLVED_CHANGED : chấm lại, đổi điểm
        EA_AUTO_REGRADING --> EA_ESCALATED : đẩy lên người chấm (bậc 2)
        EA_ESCALATED --> EA_HUMAN_RESOLVED : người chấm xử lý xong
        EA_RESOLVED_NO_CHANGE --> [*]
        EA_RESOLVED_CHANGED --> [*]
        EA_HUMAN_RESOLVED --> [*]
        EA_REJECTED --> [*]
    }

    Exam --> ExamSecurePool : tạo bộ đề bảo mật cho kỳ thi
    Exam --> ExamPaper : tạo đề thi cho kỳ thi
    Exam --> ExamCandidate : gán thí sinh dự thi
    ExamCandidate --> ExamSession : thí sinh vào thi
    ExamSession --> ExamItemEvaluation : chấm từng câu trả lời
    ExamItemEvaluation --> ExamCandidateResult : tổng hợp kết quả
    ExamCandidateResult --> ExamAppeal : thí sinh khiếu nại kết quả
