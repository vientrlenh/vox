"""
COMPARING đã bị bỏ cùng bước admin công bố: chỉ còn MỘT người chấm, và người đó nộp
điểm là công bố luôn. WITHDRAWN là học sinh tự rút khi đơn còn PENDING.
"""
enum AppealStatus {
    PENDING
    APPROVED
    GRADING
    PUBLISHED
    REJECTED
    WITHDRAWN
}

type AppealStats {
    pending: Int!
    processing: Int!   # APPROVED + GRADING
    published: Int!
    rejected: Int!
    "Học sinh tự rút — tách khỏi rejected vì đó là quyết định của học sinh"
    withdrawn: Int!
}

type AppealCriterionScore {
    criterionId: ID!
    criterionCode: String!
    label: String!
    score: Float!
    rationale: String
}

"One question-answer turn in the speaking assessment. Each turn has its own audio/transcript."
type AppealTurn {
    id: ID!
    turnOrder: Int!
    turnType: TurnType!
    promptText: String
    audioUrl: String
    transcript: String
    durationSeconds: Int
}

"Một phần thi được phúc khảo, kèm dữ liệu để đối chiếu."
type AppealItem {
    appealItemId: ID!
    paperItemId: ID!
    partLabel: String
    """
    Điểm tiêu chí của bản chấm đang có hiệu lực: vòng đầu là bản AI, vòng phúc khảo
    sau là bản chấm tay của vòng trước. Khớp với originalScore hiển thị cạnh nó.
    """
    baselineScores: [AppealCriterionScore!]!
    "Luôn lấy từ bản AI — chỉ bản AI mới có lượt nói"
    turns: [AppealTurn!]!
    "Điểm công bố cho phần này; null khi chưa công bố"
    finalScore: Float
}

"""
The appeal grader -- only ONE person, and the data comes from the assignment row of the APPEAL round
(the assessment_appeal_reviewers table has been dropped).
"""
type AppealReviewer {
    assignmentId: ID!
    reviewerId: ID!
    reviewerName: String
    "ASSIGNED | COMPLETED"
    status: GradingAssignmentStatus!
    "UPHELD | REGRADED | DECLINED; null until submitted"
    outcome: GradingOutcome
    assignedAt: DateTime
    completedAt: DateTime
    deadlineAt: DateTime
    overdue: Boolean!
}

type AppealSummary {
    id: ID!
    studentName: String!
    className: String
    assessmentName: String!
    "Labels of the parts being appealed"
    partLabels: [String!]!
    originalScore: Float
    status: AppealStatus!
    requestedAt: DateTime!
    deadline: DateTime
    "The only grader; null when nobody is assigned yet"
    reviewerName: String
    reviewerStatus: GradingAssignmentStatus
    "The appeal is still being processed and is past its deadline"
    overdue: Boolean!
}

type AppealSummaryPage {
    content: [AppealSummary!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type AppealDetail {
    id: ID!
    studentName: String!
    className: String
    assessmentName: String!
    originalScore: Float
    status: AppealStatus!
    requestedAt: DateTime!
    deadline: DateTime
    reason: String!
    notes: String
    decisionNote: String
    "score_after — only present once PUBLISHED"
    finalScore: Float
    approvedAt: DateTime
    resolvedAt: DateTime
    withdrawnAt: DateTime
    "The reason the admin assigned someone who had already graded this attempt; null when there is no override"
    reviewerOverrideReason: String
    "The parts being appealed, each with its original score and its own spoken turns"
    items: [AppealItem!]!
    "Only ONE grader; null when nobody is assigned yet"
    reviewer: AppealReviewer
    "The appeal is still being processed and is past its deadline"
    overdue: Boolean!
    "The rubric scoring scale — the range the BE validates criterion scores against when regrading"
    scoringScaleMin: Float!
    scoringScaleMax: Float!
}

"""
Ứng viên cho picker phân công. Người xung đột lợi ích KHÔNG bị lọc bỏ mà mang cờ
`conflicted` — admin cần thấy họ để hiểu vì sao lựa chọn hẹp, và vẫn override được.
"""
type AppealReviewerLite {
    id: ID!
    name: String!
    "Số phân công đang mở đang giữ, gộp cả bốn vòng"
    load: Int!
    "Đã từng ghi điểm tay cho chính bài này"
    conflicted: Boolean!
    """
    Hồ sơ giám khảo, nạp qua DataLoader `userById`. Dùng cho ảnh đại diện trong picker phân công.

    An toàn với luật ẩn danh vì type này CHỈ xuất hiện trong `appealReviewers` -- truy vấn của
    school admin lúc chọn người chấm. Nó KHÔNG nằm trong AppealSummaryPage/AppealDetail, tức là
    không với tới được từ `myAppeals` của học sinh. Đừng thêm field kiểu này vào hai type kia.
    """
    user: User
}

extend type Query {
    "Danh sách đơn phúc khảo của trường. Phân trang 0-based."
    appeals(status: AppealStatus, keyword: String, page: Int = 1, size: Int = 20): AppealSummaryPage!

    """
    Đơn phúc khảo của MỘT kỳ thi, cho chủ tịch kỳ thi đó. Tách khỏi `appeals` vì màn đó
    quét toàn trường -- nới nó ra là mở dữ liệu phúc khảo của cả trường cho một giáo viên.

    Nhận mọi loại kỳ thi (trước đây tên là `classTestAppeals` và chỉ nhận bài trên lớp):
    chủ tịch kỳ thi tập trung là người bấm nút công bố kết quả, mà đơn phúc khảo còn mở là
    một trong hai thứ chặn nút đó. Chỉ trả DANH SÁCH -- quyền duyệt/từ chối đơn và quyền
    mở chi tiết đơn vẫn thuộc nhà trường.
    """
    assessmentAppeals(
        assessmentId: ID!,
        status: AppealStatus,
        keyword: String,
        page: Int = 1,
        size: Int = 20
    ): AppealSummaryPage!

    appealStats: AppealStats!

    "Chốt quyền nằm trong use case: school admin cùng trường, hoặc giáo viên tạo bài kiểm tra trên lớp đó."
    appeal(id: ID!): AppealDetail!

    """
    Danh sách đơn phúc khảo của học sinh đang đăng nhập. Dùng chung type AppealSummaryPage
    với school admin -- FE (web/mobile) KHÔNG được hỏi/hiện reviewerName cho học sinh
    (blind re-evaluation), nhưng chặn ở tầng UI thay vì tầng schema.
    """
    myAppeals(status: AppealStatus, page: Int = 1, size: Int = 20): AppealSummaryPage!

    """
    Chi tiết một đơn thuộc học sinh đang đăng nhập. Dùng chung type AppealDetail với school
    admin -- cùng lưu ý như myAppeals, FE không được hỏi/hiện field reviewer.
    """
    myAppeal(id: ID!): AppealDetail!

    """
    Ứng viên chấm phúc khảo cho một đơn. `appealId` là bắt buộc về mặt nghiệp vụ —
    cờ `conflicted` tính theo bài thi của đơn đó, bỏ trống thì mọi người đều hiện
    `conflicted: false`.
    """
    appealReviewers(appealId: ID, keyword: String): [AppealReviewerLite!]!
}