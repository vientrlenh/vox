"""
COMPARING was removed together with the admin publish step: there is now only ONE reviewer, and when that person submits
a score it is published right away. WITHDRAWN is when the student withdraws while the appeal is still PENDING.
"""
enum AppealStatus {
    PENDING
    APPROVED
    GRADING
    PUBLISHED
    REJECTED
    WITHDRAWN
}

type AppealStats {
    pending: Int!
    processing: Int!   # APPROVED + GRADING
    published: Int!
    rejected: Int!
    "The student withdraws on their own -- kept apart from rejected because it is the student's decision"
    withdrawn: Int!
}

type AppealCriterionScore {
    criterionId: ID!
    criterionCode: String!
    label: String!
    score: Float!
    rationale: String
}

"One question-answer turn in the speaking assessment. Each turn has its own audio/transcript."
type AppealTurn {
    id: ID!
    turnOrder: Int!
    turnType: TurnType!
    promptText: String
    audioUrl: String
    transcript: String
    durationSeconds: Int
}

"One part of an exam under appeal, with the data to compare against."
type AppealItem {
    appealItemId: ID!
    paperItemId: ID!
    partLabel: String
    """
    Criterion scores of the grading currently in effect: in the first round it is the AI grading, in the appeal round
    it is the previous round's manual grading. Matches the originalScore shown next to it.
    """
    baselineScores: [AppealCriterionScore!]!
    "Always taken from the AI version -- only the AI version has speaking turns"
    turns: [AppealTurn!]!
    "Score published for this part; null when not yet published"
    finalScore: Float
}

"""
The appeal grader -- only ONE person, and the data comes from the assignment row of the APPEAL round
(the assessment_appeal_reviewers table has been dropped).
"""
type AppealReviewer {
    assignmentId: ID!
    reviewerId: ID!
    reviewerName: String
    "ASSIGNED | COMPLETED"
    status: GradingAssignmentStatus!
    "UPHELD | REGRADED | DECLINED; null until submitted"
    outcome: GradingOutcome
    assignedAt: DateTime
    completedAt: DateTime
    deadlineAt: DateTime
    overdue: Boolean!
}

type AppealSummary {
    id: ID!
    studentName: String!
    className: String
    assessmentName: String!
    "Labels of the parts being appealed"
    partLabels: [String!]!
    originalScore: Float
    status: AppealStatus!
    requestedAt: DateTime!
    deadline: DateTime
    "The only grader; null when nobody is assigned yet"
    reviewerName: String
    reviewerStatus: GradingAssignmentStatus
    "The appeal is still being processed and is past its deadline"
    overdue: Boolean!
}

type AppealSummaryPage {
    content: [AppealSummary!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type AppealDetail {
    id: ID!
    studentName: String!
    className: String
    assessmentName: String!
    originalScore: Float
    status: AppealStatus!
    requestedAt: DateTime!
    deadline: DateTime
    reason: String!
    notes: String
    decisionNote: String
    "score_after — only present once PUBLISHED"
    finalScore: Float
    approvedAt: DateTime
    resolvedAt: DateTime
    withdrawnAt: DateTime
    "The reason the admin assigned someone who had already graded this attempt; null when there is no override"
    reviewerOverrideReason: String
    "The parts being appealed, each with its original score and its own spoken turns"
    items: [AppealItem!]!
    "Only ONE grader; null when nobody is assigned yet"
    reviewer: AppealReviewer
    "The appeal is still being processed and is past its deadline"
    overdue: Boolean!
    "The rubric scoring scale — the range the BE validates criterion scores against when regrading"
    scoringScaleMin: Float!
    scoringScaleMax: Float!
}

"""
Candidates for the assignment picker. People with a conflict of interest are NOT filtered out but carry the flag
`conflicted` -- the admin needs to see them to understand why the choice is narrow, and can still override.
"""
type AppealReviewerLite {
    id: ID!
    name: String!
    "Number of open assignments held, across all four rounds"
    load: Int!
    "Has previously entered a manual score for this very submission"
    conflicted: Boolean!
    """
    Examiner profile, loaded through the `userById` DataLoader. Used for the avatar in the assignment picker.

    Safe with respect to the anonymity rule because this type appears ONLY in `appealReviewers` -- the school
    admin's query when choosing a reviewer. It is NOT in AppealSummaryPage/AppealDetail, so it
    cannot be reached from the student's `myAppeals`. Do not add fields of this kind to those two types.
    """
    user: User
}

extend type Query {
    "The school's list of appeals. Pagination is 0-based."
    appeals(status: AppealStatus, keyword: String, page: Int = 1, size: Int = 20): AppealSummaryPage!

    """
    Appeals of ONE exam, for the chair of that exam. Separate from `appeals` because that screen
    scans the whole school -- widening it would open the school's appeal data to a single teacher.

    Accepts every kind of exam (previously named `classTestAppeals` and accepting only class tests):
    the chair of a centralized exam is the person who presses the publish-results button, and an open appeal is
    one of the two things that block that button. Returns only the LIST -- the right to approve/reject appeals and the right to
    open appeal details still belong to the school.
    """
    assessmentAppeals(
        assessmentId: ID!,
        status: AppealStatus,
        keyword: String,
        page: Int = 1,
        size: Int = 20
    ): AppealSummaryPage!

    appealStats: AppealStats!

    "The permission check lives in the use case: a school admin of the same school, or the teacher who created the class test for that class."
    appeal(id: ID!): AppealDetail!

    """
    List of appeals of the logged-in student. Shares the AppealSummaryPage type
    with the school admin -- the FE (web/mobile) must NOT query/show reviewerName to students
    (blind re-evaluation), but this is blocked at the UI layer instead of the schema layer.
    """
    myAppeals(status: AppealStatus, page: Int = 1, size: Int = 20): AppealSummaryPage!

    """
    Details of one appeal belonging to the logged-in student. Shares the AppealDetail type with the school
    admin -- same caveat as myAppeals, the FE must not query/show the reviewer field.
    """
    myAppeal(id: ID!): AppealDetail!

    """
    Appeal-review candidates for one appeal. `appealId` is required in business terms --
    the `conflicted` flag is computed against that appeal's exam submission, and when it is omitted everyone shows up
    `conflicted: false`.
    """
    appealReviewers(appealId: ID, keyword: String): [AppealReviewerLite!]!
}