enum GradingAssignmentStatus {
    ASSIGNED
    COMPLETED
}

"""
Grading round. A submission goes through several rounds over time, each round with one assignment row
and at most one open row.
"""
enum GradingRoundType {
    "First grading of a submission awaiting grading"
    INITIAL
    "Post-check of a published submission — the submission KEEPS its RELEASED status throughout"
    SPOT_CHECK
    "Re-examination of an invalidated submission"
    REMEDIATION
    "Appeal grading driven by the student's appeal; submitting publishes"
    APPEAL
}

"The teacher's conclusion when closing an assignment."
enum GradingOutcome {
    "Keep the existing score"
    UPHELD
    "Re-graded, the score changes"
    REGRADED
    "Violation found -> submission becomes INVALID"
    INVALIDATED
    "No violation found -> INVALID is lifted"
    CLEARED_INVALID
    "The teacher returns the assignment"
    DECLINED
}

"How the set of submissions is chosen for automatic assignment."
enum GradingSampleSelectionMode {
    ALL
    "Randomly pick N% — used for post-checks"
    RANDOM_PERCENT
    "Prefer submissions where the AI is less confident / the score is close to the pass threshold"
    RISK_BASED
    MANUAL_LIST
}

"Progress of one teacher within the scope being viewed."
type GradingTeacherProgress {
    teacherId: ID!
    teacherName: String
    assigned: Int!
    completed: Int!
    overdue: Int!
    "Teacher profile, loaded through the `userById` DataLoader. Used for the avatar."
    teacher: User
}

"Number of attempts in one result status."
type GradingResultStatusCount {
    status: AssessmentCandidateResultStatus!
    count: Int!
}

"""
Number cards at the top of the dispatch screen. The denominator is ALL submissions in the scope being viewed — unlike the old version,
which only counted submissions awaiting grading, because the admin now dispatches all four rounds.
"""
type GradingStats {
    total: Int!
    byResultStatus: [GradingResultStatusCount!]!
    """
    Submissions that can still receive a grading round (PENDING_REVIEW / RELEASED / INVALID / APPEALED /
    RE_GRADING) but have no open assignment. Submissions whose lifecycle has ended are not counted here.
    """
    unassigned: Int!
    "Open assignments"
    assigned: Int!
    "Open assignments that are overdue"
    overdue: Int!
    teacherProgress: [GradingTeacherProgress!]!
}

"One question-answer turn in a part of the assessment. A part has MANY turns, each with its own audio/transcript."
type GradingTurn {
    id: ID!
    turnOrder: Int
    turnType: TurnType
    promptText: String
    audioUrl: String
    transcript: String
    durationSeconds: Int
    wordCount: Int
    asrConfidence: Float
    "JSON string — the overall pronunciation score of the turn. The FE parses it, same as AssessmentItemEvaluationTurn."
    pronunciationOverall: String
    "JSON string — array of WordFeedback (a chip per word + phoneme details)"
    wordFeedback: String
}

type GradingCriterionScore {
    criterionId: ID!
    criterionCode: String
    label: String
    score: Float
    rationale: String
}

"""
Rubric criterion with the REAL score range. The FE builds the input cells from minScore/maxScore here,
not hardcoded 0-9 — each rubric has a different scale.
"""
type GradingCriterionMeta {
    id: ID!
    code: String
    label: String
    description: String
    minScore: Float
    maxScore: Float
    "Weight used to convert criterion scores into the part score"
    weight: Float
    required: Boolean!
}

"""
ONE QUESTION to grade, not one exam part — a part (section) can have many questions.
`partLabel` is the section title so many items share one label; the FE adds
`orderInSection` to tell them apart.
"""
type GradingTaskItem {
    paperItemId: ID!
    responseId: ID!
    partLabel: String
    "The section containing this question. Group questions by this ID, NOT by partLabel — two sections can have the same name."
    sectionId: ID
    "Order of the question within the section, starting from 1"
    orderInSection: Int!
    """
    The question text — same source as the Result screen (`questions.question_text`).
    Null when the paper item points to no question or the question has been deleted.
    DIFFERENT from `GradingTurn.promptText`: that one is what the AI said when entering the turn, not the question text.
    """
    questionText: String
    """
    Resource attached to the question (image / audio / video / passage). Null when the question has none.
    Without it a teacher grading a picture-description question only sees the question text and the transcript, not the picture —
    so the answer cannot be matched against what the candidate actually saw/heard.
    """
    asset: QuestionAsset
    "Score of the grading currently in effect (the AI score at first) — the reference point to compare against"
    currentItemScore: Float
    currentFeedbackSummary: String
    currentScores: [GradingCriterionScore!]!
    "Always taken from the AI version — only the AI version produces speaking turns"
    turns: [GradingTurn!]!
    """
    Criterion scores with the rationale of the AI VERSION. Different from `currentScores`: after manual grading,
    the version in effect is the HUMAN one so the AI's rationale disappears from `currentScores`,
    while the teacher in the appeal round still needs to read what the AI reasoned.
    """
    aiScores: [GradingCriterionScore!]!
    aiOverallConfidence: Float
    aiFeedbackSummary: String
    aiRequiresHumanReview: Boolean!
    aiReviewReasonCode: String
    aiMarkedInvalid: Boolean!
    aiRequiresRetake: Boolean!
    "JSON string — EvaluationSignals (audioQuality, audioGateStatus, evidenceStatus, confidenceMode…)"
    aiSignals: String
    "JSON string — ValidityResult, containing ruleResults[] for the Rule violations block"
    aiValidity: String
}

"""
The teacher's grading screen.

Centralized assessments are graded anonymously (`studentName`/`className` = null). Class tests
carry them, because the grader is the very teacher who teaches that class.
"""
type GradingTaskDetail {
    assignmentId: ID!
    candidateResultId: ID!
    "The first 8 hex characters of candidateResultId, upper-cased (for example A2041F3C)"
    resultCode: String!
    assessmentName: String
    roundType: GradingRoundType!
    assignmentStatus: GradingAssignmentStatus!
    resultStatus: AssessmentCandidateResultStatus
    flagged: Boolean!
    flagReason: String
    currentTotalScore: Float
    "The score when the assignment was given — the reference point so the teacher knows what they are editing from"
    scoreBefore: Float
    deadlineAt: DateTime
    overdue: Boolean!
    """
    Read-only flag decided by the BE: true only when the assignment is still ASSIGNED and the attempt is still in
    the right status for the round. The FE builds the review mode from this flag and does not derive it from status.
    """
    editable: Boolean!
    """
    The actions allowed in this round, decided by the BE according to GradingRoundPolicy.
    The FE builds exactly these buttons and does NOT derive them from roundType — deriving them in two places means
    the two places drift apart sooner or later.
    """
    allowedOutcomes: [GradingOutcome!]!
    "Only in the APPEAL round: the reason the student gave in the appeal"
    appealReason: String
    items: [GradingTaskItem!]!
    criteria: [GradingCriterionMeta!]!
    """
    The student's name. ONLY present for class tests; a centralized assessment is always null because
    anonymous grading guarantees fairness. The FE renders it conditionally, no separate on/off flag is needed.
    """
    studentName: String
    "The student's class. Same rule as studentName."
    className: String
    "The session being graded — two attempts of the same student differ here."
    sessionId: ID
    "Which attempt this is, counted from 1 by the time the student started the assessment."
    attemptNo: Int!
    "Total number of attempts that student has made. When it equals 1 the FE does not show an attempt label."
    attemptCount: Int!
}

"The teacher's queue — ONE list for all four rounds. Centralized assessments are graded anonymously."
type GradingTask {
    assignmentId: ID!
    candidateResultId: ID!
    resultCode: String!
    assessmentName: String
    "Number of parts to grade"
    partCount: Int!
    roundType: GradingRoundType!
    status: GradingAssignmentStatus!
    resultStatus: AssessmentCandidateResultStatus
    "The current score of the attempt — in the spot-check/appeal rounds this is the published score"
    currentScore: Float
    flagged: Boolean!
    assignedAt: DateTime
    deadlineAt: DateTime
    overdue: Boolean!
    """
    The student's name. ONLY present for class tests; a centralized assessment is always null because
    anonymous grading guarantees fairness. The FE renders it conditionally, no separate on/off flag is needed.
    """
    studentName: String
    "The student's class. Same rule as studentName."
    className: String
    "The session that produced this attempt — two attempts of the same student differ here."
    sessionId: ID
    "Which attempt this is, counted from 1 by the time the student started the assessment."
    attemptNo: Int!
    "Total number of attempts that student has made. When it equals 1 the FE does not show an attempt label."
    attemptCount: Int!
}

type GradingTaskPage {
    content: [GradingTask!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

"""
A row of the school admin's coordination table. The admin sees the student's name normally.

One row is ONE ATTEMPT: a student who retakes has that many rows with the same name, told apart by
`attemptNo`/`attemptCount`.
"""
type GradingAssignmentRow {
    candidateResultId: ID!
    resultCode: String!
    studentName: String
    className: String
    assessmentName: String
    resultStatus: AssessmentCandidateResultStatus
    totalScore: Float
    flagged: Boolean!
    "null means the attempt has no open assignment"
    assignmentId: ID
    teacherId: ID
    teacherName: String
    roundType: GradingRoundType
    assignmentStatus: GradingAssignmentStatus
    outcome: GradingOutcome
    assignedAt: DateTime
    completedAt: DateTime
    deadlineAt: DateTime
    overdue: Boolean!
    "There is an unfinished appeal — another round should not be assigned right now"
    hasOpenAppeal: Boolean!
    "The session that produced this attempt — two attempts of the same student differ here."
    sessionId: ID
    "Which attempt this is, counted from 1 by the time the student started the assessment."
    attemptNo: Int!
    "Total number of attempts that student has made. When it equals 1 the FE does not show an attempt label."
    attemptCount: Int!
}

type GradingAssignmentRowPage {
    content: [GradingAssignmentRow!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

"A teacher who can take submissions, with the current load."
type AssignableTeacher {
    id: ID!
    name: String
    "Number of open assignments held, across all four rounds"
    load: Int!
    """
    The user profile of this teacher, loaded through the `userById` DataLoader -- no extra join added to
    the read model. Only query it when the avatar is needed; `name` above is enough for everything else.
    """
    user: User
}

"""
An entry in the exam filter of the teacher queue. Deliberately thin — this is a dropdown, not
an exam screen: every field added here is one more field a teacher can read about a centralized
exam they are not a member of.
"""
type GradingAssessmentOption {
    id: ID!
    "Exam code — exam names repeat across rounds, codes do not."
    code: String
    name: String
    "Total submissions assigned in this exam, across all four rounds and including closed assignments"
    taskCount: Int!
    "Of which still to be graded (ASSIGNED)"
    openTaskCount: Int!
}

"Who/what changed the status of an attempt."
enum ResultStatusChangeSource {
    AI_EVALUATION
    TEACHER_INITIAL
    TEACHER_SPOT_CHECK
    TEACHER_REMEDIATION
    TEACHER_APPEAL
    ADMIN_BULK_FINALIZE
    ASSESSMENT_PUBLISH
    SYSTEM
}

"""
One milestone in the score timeline. An append-only table: nothing can be edited here.
`actorName` null means the system changed it itself (the AI finished grading, the finalize job).
"""
type ResultStatusHistoryEntry {
    id: ID!
    candidateResultId: ID!
    "null when this is the first milestone of the attempt"
    fromStatus: AssessmentCandidateResultStatus
    toStatus: AssessmentCandidateResultStatus!
    scoreBefore: Float
    scoreAfter: Float
    source: ResultStatusChangeSource!
    actorId: ID
    actorName: String
    reason: String
    createdAt: DateTime!
}

"AI quality per post-check teacher."
type AiQualityByTeacher {
    teacherId: ID
    teacherName: String
    reviewed: Int!
    regraded: Int!
    "Mean absolute deviation over the submissions this person corrected"
    averageDelta: Float
    "Teacher profile, loaded through the `userById` DataLoader. null when teacherId is null."
    teacher: User
}

"""
"How far off the AI grades", measured from the post-check data itself. The denominator is the completed
SPOT_CHECK rounds — INITIAL rounds are not counted because there the AI was not yet considered final.
"""
type AiQualityReport {
    reviewed: Int!
    upheld: Int!
    regraded: Int!
    invalidated: Int!
    "Percentage of submissions whose score was corrected; null when no submission has been post-checked yet"
    regradeRate: Float
    "Mean absolute deviation, counted only over submissions whose score was corrected"
    averageDelta: Float
    maxDelta: Float
    byTeacher: [AiQualityByTeacher!]!
}

extend type Query {
    """
    The school's grading coordination table. Lists attempts in EVERY status (the old version was hard-locked
    to PENDING_REVIEW), including attempts nobody has been assigned. Paging is 0-based.
    `search` matches the student name, the teacher name or the attempt code.
    """
    gradingAssignments(
        assessmentId: ID,
        scheduleId: ID,
        teacherId: ID,
        resultStatus: AssessmentCandidateResultStatus,
        roundType: GradingRoundType,
        status: GradingAssignmentStatus,
        unassignedOnly: Boolean,
        overdueOnly: Boolean,
        hasOpenAppeal: Boolean,
        search: String,
        """
        Empty = CENTRALIZED. The school coordinates centralized assessments; pass
        CLASS_TEST when used for the screen that tracks the grading of class tests.
        """
        kind: AssessmentKind,
        page: Int = 1,
        "At most 100 — a larger value is clamped to 100 instead of reporting an error."
        size: Int = 20
    ): GradingAssignmentRowPage!

    "Same `kind` rule as `gradingAssignments` — the two places must count over the same set."
    gradingStats(assessmentId: ID, scheduleId: ID, kind: AssessmentKind): GradingStats!

    """
    Grading progress of ONE class test, for the teacher who created it. Separate from
    `gradingStats` because there an empty `assessmentId` means the whole school -- widening the permission there would let
    a teacher read the grading progress of the whole school.
    """
    classTestGradingStats(assessmentId: ID!): GradingStats!

    """
    Queue of submissions of the logged-in teacher, across all four rounds. Pagination is 0-based.
    ONLY centralized exams — class tests go through `myClassTestGradingTasks`.
    """
    myGradingTasks(
        """
        Narrow to ONE exam. Empty = every exam in which the teacher has submissions. This is purely a
        filter, not a permission gate: the scope is still the caller's own assignments,
        so the id of an exam in which they have no submissions just yields an empty list.
        The list of exams to fill the dropdown comes from `myGradingAssessments`.
        """
        assessmentId: ID,
        status: GradingAssignmentStatus,
        roundType: GradingRoundType,
        page: Int = 1,
        "At most 100 — a larger value is clamped to 100 rather than reporting an error."
        size: Int = 20
    ): GradingTaskPage!

    """
    The assessments used to build the filter for `myGradingTasks`: ONLY the CENTRALIZED assessments for which the
    logged-in teacher currently has, or HAS had, a grading assignment get listed first. Not
    paged -- this set is closed by the number of assignments of ONE person.

    It needs its own query because `assessments` is not the path here: its visibility rule requires
    the caller to be an admin or an assessment member, while a teacher grading a centralized assessment is not
    a member -- asking there only returns an empty list.

    An assessment that has been fully graded stays in the list: submitting the last attempt and having the selected item
    vanish from the dropdown right under the user's hand is a bug, not a feature.
    """
    myGradingAssessments: [GradingAssessmentOption!]!

    """
    EVERY attempt of one class test, for the teacher who created it — including attempts with NO
    assignment. `myClassTestGradingTasks` only returns attempts assigned to the caller, so an attempt the AI graded
    cleanly (it goes straight to RELEASED and no assignment is opened) never shows up there;
    this is where the teacher sees them and takes the `candidateResultId` to press Take grading.
    One row is one ATTEMPT: a student who retakes has as many rows as attempts.
    """
    classTestGradingResults(
        assessmentId: ID!,
        resultStatus: AssessmentCandidateResultStatus,
        "Only attempts with no open assignment — exactly the ones that still need to be taken for grading."
        unassignedOnly: Boolean,
        search: String,
        page: Int = 1,
        "At most 100 — a larger value is clamped to 100 instead of reporting an error."
        size: Int = 20
    ): GradingAssignmentRowPage!

    myClassTestGradingTasks(
        assessmentId: ID!,
        status: GradingAssignmentStatus,
        roundType: GradingRoundType,
        page: Int = 1,
        size: Int = 20
    ): GradingTaskPage!

    gradingTaskDetail(assignmentId: ID!): GradingTaskDetail!

    "Used for both the automatic assignment modal and the dropdown for manual assignment / changing teacher."
    assignableTeachers(search: String): [AssignableTeacher!]!

    """
    Score timeline of one submission, oldest first. A student can view their OWN,
    a school admin can view submissions of their school, a teacher can view submissions they HAVE
    EVER been assigned to grade — even after that assignment has closed, because in the appeal round the person
    who graded the previous round is exactly the one being questioned.
    """
    resultStatusHistory(candidateResultId: ID!): [ResultStatusHistoryEntry!]!

    "AI quality report. Leave assessmentId empty to see the whole school."
    aiQualityReport(assessmentId: ID): AiQualityReport!
}