enum AssessmentKind {
    CENTRALIZED
    CLASS_TEST
}

enum AssessmentDeliveryMode {
    STUDENT_DEVICE
    LAB
}

enum AssessmentRequiredStreamType {
    CAMERA
    SCREEN
    CAMERA_AND_SCREEN
}

enum AssessmentStreamTypePermission {
    ANY
    ALL
}

enum AssessmentStatus {
    DRAFT
    SCHEDULED
    IN_PROGRESS
    CLOSED
    RESULTS_PUBLISHED
    CANCELLED
}

enum ResultDecisionMethod {
    HIGHEST
    LATEST
    AVERAGE
    FIRST
    LOWEST
}

enum AssessmentMemberRole {
    CHAIR
    AUTHOR
    REVIEWER
}

enum AssessmentBlueprintVersionStatus {
    DRAFT
    PUBLISHED
    ARCHIVED
}

enum AssessmentBlueprintSlotType {
    FIXED
    SELECTION
}

enum AssessmentPaperStatus {
    DRAFT
    IN_REVIEW
    APPROVED
    LOCKED
}

enum AssessmentScheduleStatus {
    DRAFT
    PUBLISHED
    COMPLETED
    MOVED
    CANCELLED
    DELETED
}

enum AssessmentCandidateStatus {
    ASSIGNED
    ATTENDED
    ABSENT
    COMPLETED
    EXEMPTED
    CANCELLED
}

enum AssessmentSessionStatus {
    IN_PROGRESS
    SUBMITTED
    INTERRUPTED
    GRADING
    GRADED
    EXPIRED
    GRADING_FAILED
    """Đã xoá mềm. Chỉ xuất hiện ở đường đọc của quản trị trường / chủ tịch hội đồng."""
    DELETED
}
enum AssessmentSecurePoolStatus {
    SEALED
    RELEASED
}

enum AssessmentSecurePoolReleaseMode {
    MANUAL
    AUTO_AFTER_CLOSE
}

enum AssessmentRecordingStreamType {
    CAMERA
    SCREEN
}

enum AssessmentRecordingAssemblyStatus {
    PROCESSING
    READY
    PARTIAL
    FAILED
    ABANDONED
}

enum TurnType {
    MAIN
    FOLLOWUP
}

enum AssessmentEvaluationEngineType {
    AI_SINGLE
    AI_ENSEMBLE
    HUMAN
}

enum AssessmentItemEvaluationStatus {
    AUTO_GRADED
    UNDER_REVIEW
    FINALIZED
    SUPERSEDED
}

type QuestionSelectionSpec {
    questionType: QuestionType
    difficulty: QuestionDifficulty
    targetBandLevel: String
    skillCode: String
    topicId: ID
}

type AssessmentMember {
    id: ID!
    userId: ID!
    role: AssessmentMemberRole!
    grantedAt: DateTime
    grantedBy: ID
    user: User
}

type AssessmentSecurePool {
    id: ID!
    assessmentId: ID!
    status: AssessmentSecurePoolStatus!
    releaseMode: AssessmentSecurePoolReleaseMode!
    embargoUntil: DateTime
    releasedAt: DateTime
    releasedBy: ID
}

type AssessmentPaperItem {
    id: ID!
    blueprintSlotId: ID
    sectionId: ID!
    paperId: ID!
    questionId: ID
    order: Int!
    weight: Float
    """
    Loại ô trong blueprint sinh ra câu này. null khi câu không sinh từ blueprint,
    hoặc khi slot tương ứng đã bị xoá — cả hai trường hợp đều được phép gán câu tự do.
    """
    slotType: AssessmentBlueprintSlotType
    """Tiêu chí rút câu của ô SELECTION; null với ô FIXED và câu không sinh từ blueprint."""
    selectionSpec: QuestionSelectionSpec
    question: Question
}

type AssessmentPaperSection {
    id: ID!
    paperId: ID!
    order: Int!
    title: String
    instruction: String
    weight: Float
    sectionTimeLimitSeconds: Int
    createdAt: DateTime
    updatedAt: DateTime
    createdBy: ID
    updatedBy: ID
    items: [AssessmentPaperItem!]!
}

type AssessmentPaper {
    id: ID!
    assessmentId: ID!
    blueprintVersionId: ID
    code: String!
    variant: Int!
    status: AssessmentPaperStatus!
    timeDurationSeconds: Int
    createdAt: DateTime
    updatedAt: DateTime
    createdBy: ID
    updatedBy: ID
    sections: [AssessmentPaperSection!]!
}

type Assessment {
    id: ID!
    blueprintId: ID
    blueprintVersionId: ID
    blueprint: AssessmentBlueprint
    blueprintVersion: AssessmentBlueprintVersion
    code: String!
    name: String!
    description: String
    schoolId: ID!
    languageId: ID!
    kind: AssessmentKind!
    deliveryMode: AssessmentDeliveryMode
    status: AssessmentStatus!
    maxAttempt: Int
    assessmentTimeDurationSecond: Int
    resultDecisionMethod: ResultDecisionMethod
    openAt: DateTime
    closeAt: DateTime
    assessmentPolicyId: ID
    requiresOtp: Boolean!
    """AI confidence threshold (percentage 0-100). null = not set, the system uses the hard rules."""
    aiConfidenceThresholdPercent: Float
    requiredStreamType: AssessmentRequiredStreamType
    streamTypePermission: AssessmentStreamTypePermission
    papersLocked: Boolean
    createdAt: DateTime
    updatedAt: DateTime
    createdBy: ID
    updatedBy: ID
    members: [AssessmentMember!]!
    papers(status: AssessmentPaperStatus): [AssessmentPaper!]!
    # The sessions of an assessment (soft-deleted sessions excluded), run through the DataLoader assessmentSchedulesByAssessmentId so the
    # assessment list page can build the "how far has scheduling got" progress bar without N+1.
    schedules: [AssessmentSchedule!]!
    securePool: AssessmentSecurePool
    schoolClassId: ID
    candidateCount: Int!
}

type AssessmentStatusCounts {
    total: Int!
    draft: Int!
    scheduled: Int!
    inProgress: Int!
    closed: Int!
    resultsPublished: Int!
    cancelled: Int!
}

type AssessmentPage {
    content: [Assessment!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

