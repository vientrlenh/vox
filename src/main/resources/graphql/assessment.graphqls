    endDate: DateTime
    status: AssessmentScheduleStatus!
    movedToScheduleId: ID
    proctors: [AssessmentScheduleProctor!]!
    candidateCount: Int!
    requiredProctorCount: Int!
}

# A teacher who is already booked: they proctor session `scheduleId`, which runs [startDate, endDate).
# Only used to grey out busy people on the proctor picker screen -- the real blocking rule runs at write time.
type ProctorBusySlot {
    teacherId: ID!
    scheduleId: ID!
    startDate: DateTime
    endDate: DateTime
}

# A student who is already booked when being considered for `targetScheduleId`: they are already assigned to session
# `busyScheduleId`, which runs [startDate, endDate).
# Only used to grey out clashing choices on the candidate assignment screen -- the real blocking rule runs at write time.
type StudentBusySlot {
    studentId: ID!
    targetScheduleId: ID!
    busyScheduleId: ID!
    startDate: DateTime
    endDate: DateTime
}

type AssessmentCandidate {
    id: ID!
    assessmentId: ID!
    studentId: ID!
    latestSessionId: ID
    attempts: [AssessmentAttemptSummary!]!
    officialAttempt: AssessmentAttemptSummary
    officialScore: Float
    assignedPaperId: ID
    scheduleId: ID
    status: AssessmentCandidateStatus!
    assignedAt: DateTime
    updatedAt: DateTime
    blockedAt: DateTime
    student: User
    assignedPaper: AssessmentPaper
    schedule: AssessmentSchedule
    assessment: Assessment
}

type ProctorScheduleSummary {
    scheduleId: ID!
    assessmentId: ID!
    assessmentName: String
    schoolRoomId: ID
    roomName: String
    startDate: DateTime
    endDate: DateTime
    status: AssessmentScheduleStatus
}

"""
An assessment seen from the PROCTORING screen. Deliberately smaller than `Assessment`: a proctor needs exactly this much to recognize
their room, and must not see the blueprint/grading policy/AI threshold that `Assessment` carries.
"""
type MonitoredAssessmentSummary {
    assessmentId: ID!
    code: String
    name: String
    kind: AssessmentKind
    status: AssessmentStatus
    "The earliest start among the sessions the viewer can monitor -- NOT the assessment's openAt."
    windowStart: DateTime
    windowEnd: DateTime
    "Number of sessions running right now. 0 means the assessment is in the list because it is about to start."
    liveScheduleCount: Int!
}

type ProctorCandidateSummary {
    candidateId: ID!
    studentId: ID!
    studentName: String
    studentEmail: String
    status: AssessmentCandidateStatus
    blockedAt: DateTime
    sessionId: ID
    sessionStatus: AssessmentSessionStatus
    sessionFlagged: Boolean!
}

type AssessmentAttemptSummary {
    sessionId: ID!
    startedAt: DateTime
    submittedAt: DateTime
    status: AssessmentSessionStatus!
    flagged: Boolean!
    flagReason: String
    totalScore: Float
    """
    Scoring scale of the rubric that graded this attempt. The list mixes several assessments, and each
    may use a rubric with a different scale -- the client MUST read it per row, not infer it from a shared configuration.
    Null when there is no result yet or the score is hidden.
    """
    scoringScaleMin: Float
    scoringScaleMax: Float
    rubricResultBandCode: String
    rubricResultBandName: String
    resultStatus: AssessmentCandidateResultStatus
    """
    Reason the attempt was deleted, delivered together with `status = DELETED`. Only the school admin and the
    chair of the assessment board can read deleted attempts; the student path does not return them.
    """
    deletedReason: String
}

enum AssessmentCandidateResultStatus {
    PENDING_REVIEW
    RELEASED
    APPEALED
    RE_GRADING
    FINAL
    INVALID
    RETAKE_REQUIRED
    PASSED
    FAILED
    """Phiên thi sinh ra kết quả này đã bị xoá mềm."""
    DELETED
}

type AssessmentSession {
    id: ID!
    assessmentId: ID!
    candidateId: ID!
    paperId: ID!
    startedAt: DateTime
    submittedAt: DateTime
    status: AssessmentSessionStatus!
    flagged: Boolean!
    flagReason: String
    candidateBlocked: Boolean!
}

type AssessmentSessionFollowup {
    assessmentItemResponseId: ID!
    followupCount: Int!
    totalTurns: Int!
}

type AssessmentCandidateResultSection {
    sectionId: ID!
    title: String
    score: Float!
}

type AssessmentCandidateResultItem {
    paperItemId: ID!
    responseId: ID!
    sectionId: ID!
    "Đề bài của câu. Null khi paper item không trỏ tới câu hỏi nào hoặc câu hỏi đã bị xoá."
    questionText: String
    """
    Tài nguyên đi kèm câu hỏi. Null khi câu không có.
    Hiện cho cả giáo viên lẫn học sinh: trang này vốn đã trả questionText nên asset không làm lộ
    thêm gì, mà thiếu nó thì không đối chiếu được câu trả lời với thứ đã nhìn/nghe.
    """
    asset: QuestionAsset
    "Null khi câu chưa được chấm -- bài vẫn trả về câu để client hiện bản ghi bài nói."
    itemScore: Float
    "Null khi câu chưa được chấm."
    weightedScore: Float
}

type AssessmentCandidateResult {
    id: ID!
    sessionId: ID!
    assessmentId: ID!
    paperId: ID!
    candidateId: ID!
    flagged: Boolean!
    flagReason: String
    scoreVisible: Boolean!
    totalScore: Float
    scoringScaleMin: Float
    scoringScaleMax: Float
    targetFrameworkBandId: ID
    targetFrameworkBandCode: String
    targetFrameworkBandLabel: String
    rubricResultBandId: ID
    rubricResultBandCode: String
    rubricResultBandName: String
    status: AssessmentCandidateResultStatus!
    sections: [AssessmentCandidateResultSection!]!
    items: [AssessmentCandidateResultItem!]!
}

