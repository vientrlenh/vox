}

type AssessmentItemEvaluationTurn {
    id: ID!
    turnOrder: Int
    turnType: TurnType
    promptText: String
    audioUrl: String
    transcript: String
    wordCount: Int
    durationSeconds: Int
    asrConfidence: Float
    pronunciationOverall: String
    wordFeedback: String
}

"""
Evidence of the AI grading, kept even after a teacher has re-graded (the AI version then carries
SUPERSEDED). The displayed score and rationale still belong to the version in force one level up -- this
block is only CONTEXT, not a verdict. `null` when the answer never had an AI version.

An `UNDER_REVIEW` appeal report (not yet published) never ends up here.
"""
type AssessmentItemAiEvaluationContext {
    evaluationId: ID!
    engineType: AssessmentEvaluationEngineType
    gradedByModel: String
    promptVersion: String
    overallConfidence: Float
    requiresHumanReview: Boolean!
    reviewReasonCode: String
    markedInvalid: Boolean!
    requiresRetake: Boolean!
    evaluatedAt: DateTime
    feedbackSummary: String
    "JSON string — EvaluationSignals"
    signals: String
    "JSON string — ValidityResult"
    validity: String
    "JSON string"
    suggestions: String
}

type AssessmentItemEvaluationDetails {
    "Null when the answer has NO grading yet -- then only `turns` carries data and every score field is empty."
    id: ID
    responseId: ID!
    paperItemId: ID!
    engineType: AssessmentEvaluationEngineType
    gradedByModel: String
    promptVersion: String
    rawItemScore: Float
    itemScore: Float
    overallConfidence: Float
    markedInvalid: Boolean!
    requiresRetake: Boolean!
    requiresHumanReview: Boolean!
    reviewReasonCode: String
    status: AssessmentItemEvaluationStatus
    evaluatedAt: DateTime
    feedbackSummary: String
    signals: String
    validity: String
    suggestions: String
    criteria: [AssessmentItemCriterionScore!]!
    "Always taken from the AI version -- only the AI version produces speaking turns, a manual grading has no turns."
    turns: [AssessmentItemEvaluationTurn!]!
    ai: AssessmentItemAiEvaluationContext
}

type StudentAssessmentResultSummary {
    candidateId: ID!
    assessmentId: ID!
    assessmentCode: String
    assessmentName: String
    kind: AssessmentKind!
    sessionId: ID
    paperId: ID
    sessionStatus: AssessmentSessionStatus
    sessionFlagged: Boolean!
    startedAt: DateTime
    submittedAt: DateTime
    totalScore: Float
    """
    Scoring scale of the rubric that graded this attempt. The list mixes several assessments, and each
    may use a rubric with a different scale -- the client MUST read it per row, not infer it from a shared configuration.
    Null when there is no result yet or the score is hidden.
    """
    scoringScaleMin: Float
    scoringScaleMax: Float
    resultStatus: AssessmentCandidateResultStatus
    rubricResultBandId: ID
    rubricResultBandCode: String
    rubricResultBandName: String
}
type AssessmentRecording {
    id: ID!
    assessmentSessionId: ID!
    candidateId: ID
    streamType: AssessmentRecordingStreamType
    status: AssessmentRecordingAssemblyStatus
    sizeBytes: Int
    durationSeconds: Int
    source: String
    canonical: Boolean!
    createdAt: DateTime
    assembledAt: DateTime
}

"""
A recording WITH a playable LINK, for the grading screen.

Kept apart from `AssessmentRecording` instead of adding a field there: `records` is the API of the proctoring app on
desktop (`AssessmentRecordingService`), runs during the assessment and does not need a playback link. Adding it there
would mean every proctor call has to sign a link for every recording, for something it does not use.
"""
type AssessmentRecordingPlayback {
    id: ID!
    streamType: AssessmentRecordingStreamType
    status: AssessmentRecordingAssemblyStatus
    source: String
    durationSeconds: Int
    """The recording to open first for this streamType when several sources recorded it."""
    canonical: Boolean!
    """
    Direct playback link for a <video> tag, pre-signed and EXPIRES after 2 hours.

    NULL when the recording has no file on S3 yet (still PROCESSING, or FAILED/ABANDONED) -- that is a
    normal state, not an error. Because the link expires, do not store or share it: ask this
    query again every time the player is opened.
    """
    playbackUrl: String
}

"""
A violation detected while proctoring an assessment.

It is EVIDENCE for the grader to judge, not a number that takes part in scoring. An alert is an AI
detection with a confidence, running on the webcam, and it has false positives; a criterion score measures
language ability. Letting an alert pull the score down would punish suspected cheating by pretending the
student spoke worse than they did. The right lever is the uphold/regrade/invalidate decision and the suspicion flag
on the assessment session.
"""
type AssessmentProctoringAlert {
    id: ID!
    """Identifier of the original event. Used to de-duplicate when merging this history with the live alert stream."""
    eventId: String!
    assessmentSessionId: ID!
    """
    The candidate, if the emitting source knows it.

    NULL is a valid answer, not corrupt data: the AI path that connects directly only holds the assessment session id,
    so there is no way to know which candidate. Leaving it empty is still more honest than filling in a wrong id,
    because a wrong id would attach this violation to someone else's record.
    """
    candidateId: ID
    streamId: String
    streamType: String
    alertType: String!
    level: String
    source: String
    detail: String
    confidence: Float
    """
    The moment the EVENT happened, as an absolute instant -- NOT a seek position in the video.

    Converting it to an offset needs the start time of the recording, which is not stored anywhere yet.
    """
    capturedAt: DateTime!
    """The moment the alert was emitted. The gap to capturedAt is the latency of the transport."""
    raisedAt: DateTime!
}

input UpdateAssessmentScheduleInput {
    schoolRoomId: ID
    startDate: DateTime
    endDate: DateTime
}

"""
Cảnh báo (KHÔNG chặn) ước lượng worst-case chi phí AI + khả năng chi trả còn lại -- xem
ClassTestTokenQuotaGuardService.estimateTokenQuota. Việc CHẶN thật vẫn xảy ra lúc publish/sửa/thêm
thí sinh, không phải ở query này.

Mọi số đều là VND theo GIÁ VỐN, không cộng phí dịch vụ: phí đã thu một lần lúc trường đặt đơn, còn
ví hạn mức lẫn ví tự nạp đều ghi bằng giá vốn.
"""
type AssessmentTokenEstimate {
    estimatedCostVnd: Float!
    """
    The money the school CAN STILL SPEND from the ASSESSMENT wallet = remaining plan quota + the self-topped-up wallet balance (non-
    negative part). The balance is added because ConsumeQuotaService charges the part above the quota to the self-topped-up wallet, so a
    school that has run out of quota but has topped up can still pay. null if the school has no active subscription
    or has not configured the ASSESSMENT wallet.
    """
    remainingAssessmentVnd: Float
    """
    Hạn mức CÁ NHÂN còn lại của giáo viên ra đề -- KHÔNG phải một ví cấp trường thứ hai (ví
    CLASS_TEST đã bị bỏ, xem QuotaType), và KHÔNG cộng số dư ví trường vì đây là trần chi nội bộ
    chứ không phải túi tiền. null nếu bài không phải CLASS_TEST, hoặc giáo viên không được cấp hạn
    mức riêng nên chỉ tiền của trường áp dụng.
    """
    remainingMyClassTestVnd: Float
    wouldExceedAssessment: Boolean!
    wouldExceedMyClassTest: Boolean!
    """
    Trường đang bị khóa do nợ (số dư ví tự nạp âm) -- xem SchoolSubscriptionDebtGuardService. Khác
    nguyên nhân với wouldExceedAssessment (hết hạn mức): khóa do nợ thì cần thanh toán/nạp thêm, không chỉ
    là "mua thêm token". Có thể true dù wouldExceedAssessment=false nếu hạn mức gói vẫn còn dư.
    """
    schoolLocked: Boolean!
    """
    The % of the REMAINING PLAN QUOTA of the ASSESSMENT wallet that the estimated cost of this attempt takes (the self-topped-up
    balance is not counted) -- only has a value when kind=CENTRALIZED and the wallet has room (>0), used to warn early about the domino
    effect on other teachers who have a personal quota (see teachersWithUnusedPersonalAllocationCount).
    null for CLASS_TEST or when it cannot apply.
    """
    sharedPoolUsageRatio: Float
    """
    Số giáo viên (thuộc subscription này) hiện còn hạn mức cá nhân CHƯA dùng hết cho CLASS_TEST. Chỉ có
    giá trị cùng điều kiện với sharedPoolUsageRatio -- CENTRALIZED tiêu nhiều vào ví chung có thể khiến
    các giáo viên này không lên lịch CLASS_TEST được nữa dù hạn mức cá nhân vẫn còn.
    """
    teachersWithUnusedPersonalAllocationCount: Int
}

extend type Query {
    assessments(
        kind: AssessmentKind,
        status: AssessmentStatus,
        schoolId: ID,
        keyword: String,
        page: Int = 1,
        size: Int = 20
    ): AssessmentPage!

    assessment(id: ID!): Assessment

    assessmentMyRole(assessmentId: ID!): String

    assessmentPaper(id: ID!): AssessmentPaper

    "Cảnh báo (KHÔNG chặn) ước lượng worst-case chi phí AI + hạn mức còn lại -- xem lúc tạo/sửa bài trước khi publish"
    assessmentTokenEstimate(assessmentId: ID!): AssessmentTokenEstimate!

    assessmentStatusCounts(schoolId: ID, kind: AssessmentKind, dateFrom: DateTime, dateTo: DateTime): AssessmentStatusCounts!

    classTests(
        status: AssessmentStatus,
        schoolClassId: ID,
        keyword: String,
        page: Int = 1,
        size: Int = 20
    ): AssessmentPage!

    assessmentBlueprints(
        schoolId: ID,
        isActive: Boolean,
        languageId: ID,
        assessmentKind: AssessmentKind,
        keyword: String,
        page: Int = 1,
        size: Int = 20
    ): AssessmentBlueprintPage!

    assessmentBlueprint(id: ID!): AssessmentBlueprint
    assessmentBlueprintVersion(id: ID!): AssessmentBlueprintVersion

    assessmentSchedules(assessmentId: ID, status: AssessmentScheduleStatus, startDate: DateTime, endDate: DateTime): [AssessmentSchedule!]!
    myAssessmentSchedules(assessmentId: ID, status: AssessmentScheduleStatus, startDate: DateTime, endDate: DateTime): [AssessmentSchedule!]!
    proctorBusySlots(scheduleId: ID!, teacherIds: [ID!]!): [ProctorBusySlot!]!
    studentBusySlots(scheduleIds: [ID!]!, studentIds: [ID!]!): [StudentBusySlot!]!

    assessmentCandidates(assessmentId: ID!, scheduleId: ID, status: AssessmentCandidateStatus): [AssessmentCandidate!]!

    assessmentSession(id: ID!): AssessmentSession

    assessmentSessionResult(sessionId: ID!): AssessmentCandidateResult

    assessmentSessionFollowups(sessionId: ID!): [AssessmentSessionFollowup!]!

    myAssessmentResults: [StudentAssessmentResultSummary!]!

    myProctorSchedules: [ProctorScheduleSummary!]!

    """
    The assessments that are running or about to run that the logged-in user can proctor.

    Used instead of `assessments` on the proctoring screen. `assessments` is the entry to the assessment MANAGEMENT screen, limited
    to council members -- but a council is not mandatory, so a proctor of an assessment that the school
    built itself would not see the room they have to supervise. Loosening `assessments` to fix that would open
    the assessment dashboard to proctors too, so proctoring permission is separated out here.
    """
    monitorableAssessments: [MonitoredAssessmentSummary!]!

    "Một kỳ thi đọc bằng quyền giám sát, cho phần đầu trang danh sách ca thi."
    monitorableAssessment(assessmentId: ID!): MonitoredAssessmentSummary

    myProctorScheduleCandidates(scheduleId: ID!): [ProctorCandidateSummary!]!

    """
    Lịch sử cảnh báo giám sát của cả ca thi, xếp theo thời gian xảy ra.

    Kênh cảnh báo trực tiếp là Redis pub/sub (fire-and-forget), nên nó chỉ kể được những gì xảy ra
    SAU khi giám thị kết nối. Query này là phần còn lại: vào ca muộn, tải lại trang, hay mở thêm một
    người giám sát thứ hai đều thấy đủ như nhau.
    """
    scheduleProctoringAlerts(scheduleId: ID!): [AssessmentProctoringAlert!]!

    assessmentItemResponse(answerId: ID!): AssessmentItemResponseDetails

    assessmentItemResponseTurns(answerId: ID!): [AssessmentItemResponseTurn!]!

    assessmentItemResponseEvaluation(answerId: ID!): AssessmentItemEvaluationDetails
    # Renamed `records` -> `recordings` (2026-08-07). The resolver has always been named `recordings`
    # (AssessmentSessionController#recordings), so the `records` field had NOBODY serving it -- the schema
    # inspection report at startup lists it under "Unmapped fields", and calling it would fail because of the
    # non-null return type. No client was calling it so renaming the field is safe.
    recordings(assessmentSessionId: ID!, streamType: AssessmentRecordingStreamType): [AssessmentRecording!]!

    """
    Bản ghi camera + màn hình của một phiên thi, kèm link phát -- cho màn chấm bài và trang kết
    quả phía giáo viên. Cùng luật quyền với `records` (school admin, hoặc giáo viên là chủ tịch
    hội đồng / giám thị của đúng ca thi).
    """
    assessmentRecordingPlayback(assessmentSessionId: ID!): [AssessmentRecordingPlayback!]!

    """
    Cảnh báo giám sát của một phiên thi, xếp theo thời gian xảy ra.

    Cùng luật quyền với `assessmentRecordingPlayback` (school admin, hoặc giáo viên là chủ tịch hội đồng /
    giám thị / người đang cầm bài): hai thứ này là cùng một loại bằng chứng về cùng một con người.
    """
    assessmentSessionProctoringAlerts(assessmentSessionId: ID!): [AssessmentProctoringAlert!]!
}

extend type Mutation {
    updateAssessmentSchedule(id: ID!, input: UpdateAssessmentScheduleInput!): ID!
    # Toggle: flagged=true đánh dấu nghi vấn (reason bắt buộc), flagged=false bỏ đánh dấu.
    flagAssessmentSession(sessionId: ID!, flagged: Boolean!, reason: String): ID!
    forceEndAssessmentSession(sessionId: ID!, reason: String!): ID!
    unblockAssessmentCandidate(candidateId: ID!, reason: String!): ID!
    # reviewFlaggedAssessmentResult / releasePendingAssessmentResult were removed: the decider is THE TEACHER
    # HOLDING THE ATTEMPT, through REST /api/v1/grading-assignments/{id}/uphold | /regrade | /invalidate.
    # Only applies when the result is FINAL (the assessment is already RESULTS_PUBLISHED but the assessmentPolicy
    # has no passingScore) -- the school decides PASSED or FAILED manually.
    decideAssessmentCandidateResultOutcome(candidateResultId: ID!, decision: AssessmentCandidateResultStatus!): ID!
    retryGradingAssessmentSession(sessionId: ID!): ID!
    # TEST-ONLY: chấm lại 1 phiên thi bằng AI bất kể trạng thái (kể cả đã GRADED) -- re-publish
    # grading request từ dữ liệu làm bài đã lưu, evaluation cũ bị ghi đè (upsert). Dùng để kiểm
    # thử pipeline chấm điểm, không phải luồng nghiệp vụ chính thức.
    regradeAssessmentSessionForTest(sessionId: ID!): ID!
    updateAssessmentCandidateStatus(candidateId: ID!, status: AssessmentCandidateStatus!): ID!
    updateAssessmentCandidatesAttendance(scheduleId: ID!, candidateIds: [ID!]!): [AssessmentCandidate!]!
}