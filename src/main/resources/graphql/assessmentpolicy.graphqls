enum AssessmentPolicyStrictness {
    LENIENT
    STANDARD
    STRICT
}

enum AssessmentPolicyStatus {
    DRAFT
    PUBLISHED
    ARCHIVED
}

input UpdateAssessmentPolicyInput {
    targetFrameworkBandId: ID!
    passingScore: Float
    strictness: AssessmentPolicyStrictness
    effectiveFrom: DateTime!
    effectiveTo: DateTime
}

extend type Mutation {
    updateSystemAssessmentPolicy(policyId: ID!, input: UpdateAssessmentPolicyInput!): ID!
    updateSchoolAssessmentPolicy(schoolId: ID!, policyId: ID!, input: UpdateAssessmentPolicyInput!): ID!
}

type AssessmentPolicy {
    id: ID!
    schoolId: ID
    languageId: ID!
    frameworkVersionId: ID!
    rubricVersionId: ID!
    targetFrameworkBandId: ID!
    passingScore: Float
    strictness: AssessmentPolicyStrictness!
    version: Int!
    status: AssessmentPolicyStatus!
    effectiveFrom: DateTime!
    effectiveTo: DateTime
    createdAt: DateTime
    updatedAt: DateTime

    school: School
    gradeLevel: GradeLevel
    schoolGrade: SchoolGrade
    schoolClass: SchoolClass
    language: SupportedLanguage
    frameworkVersion: FrameworkVersion
    rubricVersion: RubricVersion
    targetFrameworkBand: FrameworkResultBand
}

type AssessmentPolicyPage {
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
    content: [AssessmentPolicy!]!
}

extend type Query {
    viewSystemAssessmentPolicies(status: AssessmentPolicyStatus, languageId: ID, rubricVersionId: ID, effectiveFrom: DateTime, effectiveTo: DateTime, page: Int = 1, size: Int = 10): AssessmentPolicyPage!
    viewSchoolAssessmentPolicies(schoolId: ID!, status: AssessmentPolicyStatus, languageId: ID, rubricVersionId: ID, effectiveFrom: DateTime, effectiveTo: DateTime, page: Int = 1, size: Int = 10): AssessmentPolicyPage!
    # A teacher can only see PUBLISHED policies of their own school (schoolId is derived from the token)
    viewTeacherAssessmentPolicies(languageId: ID, rubricVersionId: ID, effectiveFrom: DateTime, effectiveTo: DateTime, page: Int = 1, size: Int = 10): AssessmentPolicyPage!
    viewSystemAssessmentPolicy(policyId: ID!): AssessmentPolicy!
    viewSchoolAssessmentPolicy(schoolId: ID!, policyId: ID!): AssessmentPolicy!
}
