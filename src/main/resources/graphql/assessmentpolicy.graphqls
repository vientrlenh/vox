enum AssessmentPolicyStrictness {
    LENIENT
    STANDARD
    STRICT
}

input UpdateAssessmentPolicyInput {
    targetFrameworkBandId: ID!
    passingScore: Float
    strictness: AssessmentPolicyStrictness
    effectiveFrom: String!
    effectiveTo: String
}

extend type Mutation {
    updateSystemAssessmentPolicy(policyId: ID!, input: UpdateAssessmentPolicyInput!): ID!
    updateSchoolAssessmentPolicy(schoolId: ID!, policyId: ID!, input: UpdateAssessmentPolicyInput!): ID!
}

type AssessmentPolicy {
    id: ID!
    schoolId: ID
    languageId: ID!
    frameworkVersionId: ID!
    rubricVersionId: ID!
    targetFrameworkBandId: ID!
    passingScore: Float
    strictness: AssessmentPolicyStrictness!
    version: Int!
    status: String!
    effectiveFrom: String!
    effectiveTo: String
    createdAt: String
    updatedAt: String

    school: School
    gradeLevel: GradeLevel
    schoolGrade: SchoolGrade
    schoolClass: SchoolClass
    language: SupportedLanguage
    frameworkVersion: FrameworkVersion
    rubricVersion: RubricVersion
    targetFrameworkBand: FrameworkResultBand
}

type AssessmentPolicyPage {
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
    content: [AssessmentPolicy!]!
}

type GradeLevelBandCeiling {
    defaultBand: FrameworkResultBand!
    hardMaxBand: FrameworkResultBand!
}

extend type Query {
    viewSystemAssessmentPolicies(status: String, languageId: ID, rubricVersionId: ID, effectiveFrom: String, effectiveTo: String, page: Int = 1, size: Int = 10): AssessmentPolicyPage!
    viewSchoolAssessmentPolicies(schoolId: ID!, status: String, languageId: ID, rubricVersionId: ID, effectiveFrom: String, effectiveTo: String, page: Int = 1, size: Int = 10): AssessmentPolicyPage!
    # Teacher chỉ xem được policy PUBLISHED của trường mình (schoolId tự suy ra từ token)
    viewTeacherAssessmentPolicies(languageId: ID, rubricVersionId: ID, effectiveFrom: String, effectiveTo: String, page: Int = 1, size: Int = 10): AssessmentPolicyPage!
    viewSystemAssessmentPolicy(policyId: ID!): AssessmentPolicy!
    viewSchoolAssessmentPolicy(schoolId: ID!, policyId: ID!): AssessmentPolicy!
    # Trần bậc mục tiêu (default + hard max) theo (Khối/Niên khóa/Lớp, Framework Version) -- null
    # nghĩa là chưa cấu hình trần, không giới hạn gì. Truyền tối đa 1 trong 3 field phạm vi.
    gradeLevelBandCeiling(schoolId: ID!, frameworkVersionId: ID!, gradeLevelId: ID, schoolGradeId: ID, schoolClassId: ID): GradeLevelBandCeiling
}
