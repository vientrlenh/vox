type SystemAdminDashboardSummary {
    totalSchools: Int!
    activeSchools: Int!
    inactiveSchools: Int!
    pendingRegistrations: Int!
    """
    Đơn chờ LÂU NHẤT đã nằm trong hàng đợi bao nhiêu ngày lịch (giờ Việt Nam).

    null khi không còn đơn nào chờ — khác hẳn 0, vốn nghĩa là "có đơn, vừa nộp hôm nay". Ở đây 0
    lại là trạng thái tốt nhất, nên nhập nhèm hai cái sẽ vẽ ra một hàng đợi rỗng trông y hệt một
    hàng đợi vừa xử lý xong.
    """
    oldestPendingRegistrationDays: Int
    registrationsLast30Days: Int!
    registrationsLast90Days: Int!
    totalRevenue: Float!
    "Doanh thu 24 tháng gần nhất, xếp từ cũ đến mới"
    monthlyRevenue: [MonthlySpending!]!
    studentCount: Int!
    teacherCount: Int!
    schoolAdminCount: Int!
    activeFrameworkCount: Int!
    systemRubricCount: Int!
}

type MonthlySpending {
    "Định dạng YYYY-MM"
    month: String!
    amount: Float!
}

type SchoolMonthlySpending {
    "Định dạng YYYY-MM"
    month: String!
    amount: Float!
    "Phần chi cho đăng ký/gia hạn gói"
    subscriptionAmount: Float!
    "Phần chi mua thêm token"
    tokenTopUpAmount: Float!
}

type SubscriptionRenewal {
    planName: String
    status: SchoolSubscriptionStatus!
    "Ngày hết hạn / gia hạn gói, định dạng YYYY-MM-DD"
    endDate: String!
}

type SchoolAdminDashboardSummary {
    examStatusCounts: ExamStatusCounts!
    appealStats: AppealStats!
    revenue: Float!
    "Chi tiêu 12 tháng gần nhất, xếp từ cũ đến mới"
    monthlySpending: [SchoolMonthlySpending!]!
    tokenAllocated: Float!
    tokenUsed: Float!
    "null nếu trường chưa từng có gói đăng ký nào đang hoạt động"
    subscriptionRenewal: SubscriptionRenewal
}

type TeacherGradingStats {
    pending: Int!
    completed: Int!
}

type TeacherScoreStats {
    averageScore: Float
    gradedCount: Int!
    totalCandidates: Int!
}

type ClassScoreStats {
    examName: String!
    className: String!
    averageScore: Float
    highestScore: Float
    lowestScore: Float
    gradedCount: Int!
    totalCandidates: Int!
}

type TeacherDashboardSummary {
    examStatusCounts: ExamStatusCounts!
    gradingStats: TeacherGradingStats!
    scoreStats: TeacherScoreStats!
    classScoreStats: [ClassScoreStats!]!
}

type NearestCentralizedExam {
    examId: ID!
    code: String!
    name: String!
    status: ExamStatus!
    "Mốc mở kỳ thi, định dạng ISO-8601"
    openAt: String
    "Mốc đóng kỳ thi, định dạng ISO-8601"
    closeAt: String
    totalCandidates: Int!
    absentCandidates: Int!
}

type QuestionBankStats {
    totalQuestions: Int!
    totalQuestionBanks: Int!
    draft: Int!
    submittedForReview: Int!
    revisionRequested: Int!
    approved: Int!
    rejected: Int!
    published: Int!
    archived: Int!
    readAloud: Int!
    shortAnswer: Int!
    longAnswer: Int!
    opinion: Int!
    description: Int!
}

"Kết quả chấm AI của một ngày lịch theo giờ Việt Nam."
type GradingOutcomeBucket {
    "Định dạng YYYY-MM-DD"
    day: String!
    graded: Int!
    failed: Int!
}

"""
Sức khỏe vận hành nền tảng. Trộn hai loại thời gian CÓ CHỦ Ý:

sessionsInProgress / examsInProgress / gradingQueueDepth là ảnh chụp NGAY LÚC GỌI và không đổi theo
dateFrom/dateTo — "đang có 6 kỳ thi chạy" mà đổi khi bấm sang tháng trước thì vô nghĩa. Các trường
còn lại thuộc cửa sổ đang xem.
"""
type PlatformOperationalHealth {
    "Phiên thi đang diễn ra ngay lúc này"
    sessionsInProgress: Int!
    "Số kỳ thi KHÁC NHAU đang có phiên chạy"
    examsInProgress: Int!
    "Phiên đã nộp, đang xếp hàng hoặc đang chấm"
    gradingQueueDepth: Int!
    "Phiên chấm xong trong cửa sổ"
    graded: Int!
    "Phiên AI chấm lỗi trong cửa sổ (exam_sessions.status = GRADING_FAILED)"
    gradingFailed: Int!
    "null khi cửa sổ chưa có phiên nào chấm xong lẫn chấm lỗi — khác hẳn với 0%"
    successRatePercent: Float
    "Liên tục theo ngày, cũ -> mới, ngày không có phiên trả về 0"
    daily: [GradingOutcomeBucket!]!
}

"""
Sức khỏe kinh doanh nền tảng.

Mọi số đếm phân loại theo TRƯỜNG, không theo dòng thuê bao — một trường có nhiều kỳ trong lịch sử.
"Còn hiệu lực" gồm cả CANCELLED vì trạng thái đó chỉ tắt gia hạn tự động, trường vẫn dùng được tới
hết endDate; chỉ SUSPENDED mới mất quyền dùng ngay.

ĐỪNG CỘNG CÁC SỐ ĐẾM LẠI — chúng không phải một phép chia nhóm:

* subscribedSchools / lapsedSchools / suspendedSchools loại trừ nhau: đó là ba trạng thái có thể
  có của cùng một trường tại thời điểm gọi.
* expiringSoonSchools là TẬP CON của subscribedSchools, không phải nhóm thứ tư.
* schoolsInDebt cắt ngang cả ba: nó đọc từ school_balances chứ không từ school_subscriptions, nên
  một trường đang còn gói mà ví âm sẽ được đếm ở CẢ subscribedSchools lẫn schoolsInDebt.
* Trường CHƯA TỪNG có gói nào không nằm trong ba nhóm đầu: chúng không có dòng nào trong
  school_subscriptions để gộp. Trường mới duyệt mà chưa mua gói vì thế vô hình ở đây.

Số đếm trường là ảnh chụp NGAY LÚC GỌI, không đổi theo dateFrom/dateTo. Các con số tiền thì theo cửa
sổ đang xem.
"""
type PlatformBusinessHealth {
    "Trường có kỳ thuê bao phủ hôm nay"
    subscribedSchools: Int!
    "Tập con của subscribedSchools: kỳ đang phủ sẽ hết trong 30 ngày tới"
    expiringSoonSchools: Int!
    "Từng có gói nhưng hiện không kỳ nào phủ, và không bị đình chỉ"
    lapsedSchools: Int!
    "Bị đình chỉ và hiện không có kỳ nào phủ"
    suspendedSchools: Int!
    "Ví tự nạp âm — chính là trường đang bị chặn mở ca thi"
    schoolsInDebt: Int!
    "Tiền thực thu trong cửa sổ (đơn SUCCESS), VND"
    revenueVnd: Float!
    "Cùng độ dài, ngay TRƯỚC cửa sổ — không phải tháng lịch trước"
    previousRevenueVnd: Float!
    "Giá vốn AI phát sinh trong cửa sổ, VND (ai_usage_records.cost_vnd)"
    aiCostVnd: Float!
    "null khi cửa sổ chưa thu được đồng nào — biên của doanh thu 0 không tồn tại, không phải 0%"
    grossMarginPercent: Float
    """
    Cùng công thức, tính trên kỳ so sánh — để vẽ mức chênh theo ĐIỂM PHẦN TRĂM (không phải %).

    Tính ở server chứ không để client lấy hiệu của hai tỷ lệ tự dựng: quy ước "doanh thu 0 thì biên
    không tồn tại" chỉ đúng nếu áp một lần cho cả hai kỳ. null khi kỳ trước chưa thu được đồng nào,
    và lúc đó KHÔNG có mức chênh nào để hiển thị.
    """
    previousGrossMarginPercent: Float
}

"""
Một nhóm phiên chấm lỗi cùng nguyên nhân.

`signature` là thông điệp lỗi đã chuẩn hóa (thay uuid và số bằng chỗ trống) — nó là ĐỊNH DANH của
nhóm, truyền lại y nguyên vào `gradingFailureSessions` để mở nhóm. null là nhóm "không rõ nguyên
nhân": phiên bị đánh dấu hỏng qua nhánh DLT không mang thông điệp nào, và mọi phiên hỏng từ trước
khi hệ thống bắt đầu lưu lý do cũng nằm ở đây. Đó là một nhóm THẬT, không phải dữ liệu thiếu.
"""
type GradingFailureGroup {
    signature: String
    "Một thông điệp lỗi thô đại diện, để đọc; null ở nhóm không rõ nguyên nhân"
    sampleError: String
    sessionCount: Int!
    "Kỳ thi cấp hệ thống không thuộc trường nào nên không được đếm"
    schoolCount: Int!
    examCount: Int!
    "ISO-8601. Cùng với lastFailedAt cho thấy sự cố gói trong hai tiếng hay lỗi rỉ rả suốt hai tuần"
    firstFailedAt: String
    lastFailedAt: String
    "Số phiên thuộc kỳ CHƯA công bố điểm, tức thật sự chấm lại được"
    retryableCount: Int!
}

"""
Trang phân loại phiên chấm lỗi.

sessionCount phải khớp đúng `gradingFailed` của platformOperationalHealth khi hai bên cùng khoảng:
cùng vị từ (status = GRADING_FAILED), cùng cửa sổ theo submitted_at, cùng mặc định khi bỏ trống mốc.
"""
type GradingFailureOverview {
    sessionCount: Int!
    "Số nhóm nguyên nhân, tính cả nhóm không rõ nguyên nhân nếu có"
    causeCount: Int!
    schoolCount: Int!
    retryableCount: Int!
    "Nhóm đông nhất trước"
    groups: [GradingFailureGroup!]!
    """
    Số nhóm vượt trần và bị cắt khỏi `groups`.

    Nói ra thay vì im lặng cắt, vì nó là DẤU HIỆU CHẨN ĐOÁN: chuẩn hóa thông điệp mà không gom được
    thì số nhóm nở gần bằng số phiên, và lúc đó cần sửa cách chuẩn hóa chứ không phải nới trần.
    """
    groupsTruncated: Int!
}

"""
Một phiên chấm lỗi. KHÔNG có điểm: phiên GRADING_FAILED không có dòng exam_candidate_results nào để
lấy điểm ra. Thứ thay thế là những trường giúp phân loại.
"""
type GradingFailureSession {
    sessionId: ID!
    schoolId: ID
    "null với kỳ thi cấp hệ thống"
    schoolName: String
    schoolCode: String
    examId: ID!
    examName: String!
    candidateName: String
    "ISO-8601, mốc nộp bài"
    failedAt: String
    "Dịch vụ chấm đã thử mấy lần trước khi bỏ cuộc; null khi không rõ"
    retryCount: Int
    "Thông điệp lỗi thô, nguyên văn; null ở nhóm không rõ nguyên nhân"
    error: String
    "Kỳ thi chưa công bố điểm, tức chấm lại được"
    retryable: Boolean!
    """
    Bài ĐÃ được đẩy sang hàng đợi người chấm.

    Phiên vẫn ở GRADING_FAILED vì hand-off cố ý không đổi trạng thái phiên (xem
    HandOffGradingToHumanUseCase), nên cờ này là thứ DUY NHẤT phân biệt phiên đã có người nhận với
    phiên chưa ai đụng tới.
    """
    handedOff: Boolean!
}

type GradingFailureSessionPage {
    content: [GradingFailureSession!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

extend type Query {
    systemAdminDashboard: SystemAdminDashboardSummary!

    """
    Cùng quy ước khoảng với platformOperationalHealth, và cùng mặc định: bỏ trống dateTo = ngay lúc
    này, bỏ trống dateFrom = lùi 14 ngày. Người dùng bấm vào con số phiên lỗi trên trang tổng quan
    rồi mong thấy đúng những phiên tạo ra con số đó.
    """
    gradingFailureOverview(dateFrom: String, dateTo: String): GradingFailureOverview!

    """
    Phiên trong MỘT nhóm. `signature` lấy nguyên văn từ GradingFailureGroup.signature — bỏ trống
    hoặc null chọn đúng nhóm "không rõ nguyên nhân", KHÔNG phải bỏ lọc.
    """
    gradingFailureSessions(
        dateFrom: String
        dateTo: String
        signature: String
        page: Int = 1
        size: Int = 20
    ): GradingFailureSessionPage!

    """
    dateFrom/dateTo là ISO instant (vd "2026-08-01T00:00:00Z"). dateFrom BAO GỒM, dateTo KHÔNG bao
    gồm — hai dải liền nhau sẽ đếm trùng phiên rơi đúng ranh giới nếu dùng <=, cùng quy ước với
    schoolBalanceSummary. Bỏ trống dateTo = ngay lúc này; bỏ trống dateFrom = lùi 14 ngày.
    """
    platformOperationalHealth(dateFrom: String, dateTo: String): PlatformOperationalHealth!

    """
    Cùng quy ước khoảng với platformOperationalHealth. Bỏ trống dateFrom = đầu tháng hiện tại theo
    giờ Việt Nam.
    """
    platformBusinessHealth(dateFrom: String, dateTo: String): PlatformBusinessHealth!

    schoolAdminDashboard: SchoolAdminDashboardSummary!
    teacherDashboard: TeacherDashboardSummary!
    "Kỳ thi tập trung gần thời điểm hiện tại nhất của trường — null nếu chưa có kỳ thi tập trung nào"
    nearestCentralizedExam: NearestCentralizedExam
    questionBankStats: QuestionBankStats!
}
