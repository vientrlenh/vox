type SystemAdminDashboardSummary {
    totalSchools: Int!
    activeSchools: Int!
    inactiveSchools: Int!
    pendingRegistrations: Int!
    """
    Đơn chờ LÂU NHẤT đã nằm trong hàng đợi bao nhiêu ngày lịch (giờ Việt Nam).

    null khi không còn đơn nào chờ — khác hẳn 0, vốn nghĩa là "có đơn, vừa nộp hôm nay". Ở đây 0
    lại là trạng thái tốt nhất, nên nhập nhèm hai cái sẽ vẽ ra một hàng đợi rỗng trông y hệt một
    hàng đợi vừa xử lý xong.
    """
    oldestPendingRegistrationDays: Int
    registrationsLast30Days: Int!
    registrationsLast90Days: Int!
    totalRevenue: Float!
    "Doanh thu 24 tháng gần nhất, xếp từ cũ đến mới"
    monthlyRevenue: [MonthlySpending!]!
    studentCount: Int!
    teacherCount: Int!
    schoolAdminCount: Int!
    activeFrameworkCount: Int!
    systemRubricCount: Int!
}

type MonthlySpending {
    "Định dạng YYYY-MM"
    month: String!
    amount: Float!
}

type SchoolMonthlySpending {
    "Định dạng YYYY-MM"
    month: String!
    amount: Float!
    "Phần chi cho đăng ký/gia hạn gói"
    subscriptionAmount: Float!
    "Phần chi mua thêm token"
    tokenTopUpAmount: Float!
}

type SubscriptionRenewal {
    planName: String
    status: SchoolSubscriptionStatus!
    "Ngày hết hạn / gia hạn gói, định dạng YYYY-MM-DD"
    endDate: String!
}

"""
Tiền của trường, ở mức đủ để trả lời "tuần này còn thi được không".

TIỀN Ở TYPE NÀY LÀ String, không phải Float — cố ý lệch khỏi quy ước chung của file, vì số dư ví là
numeric(18,6) và double làm tròn sai đúng chỗ con số phải khớp tuyệt đối. Lý do đầy đủ ở đầu
school-balance.graphqls. Cả bốn field theo cùng một kiểu: trộn Float với String trong cùng một khối
tiền còn khó đọc hơn là lệch với tokenAllocated/tokenUsed ngay bên cạnh.

HAI TÚI KHÁC NHAU, đừng gộp: hạn mức kèm gói tách theo QuotaType (chỉ ví EXAM trả tiền cho việc chấm
thi), còn ví tự nạp là MỘT con số dùng chung và chỉ bị trừ khi hạn mức của loại tương ứng đã cạn.
Túi luyện nói còn rộng không giúp gì cho kỳ thi tuần sau.
"""
type SchoolFunding {
    "Hạn mức CHẤM THI còn lại. Không bao giờ âm — phần vượt đã thành nợ trên ví."
    examQuotaRemainingVnd: String!
    examQuotaTotalVnd: String!
    "Số dư ví tự nạp. Âm CHÍNH LÀ khoản nợ."
    balanceVnd: String!
    """
    balanceVnd < 0 — trường không mở được ca thi mới.

    Cùng luật SchoolSubscriptionDebtGuardService dùng để chặn VerifyExamScheduleOtpUseCase và
    StartClassTestSessionUseCase, trả sẵn thay vì để client so với 0: một luật chỉ nên có một nơi
    định nghĩa. Trùng nghĩa với SchoolBalance.locked, cố ý — đây là bản đọc kèm của trang tổng quan.
    """
    locked: Boolean!
    "examQuotaRemainingVnd + max(balanceVnd, 0). Ví ÂM không bị trừ vào đây: nợ là khoản phải trả."
    spendableVnd: String!
}

"""
Bài đã thi xong mà học sinh CHƯA có điểm, chia theo thứ đang chặn.

Năm nhóm LOẠI TRỪ NHAU và phủ kín — cộng lại đúng bằng `total`.

KHÔNG lấy từ gradingStats.unassigned dù nghe giống: bên đó đếm bài ĐỦ ĐIỀU KIỆN nhận thêm một vòng
chấm, tập ấy gồm cả RELEASED / INVALID / APPEALED, tức gần như mọi bài của trường.

Phạm vi là kỳ thi TẬP TRUNG và kỳ CHƯA công bố điểm. Kỳ đã RESULTS_PUBLISHED bị loại vì cả chấm lại
bằng AI lẫn chuyển người chấm đều bị từ chối ở đó — những bài ấy không còn là việc phải làm mà là
thiệt hại đã xảy ra, và để chúng ở đây thì con số có một mức sàn không bao giờ về 0.
"""
type UnscoredWorkload {
    total: Int!
    "aiFailedRetryLeft + aiFailedNoRetryLeft — giao diện gộp thành một dòng, hai số con là nhãn phụ"
    aiFailed: Int!
    "AI chấm lỗi, chưa ai đụng tới, trường vẫn còn lượt nhờ AI chấm lại"
    aiFailedRetryLeft: Int!
    "AI chấm lỗi, đã dùng hết lượt AI — chỉ còn đường chấm tay"
    aiFailedNoRetryLeft: Int!
    "Đã vào hàng đợi người chấm nhưng chưa phân công cho ai"
    awaitingAssignment: Int!
    assignedOverdue: Int!
    assignedInProgress: Int!
    "Bài chờ lâu nhất đã chờ bao nhiêu ngày lịch (giờ VN); null khi không còn bài nào — null KHÁC 0"
    oldestWaitingDays: Int
    examCount: Int!
}

"""
Kỳ thi ĐÃ ĐÓNG mà còn bài chưa có điểm.

Công bố điểm là cánh cửa MỘT CHIỀU: RetryGradingExamSessionUseCase và HandOffGradingToHumanUseCase
đều từ chối khi kỳ thi ở RESULTS_PUBLISHED. Bấm công bố lúc còn bài trống là chốt sổ vĩnh viễn cho
đúng những bài đó, và hiện không màn nào cảnh báo trước.

Chỉ kỳ CLOSED — đúng tập kỳ mà nút Công bố điểm đang bấm được. Kỳ IN_PROGRESS vẫn đang có người thi
nên bài trống là chuyện bình thường.
"""
type ExamAwaitingPublish {
    examId: ID!
    code: String!
    name: String!
    "ISO-8601; null với kỳ không đặt mốc đóng"
    closeAt: String
    unscoredCount: Int!
    "Trong số đó, còn cứu được bằng AI"
    aiFailedRetryLeft: Int!
    "Trong số đó, hết lượt AI — bắt buộc xếp giáo viên chấm"
    aiFailedNoRetryLeft: Int!
    "Trong số đó, đã nằm ở hàng đợi người chấm"
    awaitingHumanGrading: Int!
}

"""
Một bài AI chấm lỗi mà chưa ai xử lý, nhìn từ phía nhà trường.

KHÔNG có điểm: phiên GRADING_FAILED chưa từng sinh dòng exam_candidate_results nào. Thứ thay thế là
những trường giúp chọn giữa hai lối ra — nhờ AI chấm lại hay xếp giáo viên chấm tay.
"""
type SchoolGradingFailure {
    sessionId: ID!
    examId: ID!
    examCode: String!
    examName: String!
    candidateName: String
    "null khi học sinh chưa được xếp vào lớp đang hoạt động nào"
    className: String
    "ISO-8601, mốc nộp bài"
    failedAt: String
    "Thông điệp lỗi thô, nguyên văn; null với phiên bị đánh dấu hỏng qua nhánh DLT"
    error: String
    """
    Dịch vụ chấm đã TỰ thử lại mấy lần bên trong một lượt; null khi không rõ.

    KHÁC hẳn định mức của trường: con số này nói về độ dai của sự cố, không nói ai đã bấm gì. Đừng
    dựng nút bấm từ nó — schoolRetryLeft mới là thứ quyết định.
    """
    aiRetryCount: Int
    "Trường còn lượt nhờ AI chấm lại cho phiên này hay không"
    schoolRetryLeft: Boolean!
}

type SchoolGradingFailurePage {
    content: [SchoolGradingFailure!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
    """
    Số bài còn lượt AI, ĐÃ áp bộ lọc kỳ thi nhưng CHƯA áp bộ lọc định mức.

    Hai số này đứng trên chính hai nút lọc nên phải dự đoán đúng kết quả của cú bấm. Không lọc kỳ nào
    thì chúng khớp đúng unscored.aiFailedRetryLeft / aiFailedNoRetryLeft trên trang tổng quan.
    """
    retryLeftCount: Int!
    noRetryLeftCount: Int!
}

type SchoolAdminDashboardSummary {
    examStatusCounts: ExamStatusCounts!
    appealStats: AppealStats!
    revenue: Float!
    "Chi tiêu 12 tháng gần nhất, xếp từ cũ đến mới"
    monthlySpending: [SchoolMonthlySpending!]!
    """
    Hạn mức CHẤM THI của kỳ đăng ký đang chạy — chỉ ví EXAM, không gồm ví luyện nói.

    Tên field nói "token" và không nói "exam" là di sản; xem SchoolFunding cho bản đọc rõ ràng, có
    kèm cả số dư ví. Hai chỗ đọc cùng một bản ghi hạn mức nên không bao giờ lệch nhau.
    """
    tokenAllocated: Float!
    tokenUsed: Float!
    "null nếu trường chưa từng có gói đăng ký nào đang hoạt động"
    subscriptionRenewal: SubscriptionRenewal
    funding: SchoolFunding!
    unscored: UnscoredWorkload!
    "Nhiều bài trống nhất trước. Cắt ở 5 kỳ — đây là thẻ cảnh báo, không phải danh sách kỳ thi."
    examsAwaitingPublish: [ExamAwaitingPublish!]!
    """
    Đơn khiếu nại CHỜ XỬ LÝ lâu nhất đã chờ bao nhiêu ngày lịch (giờ VN).

    null khi không còn đơn nào chờ — khác hẳn 0, vốn nghĩa là "có đơn, vừa nộp hôm nay". Cùng bài học
    với oldestPendingRegistrationDays: số ĐƠN không cho biết có đơn nào đang trễ hay không.
    """
    oldestPendingAppealDays: Int
}

type TeacherGradingStats {
    pending: Int!
    completed: Int!
}

type TeacherScoreStats {
    averageScore: Float
    gradedCount: Int!
    totalCandidates: Int!
}

type ClassScoreStats {
    examName: String!
    className: String!
    averageScore: Float
    highestScore: Float
    lowestScore: Float
    gradedCount: Int!
    totalCandidates: Int!
}

type TeacherDashboardSummary {
    examStatusCounts: ExamStatusCounts!
    gradingStats: TeacherGradingStats!
    scoreStats: TeacherScoreStats!
    classScoreStats: [ClassScoreStats!]!
}

type NearestCentralizedExam {
    examId: ID!
    code: String!
    name: String!
    status: ExamStatus!
    "Mốc mở kỳ thi, định dạng ISO-8601"
    openAt: String
    "Mốc đóng kỳ thi, định dạng ISO-8601"
    closeAt: String
    totalCandidates: Int!
    absentCandidates: Int!
}

type QuestionBankStats {
    totalQuestions: Int!
    totalQuestionBanks: Int!
    draft: Int!
    submittedForReview: Int!
    revisionRequested: Int!
    approved: Int!
    rejected: Int!
    published: Int!
    archived: Int!
    readAloud: Int!
    shortAnswer: Int!
    longAnswer: Int!
    opinion: Int!
    description: Int!
}

"Kết quả chấm AI của một ngày lịch theo giờ Việt Nam."
type GradingOutcomeBucket {
    "Định dạng YYYY-MM-DD"
    day: String!
    graded: Int!
    failed: Int!
}

"""
Sức khỏe vận hành nền tảng. Trộn hai loại thời gian CÓ CHỦ Ý:

sessionsInProgress / examsInProgress / gradingQueueDepth là ảnh chụp NGAY LÚC GỌI và không đổi theo
dateFrom/dateTo — "đang có 6 kỳ thi chạy" mà đổi khi bấm sang tháng trước thì vô nghĩa. Các trường
còn lại thuộc cửa sổ đang xem.
"""
type PlatformOperationalHealth {
    "Phiên thi đang diễn ra ngay lúc này"
    sessionsInProgress: Int!
    "Số kỳ thi KHÁC NHAU đang có phiên chạy"
    examsInProgress: Int!
    "Phiên đã nộp, đang xếp hàng hoặc đang chấm"
    gradingQueueDepth: Int!
    "Phiên chấm xong trong cửa sổ"
    graded: Int!
    "Phiên AI chấm lỗi trong cửa sổ (exam_sessions.status = GRADING_FAILED)"
    gradingFailed: Int!
    "null khi cửa sổ chưa có phiên nào chấm xong lẫn chấm lỗi — khác hẳn với 0%"
    successRatePercent: Float
    "Liên tục theo ngày, cũ -> mới, ngày không có phiên trả về 0"
    daily: [GradingOutcomeBucket!]!
}

"""
Sức khỏe kinh doanh nền tảng.

Mọi số đếm phân loại theo TRƯỜNG, không theo dòng thuê bao — một trường có nhiều kỳ trong lịch sử.
"Còn hiệu lực" gồm cả CANCELLED vì trạng thái đó chỉ tắt gia hạn tự động, trường vẫn dùng được tới
hết endDate; chỉ SUSPENDED mới mất quyền dùng ngay.

ĐỪNG CỘNG CÁC SỐ ĐẾM LẠI — chúng không phải một phép chia nhóm:

* subscribedSchools / lapsedSchools / suspendedSchools loại trừ nhau: đó là ba trạng thái có thể
  có của cùng một trường tại thời điểm gọi.
* expiringSoonSchools là TẬP CON của subscribedSchools, không phải nhóm thứ tư.
* schoolsInDebt cắt ngang cả ba: nó đọc từ school_balances chứ không từ school_subscriptions, nên
  một trường đang còn gói mà ví âm sẽ được đếm ở CẢ subscribedSchools lẫn schoolsInDebt.
* Trường CHƯA TỪNG có gói nào không nằm trong ba nhóm đầu: chúng không có dòng nào trong
  school_subscriptions để gộp. Trường mới duyệt mà chưa mua gói vì thế vô hình ở đây.

Số đếm trường là ảnh chụp NGAY LÚC GỌI, không đổi theo dateFrom/dateTo. Các con số tiền thì theo cửa
sổ đang xem.
"""
type PlatformBusinessHealth {
    "Trường có kỳ thuê bao phủ hôm nay"
    subscribedSchools: Int!
    "Tập con của subscribedSchools: kỳ đang phủ sẽ hết trong 30 ngày tới"
    expiringSoonSchools: Int!
    "Từng có gói nhưng hiện không kỳ nào phủ, và không bị đình chỉ"
    lapsedSchools: Int!
    "Bị đình chỉ và hiện không có kỳ nào phủ"
    suspendedSchools: Int!
    "Ví tự nạp âm — chính là trường đang bị chặn mở ca thi"
    schoolsInDebt: Int!
    "Tiền thực thu trong cửa sổ (đơn SUCCESS), VND"
    revenueVnd: Float!
    "Cùng độ dài, ngay TRƯỚC cửa sổ — không phải tháng lịch trước"
    previousRevenueVnd: Float!
    "Giá vốn AI phát sinh trong cửa sổ, VND (ai_usage_records.cost_vnd)"
    aiCostVnd: Float!
    "null khi cửa sổ chưa thu được đồng nào — biên của doanh thu 0 không tồn tại, không phải 0%"
    grossMarginPercent: Float
    """
    Cùng công thức, tính trên kỳ so sánh — để vẽ mức chênh theo ĐIỂM PHẦN TRĂM (không phải %).

    Tính ở server chứ không để client lấy hiệu của hai tỷ lệ tự dựng: quy ước "doanh thu 0 thì biên
    không tồn tại" chỉ đúng nếu áp một lần cho cả hai kỳ. null khi kỳ trước chưa thu được đồng nào,
    và lúc đó KHÔNG có mức chênh nào để hiển thị.
    """
    previousGrossMarginPercent: Float
}

"""
Một nhóm phiên chấm lỗi cùng nguyên nhân.

`signature` là thông điệp lỗi đã chuẩn hóa (thay uuid và số bằng chỗ trống) — nó là ĐỊNH DANH của
nhóm, truyền lại y nguyên vào `gradingFailureSessions` để mở nhóm. null là nhóm "không rõ nguyên
nhân": phiên bị đánh dấu hỏng qua nhánh DLT không mang thông điệp nào, và mọi phiên hỏng từ trước
khi hệ thống bắt đầu lưu lý do cũng nằm ở đây. Đó là một nhóm THẬT, không phải dữ liệu thiếu.
"""
type GradingFailureGroup {
    signature: String
    "Một thông điệp lỗi thô đại diện, để đọc; null ở nhóm không rõ nguyên nhân"
    sampleError: String
    sessionCount: Int!
    "Kỳ thi cấp hệ thống không thuộc trường nào nên không được đếm"
    schoolCount: Int!
    examCount: Int!
    "ISO-8601. Cùng với lastFailedAt cho thấy sự cố gói trong hai tiếng hay lỗi rỉ rả suốt hai tuần"
    firstFailedAt: String
    lastFailedAt: String
    "Số phiên thuộc kỳ CHƯA công bố điểm, tức thật sự chấm lại được"
    retryableCount: Int!
}

"""
Trang phân loại phiên chấm lỗi.

sessionCount phải khớp đúng `gradingFailed` của platformOperationalHealth khi hai bên cùng khoảng:
cùng vị từ (status = GRADING_FAILED), cùng cửa sổ theo submitted_at, cùng mặc định khi bỏ trống mốc.
"""
type GradingFailureOverview {
    sessionCount: Int!
    "Số nhóm nguyên nhân, tính cả nhóm không rõ nguyên nhân nếu có"
    causeCount: Int!
    schoolCount: Int!
    retryableCount: Int!
    "Nhóm đông nhất trước"
    groups: [GradingFailureGroup!]!
    """
    Số nhóm vượt trần và bị cắt khỏi `groups`.

    Nói ra thay vì im lặng cắt, vì nó là DẤU HIỆU CHẨN ĐOÁN: chuẩn hóa thông điệp mà không gom được
    thì số nhóm nở gần bằng số phiên, và lúc đó cần sửa cách chuẩn hóa chứ không phải nới trần.
    """
    groupsTruncated: Int!
}

"""
Một phiên chấm lỗi. KHÔNG có điểm: phiên GRADING_FAILED không có dòng exam_candidate_results nào để
lấy điểm ra. Thứ thay thế là những trường giúp phân loại.
"""
type GradingFailureSession {
    sessionId: ID!
    schoolId: ID
    "null với kỳ thi cấp hệ thống"
    schoolName: String
    schoolCode: String
    examId: ID!
    examName: String!
    candidateName: String
    "ISO-8601, mốc nộp bài"
    failedAt: String
    "Dịch vụ chấm đã thử mấy lần trước khi bỏ cuộc; null khi không rõ"
    retryCount: Int
    "Thông điệp lỗi thô, nguyên văn; null ở nhóm không rõ nguyên nhân"
    error: String
    "Kỳ thi chưa công bố điểm, tức chấm lại được"
    retryable: Boolean!
    """
    Bài ĐÃ được đẩy sang hàng đợi người chấm.

    Phiên vẫn ở GRADING_FAILED vì hand-off cố ý không đổi trạng thái phiên (xem
    HandOffGradingToHumanUseCase), nên cờ này là thứ DUY NHẤT phân biệt phiên đã có người nhận với
    phiên chưa ai đụng tới.
    """
    handedOff: Boolean!
}

type GradingFailureSessionPage {
    content: [GradingFailureSession!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

"""
Bốn nhóm "trường cần chú ý". KHÔNG phải một phép chia nhóm — đừng cộng bốn số lại:

* EXPIRING_SOON là TẬP CON của nhóm trường còn gói.
* LAPSED và SUSPENDED loại trừ nhau và loại trừ nhóm còn gói.
* IN_DEBT CẮT NGANG cả ba: nó đọc từ số dư ví chứ không từ trạng thái thuê bao.

Trường CHƯA TỪNG mua gói nào không thuộc ba nhóm đầu — chúng không có dòng nào trong
school_subscriptions để gộp. Đây là hành vi giống hệt phép đếm trên trang tổng quan, giữ nguyên có
chủ đích để hai màn hình nói cùng một con số.
"""
enum SchoolRiskBucket {
    EXPIRING_SOON
    LAPSED
    SUSPENDED
    IN_DEBT
}

type SchoolAtRisk {
    schoolId: ID!
    schoolName: String!
    schoolCode: String!
    "Tên gói của kỳ LIÊN QUAN tới nhóm: kỳ đang phủ nếu còn gói, kỳ gần nhất nếu không"
    planName: String
    "ISO-8601, ngày hết hạn của chính kỳ đó"
    relevantEndDate: String
    "Lý do đình chỉ gần nhất; chỉ có nghĩa ở nhóm SUSPENDED"
    suspendedReason: String
    "Số dư ví tự nạp, VND. Âm nghĩa là trường đang bị chặn mở ca thi. Không bao giờ null"
    balanceVnd: Float!
}

type SchoolAtRiskPage {
    content: [SchoolAtRisk!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

"""
Số đếm của cả bốn nhóm.

Lấy từ CHÍNH phép đếm mà platformBusinessHealth dùng, không đếm lại bằng câu khác — nếu không thì
thẻ trên trang tổng quan ghi 5, người dùng bấm vào, và màn hình này hiện 9.
"""
type SchoolRiskBucketCounts {
    expiringSoon: Int!
    lapsed: Int!
    suspended: Int!
    inDebt: Int!
}

type SchoolsAtRisk {
    bucket: SchoolRiskBucket!
    counts: SchoolRiskBucketCounts!
    schools: SchoolAtRiskPage!
}

extend type Query {
    systemAdminDashboard: SystemAdminDashboardSummary!

    """
    Danh sách trường trong MỘT nhóm cần chú ý, kèm số đếm của cả bốn nhóm.

    KHÔNG dùng `schoolSubscriptions` cho việc này dù nó cũng lọc theo trạng thái: màn đó lọc theo
    DÒNG thuê bao còn ở đây đếm theo TRƯỜNG. Một trường có kỳ 2024 đã hết và kỳ 2025 đang chạy sẽ
    nằm trong danh sách status=EXPIRED của màn kia nhưng KHÔNG thuộc nhóm LAPSED.
    """
    schoolsAtRisk(
        bucket: SchoolRiskBucket!
        keyword: String
        page: Int = 1
        size: Int = 20
    ): SchoolsAtRisk!

    """
    Cùng quy ước khoảng với platformOperationalHealth, và cùng mặc định: bỏ trống dateTo = ngay lúc
    này, bỏ trống dateFrom = lùi 14 ngày. Người dùng bấm vào con số phiên lỗi trên trang tổng quan
    rồi mong thấy đúng những phiên tạo ra con số đó.
    """
    gradingFailureOverview(dateFrom: String, dateTo: String): GradingFailureOverview!

    """
    Phiên trong MỘT nhóm. `signature` lấy nguyên văn từ GradingFailureGroup.signature — bỏ trống
    hoặc null chọn đúng nhóm "không rõ nguyên nhân", KHÔNG phải bỏ lọc.
    """
    gradingFailureSessions(
        dateFrom: String
        dateTo: String
        signature: String
        page: Int = 1
        size: Int = 20
    ): GradingFailureSessionPage!

    """
    dateFrom/dateTo là ISO instant (vd "2026-08-01T00:00:00Z"). dateFrom BAO GỒM, dateTo KHÔNG bao
    gồm — hai dải liền nhau sẽ đếm trùng phiên rơi đúng ranh giới nếu dùng <=, cùng quy ước với
    schoolBalanceSummary. Bỏ trống dateTo = ngay lúc này; bỏ trống dateFrom = lùi 14 ngày.
    """
    platformOperationalHealth(dateFrom: String, dateTo: String): PlatformOperationalHealth!

    """
    Cùng quy ước khoảng với platformOperationalHealth. Bỏ trống dateFrom = đầu tháng hiện tại theo
    giờ Việt Nam.
    """
    platformBusinessHealth(dateFrom: String, dateTo: String): PlatformBusinessHealth!

    """
    Bài AI chấm lỗi mà CHƯA ai xử lý, của trường đang đăng nhập — chỗ đáp của dòng cùng tên trên
    trang tổng quan.

    Chạy trên đúng tập mà `schoolAdminDashboard.unscored.aiFailed` đếm: cùng một CTE sinh ra cả hai,
    nên bấm vào con số 14 sẽ ra đúng 14 dòng.

    KHÔNG nhận schoolId — phạm vi lấy từ người đang đăng nhập.

    Bỏ trống `retryLeft` là KHÔNG lọc; true chỉ lấy bài còn lượt nhờ AI chấm lại, false chỉ lấy bài
    đã hết lượt. Hai nhóm dẫn tới hai hành động khác hẳn nhau nên tách được là đáng.

    Xếp CŨ NHẤT TRƯỚC, ngược với gradingFailureSessions của quản trị hệ thống: bên đó hỏi "vừa hỏng
    chuyện gì", ở đây hỏi "em nào đã chờ lâu nhất mà vẫn chưa có điểm".
    """
    schoolGradingFailures(
        examId: ID
        retryLeft: Boolean
        page: Int = 1
        size: Int = 20
    ): SchoolGradingFailurePage!

    schoolAdminDashboard: SchoolAdminDashboardSummary!
    teacherDashboard: TeacherDashboardSummary!
    "Kỳ thi tập trung gần thời điểm hiện tại nhất của trường — null nếu chưa có kỳ thi tập trung nào"
    nearestCentralizedExam: NearestCentralizedExam
    questionBankStats: QuestionBankStats!
}
