"""
COMPARING đã bị bỏ cùng bước admin công bố: chỉ còn MỘT người chấm, và người đó nộp
điểm là công bố luôn. WITHDRAWN là học sinh tự rút khi đơn còn PENDING.
"""
enum AppealStatus {
    PENDING
    APPROVED
    GRADING
    PUBLISHED
    REJECTED
    WITHDRAWN
}

type AppealStats {
    pending: Int!
    processing: Int!   # APPROVED + GRADING
    published: Int!
    rejected: Int!
    "Học sinh tự rút — tách khỏi rejected vì đó là quyết định của học sinh"
    withdrawn: Int!
}

type AppealCriterionScore {
    criterionId: ID!
    criterionCode: String!
    label: String!
    score: Float!
    rationale: String
}

"Một lượt hỏi-đáp trong bài nói. Mỗi lượt có audio/transcript riêng."
type AppealTurn {
    id: ID!
    turnOrder: Int!
    turnType: String!
    promptText: String
    audioUrl: String
    transcript: String
    durationSeconds: Int
}

"Một phần thi được phúc khảo, kèm dữ liệu để đối chiếu."
type AppealItem {
    appealItemId: ID!
    paperItemId: ID!
    partLabel: String
    """
    Điểm tiêu chí của bản chấm đang có hiệu lực: vòng đầu là bản AI, vòng phúc khảo
    sau là bản chấm tay của vòng trước. Khớp với originalScore hiển thị cạnh nó.
    """
    baselineScores: [AppealCriterionScore!]!
    "Luôn lấy từ bản AI — chỉ bản AI mới có lượt nói"
    turns: [AppealTurn!]!
    "Điểm công bố cho phần này; null khi chưa công bố"
    finalScore: Float
}

"""
Người chấm phúc khảo — chỉ MỘT người, và dữ liệu đến từ dòng phân công vòng APPEAL
(bảng exam_appeal_reviewers đã bị bỏ).
"""
type AppealReviewer {
    assignmentId: ID!
    reviewerId: ID!
    reviewerName: String
    "ASSIGNED | COMPLETED"
    status: GradingAssignmentStatus!
    "UPHELD | REGRADED | DECLINED; null khi chưa nộp"
    outcome: GradingOutcome
    assignedAt: String
    completedAt: String
    deadlineAt: String
    overdue: Boolean!
}

type AppealSummary {
    id: ID!
    studentName: String!
    className: String
    examName: String!
    "Nhãn các phần thi được phúc khảo"
    partLabels: [String!]!
    originalScore: Float
    status: AppealStatus!
    requestedAt: String!
    deadline: String
    "Người chấm duy nhất; null khi chưa phân công"
    reviewerName: String
    reviewerStatus: GradingAssignmentStatus
    "Đơn còn đang xử lý và đã quá hạn deadline"
    overdue: Boolean!
}

type AppealSummaryPage {
    content: [AppealSummary!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type AppealDetail {
    id: ID!
    studentName: String!
    className: String
    examName: String!
    originalScore: Float
    status: AppealStatus!
    requestedAt: String!
    deadline: String
    reason: String!
    notes: String
    decisionNote: String
    "score_after — chỉ có khi đã PUBLISHED"
    finalScore: Float
    approvedAt: String
    resolvedAt: String
    withdrawnAt: String
    "Lý do admin giao cho người đã từng chấm bài này; null khi không override"
    reviewerOverrideReason: String
    "Các phần thi được phúc khảo, mỗi phần kèm điểm gốc và lượt nói riêng"
    items: [AppealItem!]!
    "Chỉ MỘT người chấm; null khi chưa phân công"
    reviewer: AppealReviewer
    "Đơn còn đang xử lý và đã quá hạn deadline"
    overdue: Boolean!
    "Thang điểm rubric — khoảng BE validate điểm tiêu chí khi chấm lại"
    scoringScaleMin: Float!
    scoringScaleMax: Float!
}

"""
Ứng viên cho picker phân công. Người xung đột lợi ích KHÔNG bị lọc bỏ mà mang cờ
`conflicted` — admin cần thấy họ để hiểu vì sao lựa chọn hẹp, và vẫn override được.
"""
type AppealReviewerLite {
    id: ID!
    name: String!
    "Số phân công đang mở đang giữ, gộp cả bốn vòng"
    load: Int!
    "Đã từng ghi điểm tay cho chính bài này"
    conflicted: Boolean!
}

extend type Query {
    "Danh sách đơn phúc khảo của trường. Phân trang 0-based."
    appeals(status: AppealStatus, keyword: String, page: Int = 0, size: Int = 20): AppealSummaryPage!

    appealStats: AppealStats!

    appeal(id: ID!): AppealDetail!

    """
    Danh sách đơn phúc khảo của học sinh đang đăng nhập. Dùng chung type AppealSummaryPage
    với school admin -- FE (web/mobile) KHÔNG được hỏi/hiện reviewerName cho học sinh
    (blind re-evaluation), nhưng chặn ở tầng UI thay vì tầng schema.
    """
    myAppeals(status: AppealStatus, page: Int = 0, size: Int = 20): AppealSummaryPage!

    """
    Chi tiết một đơn thuộc học sinh đang đăng nhập. Dùng chung type AppealDetail với school
    admin -- cùng lưu ý như myAppeals, FE không được hỏi/hiện field reviewer.
    """
    myAppeal(id: ID!): AppealDetail!

    """
    Ứng viên chấm phúc khảo cho một đơn. `appealId` là bắt buộc về mặt nghiệp vụ —
    cờ `conflicted` tính theo bài thi của đơn đó, bỏ trống thì mọi người đều hiện
    `conflicted: false`.
    """
    appealReviewers(appealId: ID, keyword: String): [AppealReviewerLite!]!
}
