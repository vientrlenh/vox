enum AppealStatus {
    PENDING
    APPROVED
    GRADING
    COMPARING
    PUBLISHED
    REJECTED
}

enum AppealReviewerStatus {
    ASSIGNED
    SUBMITTED
}

type AppealStats {
    pending: Int!
    processing: Int!   # APPROVED + GRADING + COMPARING
    published: Int!
    rejected: Int!
}

type AppealCriterionScore {
    criterionId: ID!
    criterionCode: String!
    label: String!
    score: Float!
    rationale: String
}

type AppealCriterionMeta {
    id: ID!
    code: String!
    label: String!
    description: String
    minScore: Float!
    maxScore: Float!
}

"Một lượt hỏi-đáp trong bài nói. Mỗi lượt có audio/transcript riêng."
type AppealTurn {
    id: ID!
    turnOrder: Int!
    turnType: String!
    promptText: String
    audioUrl: String
    transcript: String
    durationSeconds: Int
}

"Một phần thi được phúc khảo, kèm dữ liệu để đối chiếu."
type AppealItem {
    appealItemId: ID!
    paperItemId: ID!
    partLabel: String
    """
    Điểm tiêu chí của bản chấm đang có hiệu lực: vòng đầu là bản AI, vòng phúc khảo
    sau là bản chấm tay của vòng trước. Khớp với originalScore hiển thị cạnh nó.
    """
    baselineScores: [AppealCriterionScore!]!
    "Luôn lấy từ bản AI — chỉ bản AI mới có lượt nói"
    turns: [AppealTurn!]!
    "Điểm công bố cho phần này; null khi chưa công bố"
    finalScore: Float
}

"Báo cáo chấm lại của một giám khảo cho một phần thi."
type AppealReviewerItem {
    appealItemId: ID!
    partLabel: String
    suggestedScore: Float!
    note: String
    scores: [AppealCriterionScore!]!
}

type AppealReviewer {
    reviewerId: ID!
    reviewerName: String!
    status: AppealReviewerStatus!
    done: Boolean!
    assignedAt: String!
    submittedAt: String
    "Trung bình điểm đề xuất của các phần; null khi chưa nộp"
    suggestedScore: Float
    "Rỗng khi giám khảo chưa nộp báo cáo"
    items: [AppealReviewerItem!]!
}

type AppealSummary {
    id: ID!
    studentName: String!
    className: String
    examName: String!
    "Nhãn các phần thi được phúc khảo"
    partLabels: [String!]!
    originalScore: Float
    status: AppealStatus!
    requestedAt: String!
    deadline: String
    reviewerCount: Int!
    doneCount: Int!
    "Đơn còn đang xử lý và đã quá hạn deadline"
    overdue: Boolean!
}

type AppealSummaryPage {
    content: [AppealSummary!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type AppealDetail {
    id: ID!
    studentName: String!
    className: String
    examName: String!
    originalScore: Float
    status: AppealStatus!
    requestedAt: String!
    deadline: String
    reason: String!
    notes: String
    decisionNote: String
    "score_after — chỉ có khi đã PUBLISHED"
    finalScore: Float
    approvedAt: String
    resolvedAt: String
    "Các phần thi được phúc khảo, mỗi phần kèm điểm AI gốc và lượt nói riêng"
    items: [AppealItem!]!
    reviewers: [AppealReviewer!]!
    "Đơn còn đang xử lý và đã quá hạn deadline"
    overdue: Boolean!
    "Thang điểm rubric — khoảng BE validate partScore khi công bố"
    scoringScaleMin: Float!
    scoringScaleMax: Float!
}

"Góc nhìn giám khảo"
type AppealTask {
    appealId: ID!
    examName: String!
    partLabels: [String!]!
    deadline: String
    myStatus: AppealReviewerStatus!
    "Việc chưa nộp và đã quá hạn deadline"
    overdue: Boolean!
}

type AppealTaskPage {
    content: [AppealTask!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

"""
Màn chấm lại của giám khảo. Có baselineScores để tham chiếu, nhưng KHÔNG có báo cáo
của giám khảo khác — tránh thiên lệch.
"""
type AppealTaskDetail {
    appealId: ID!
    "Các phần thi phải chấm lại, mỗi phần kèm lượt nói và điểm đối chiếu riêng"
    items: [AppealItem!]!
    criteria: [AppealCriterionMeta!]!
    "Báo cáo của chính mình theo từng phần; rỗng nếu chưa nộp"
    myReport: [AppealReviewerItem!]!
}

"Ứng viên cho picker phân công"
type AppealReviewerLite {
    id: ID!
    name: String!
    "Số việc chấm lại đang giữ (status = ASSIGNED)"
    load: Int!
}

extend type Query {
    "Danh sách đơn phúc khảo của trường. Phân trang 0-based."
    appeals(status: AppealStatus, keyword: String, page: Int = 0, size: Int = 20): AppealSummaryPage!

    appealStats: AppealStats!

    appeal(id: ID!): AppealDetail!

    "Việc chấm lại của giám khảo đang đăng nhập. Phân trang 0-based."
    myAppealTasks(status: AppealReviewerStatus, page: Int = 0, size: Int = 20): AppealTaskPage!

    appealTaskDetail(appealId: ID!): AppealTaskDetail!

    appealReviewers(keyword: String): [AppealReviewerLite!]!

    "Đơn phúc khảo của chính học sinh đang đăng nhập. Phân trang 0-based."
    myAppeals(status: AppealStatus, page: Int = 0, size: Int = 20): AppealSummaryPage!

    myAppeal(id: ID!): AppealDetail!
}
