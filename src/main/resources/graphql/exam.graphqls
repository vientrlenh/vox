enum ExamKind {
    CENTRALIZED
    CLASS_TEST
}

enum ExamDeliveryMode {
    STUDENT_DEVICE
    LAB
}

enum ExamStatus {
    DRAFT
    SCHEDULED
    IN_PROGRESS
    CLOSED
    RESULTS_PUBLISHED
    CANCELLED
}

enum ResultDecisionMethod {
    HIGHEST
    LATEST
    AVERAGE
    FIRST
    LOWEST
}

enum ExamMemberRole {
    CHAIR
    AUTHOR
    REVIEWER
}

enum ExamBlueprintVersionStatus {
    DRAFT
    PUBLISHED
    ARCHIVED
}

enum ExamBlueprintSlotType {
    FIXED
    SELECTION
}

enum ExamPaperStatus {
    DRAFT
    IN_REVIEW
    APPROVED
    LOCKED
}

enum ExamScheduleStatus {
    DRAFT
    PUBLISHED
    COMPLETED
    MOVED
    CANCELLED
    DELETED
}

enum ExamCandidateStatus {
    ASSIGNED
    ABSENT
    COMPLETED
    EXEMPTED
    CANCELLED
}

enum ExamSessionStatus {
    IN_PROGRESS
    SUBMITTED
    INTERRUPTED
    GRADING
    GRADED
    EXPIRED
    GRADING_FAILED
}
enum ExamSecurePoolStatus {
    SEALED
    RELEASED
}

enum ExamSecurePoolReleaseMode {
    MANUAL
    AUTO_AFTER_CLOSE
}

type QuestionSelectionSpec {
    questionType: QuestionType
    difficulty: QuestionDifficulty
    targetBandLevel: String
    skillCode: String
    topicId: ID
}

type ExamMember {
    id: ID!
    userId: ID!
    role: ExamMemberRole!
    grantedAt: String
    grantedBy: ID
    user: User
}

type ExamSecurePool {
    id: ID!
    examId: ID!
    status: ExamSecurePoolStatus!
    releaseMode: ExamSecurePoolReleaseMode!
    embargoUntil: String
    releasedAt: String
    releasedBy: ID
}

type ExamPaperItem {
    id: ID!
    blueprintSlotId: ID
    sectionId: ID!
    paperId: ID!
    questionId: ID
    order: Int!
    weight: Float
    question: Question
}

type ExamPaperSection {
    id: ID!
    paperId: ID!
    order: Int!
    title: String
    instruction: String
    weight: Float
    sectionTimeLimitSeconds: Int
    createdAt: String
    updatedAt: String
    createdBy: ID
    updatedBy: ID
    items: [ExamPaperItem!]!
}

type ExamPaper {
    id: ID!
    examId: ID!
    blueprintVersionId: ID
    code: String!
    variant: Int!
    status: ExamPaperStatus!
    createdAt: String
    updatedAt: String
    createdBy: ID
    updatedBy: ID
    sections: [ExamPaperSection!]!
}

type Exam {
    id: ID!
    blueprintId: ID
    blueprintVersionId: ID
    blueprint: ExamBlueprint
    blueprintVersion: ExamBlueprintVersion
    code: String!
    name: String!
    description: String
    schoolId: ID!
    languageId: ID!
    kind: ExamKind!
    deliveryMode: ExamDeliveryMode
    status: ExamStatus!
    maxAttempt: Int
    resultDecisionMethod: ResultDecisionMethod
    openAt: String
    closeAt: String
    assessmentPolicyId: ID
    requiresOtp: Boolean!
    papersLocked: Boolean
    createdAt: String
    updatedAt: String
    createdBy: ID
    updatedBy: ID
    members: [ExamMember!]!
    papers(status: ExamPaperStatus): [ExamPaper!]!
    securePool: ExamSecurePool
    schoolClassId: ID
    candidateCount: Int!
}

type ExamStatusCounts {
    total: Int!
    draft: Int!
    scheduled: Int!
    inProgress: Int!
    closed: Int!
    resultsPublished: Int!
    cancelled: Int!
}

type ExamPage {
    content: [Exam!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type ExamBlueprintSlot {
    id: ID!
    sectionId: ID
    blueprintVersionId: ID!
    order: Int!
    weight: Float
    prepTimeSecondsOverride: Int
    responseTimeSecondsOverride: Int
    slotType: ExamBlueprintSlotType!
    fixedQuestionId: ID
    selectionSpec: QuestionSelectionSpec
    createdAt: String
    updatedAt: String
    createdBy: ID
    updatedBy: ID
    fixedQuestion: Question
}

type ExamBlueprintSection {
    id: ID!
    blueprintVersionId: ID!
    order: Int!
    title: String!
    instruction: String
    sectionTimeLimitSeconds: Int
    sectionWeight: Float
    createdAt: String
    updatedAt: String
    createdBy: ID
    updatedBy: ID
    slots: [ExamBlueprintSlot!]!
}

type ExamBlueprintVersion {
    id: ID!
    blueprintId: ID!
    version: Int!
    code: String!
    description: String
    status: ExamBlueprintVersionStatus!
    totalTimeLimitSeconds: Int
    effectiveFrom: String
    effectiveTo: String
    createdAt: String
    updatedAt: String
    createdBy: ID
    updatedBy: ID
    sections: [ExamBlueprintSection!]!
    sectionCount: Int!
    slotCount: Int!
    weightSum: Float!
}

type ExamBlueprint {
    id: ID!
    schoolId: ID!
    languageId: ID!
    schoolGradeLevelId: ID
    code: String!
    name: String!
    description: String
    isActive: Boolean!
    createdAt: String
    updatedAt: String
    createdBy: ID
    updatedBy: ID
    versions(status: ExamBlueprintVersionStatus): [ExamBlueprintVersion!]!
    versionCount: Int!
    currentVersion: ExamBlueprintVersion
    sectionCount: Int!
}

type ExamBlueprintPage {
    content: [ExamBlueprint!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type ExamScheduleProctor {
    id: ID!
    scheduleId: ID!
    teacher: User
}

type ExamSchedule {
    id: ID!
    examId: ID!
    schoolRoomId: ID
    room: SchoolRoom
    startDate: String
    endDate: String
    status: ExamScheduleStatus!
    movedToScheduleId: ID
    proctors: [ExamScheduleProctor!]!
    candidateCount: Int!
    requiredProctorCount: Int!
}

type ExamCandidate {
    id: ID!
    examId: ID!
    studentId: ID!
    latestSessionId: ID
    attempts: [ExamAttemptSummary!]!
    officialAttempt: ExamAttemptSummary
    officialScore: Float
    assignedPaperId: ID
    scheduleId: ID
    status: ExamCandidateStatus!
    assignedAt: String
    updatedAt: String
    blockedAt: String
    student: User
    assignedPaper: ExamPaper
    schedule: ExamSchedule
    exam: Exam
}

type ProctorScheduleSummary {
    scheduleId: ID!
    examId: ID!
    examName: String
    schoolRoomId: ID
    roomName: String
    startDate: String
    endDate: String
    status: String
}

type ProctorCandidateSummary {
    candidateId: ID!
    studentId: ID!
    studentName: String
    studentEmail: String
    status: String
    blockedAt: String
    sessionId: ID
    sessionStatus: String
    sessionFlagged: Boolean!
}

type ExamAttemptSummary {
    sessionId: ID!
    startedAt: String
    submittedAt: String
    status: ExamSessionStatus!
    flagged: Boolean!
    flagReason: String
    totalScore: Float
    rubricResultBandCode: String
    rubricResultBandName: String
    resultStatus: ExamCandidateResultStatus
}

enum ExamCandidateResultStatus {
    PENDING_REVIEW
    RELEASED
    APPEALED
    RE_GRADING
    FINAL
    INVALID
    RETAKE_REQUIRED
}

type ExamSession {
    id: ID!
    examId: ID!
    candidateId: ID!
    paperId: ID!
    startedAt: String
    submittedAt: String
    status: ExamSessionStatus!
    flagged: Boolean!
    flagReason: String
    candidateBlocked: Boolean!
}

type ExamSessionFollowup {
    examItemResponseId: ID!
    followupCount: Int!
    totalTurns: Int!
}

type ExamCandidateResultSection {
    sectionId: ID!
    title: String
    score: Float!
}

type ExamCandidateResultItem {
    paperItemId: ID!
    responseId: ID!
    sectionId: ID!
    itemScore: Float!
    weightedScore: Float!
}

type ExamCandidateResult {
    id: ID!
    sessionId: ID!
    examId: ID!
    paperId: ID!
    candidateId: ID!
    flagged: Boolean!
    flagReason: String
    scoreVisible: Boolean!
    totalScore: Float
    targetFrameworkBandId: ID
    targetFrameworkBandCode: String
    targetFrameworkBandLabel: String
    rubricResultBandId: ID
    rubricResultBandCode: String
    rubricResultBandName: String
    status: ExamCandidateResultStatus!
    sections: [ExamCandidateResultSection!]!
    items: [ExamCandidateResultItem!]!
}

type ExamItemResponseTurn {
    id: ID!
    examItemResponseId: ID!
    turnOrder: Int!
    turnType: String!
    promptText: String
    audioUrl: String
    transcript: String
    durationSeconds: Int
    wordCount: Int
    answeredAt: String
    createdAt: String
}

type ExamItemResponseDetails {
    id: ID!
    sessionId: ID!
    paperItemId: ID!
    audioUrl: String
    durationSeconds: Int
    transcript: String
    submittedAt: String
    turns: [ExamItemResponseTurn!]!
}

type ExamItemCriterionScore {
    id: ID!
    rubricCriterionId: ID
    criterionCode: String
    criterionName: String
    rawScore: Float
    finalScore: Float
    rationale: String
}

type ExamItemEvaluationTurn {
    id: ID!
    turnOrder: Int
    turnType: String
    promptText: String
    audioUrl: String
    transcript: String
    wordCount: Int
    durationSeconds: Int
    asrConfidence: Float
    pronunciationOverall: String
    wordFeedback: String
}

type ExamItemEvaluationDetails {
    id: ID!
    responseId: ID!
    paperItemId: ID!
    engineType: String
    gradedByModel: String
    promptVersion: String
    rawItemScore: Float
    itemScore: Float
    overallConfidence: Float
    markedInvalid: Boolean!
    requiresRetake: Boolean!
    requiresHumanReview: Boolean!
    reviewReasonCode: String
    status: String
    evaluatedAt: String
    feedbackSummary: String
    signals: String
    validity: String
    suggestions: String
    criteria: [ExamItemCriterionScore!]!
    turns: [ExamItemEvaluationTurn!]!
}

type StudentExamResultSummary {
    candidateId: ID!
    examId: ID!
    examCode: String
    examName: String
    sessionId: ID
    paperId: ID
    sessionStatus: String
    sessionFlagged: Boolean!
    startedAt: String
    submittedAt: String
    totalScore: Float
    resultStatus: String
    rubricResultBandId: ID
    rubricResultBandCode: String
    rubricResultBandName: String
}
input UpdateExamScheduleInput {
    schoolRoomId: ID
    startDate: String
    endDate: String
}

extend type Query {
    exams(
        kind: ExamKind,
        status: ExamStatus,
        schoolId: ID,
        keyword: String,
        page: Int = 0,
        size: Int = 20
    ): ExamPage!

    exam(id: ID!): Exam

    examMyRole(examId: ID!): String

    examPaper(id: ID!): ExamPaper

    examStatusCounts(schoolId: ID, kind: ExamKind): ExamStatusCounts!

    classTests(
        status: ExamStatus,
        schoolClassId: ID,
        keyword: String,
        page: Int = 0,
        size: Int = 20
    ): ExamPage!

    examBlueprints(
        schoolId: ID,
        isActive: Boolean,
        languageId: ID,
        examKind: String,
        keyword: String,
        page: Int = 0,
        size: Int = 20
    ): ExamBlueprintPage!

    examBlueprint(id: ID!): ExamBlueprint

    examSchedules(examId: ID, status: ExamScheduleStatus, startDate: String, endDate: String): [ExamSchedule!]!

    examCandidates(examId: ID!, scheduleId: ID, status: ExamCandidateStatus): [ExamCandidate!]!

    examSession(id: ID!): ExamSession

    examSessionResult(sessionId: ID!): ExamCandidateResult

    examSessionFollowups(sessionId: ID!): [ExamSessionFollowup!]!

    myExamResults: [StudentExamResultSummary!]!

    myProctorSchedules: [ProctorScheduleSummary!]!

    myProctorScheduleCandidates(scheduleId: ID!): [ProctorCandidateSummary!]!

    examItemResponse(answerId: ID!): ExamItemResponseDetails

    examItemResponseTurns(answerId: ID!): [ExamItemResponseTurn!]!

    examItemResponseEvaluation(answerId: ID!): ExamItemEvaluationDetails
}

extend type Mutation {
    updateExamSchedule(id: ID!, input: UpdateExamScheduleInput!): ID!
    flagExamSession(sessionId: ID!, reason: String!): ID!
    forceEndExamSession(sessionId: ID!, reason: String!): ID!
    unblockExamCandidate(candidateId: ID!, reason: String!): ID!
    reviewFlaggedExamResult(candidateResultId: ID!, decision: ExamCandidateResultStatus!): ID!
    retryGradingExamSession(sessionId: ID!): ID!
    updateExamCandidateStatus(candidateId: ID!, status: ExamCandidateStatus!): ID!
}
