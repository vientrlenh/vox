enum ExamKind {
    CENTRALIZED
    CLASS_TEST
}

enum ExamDeliveryMode {
    STUDENT_DEVICE
    LAB
}

enum ExamRequiredStreamType {
    CAMERA
    SCREEN
    CAMERA_AND_SCREEN
}

enum ExamStreamTypePermission {
    ANY
    ALL
}

enum ExamStatus {
    DRAFT
    SCHEDULED
    IN_PROGRESS
    CLOSED
    RESULTS_PUBLISHED
    CANCELLED
}

enum ResultDecisionMethod {
    HIGHEST
    LATEST
    AVERAGE
    FIRST
    LOWEST
}

enum ExamMemberRole {
    CHAIR
    AUTHOR
    REVIEWER
}

enum ExamBlueprintVersionStatus {
    DRAFT
    PUBLISHED
    ARCHIVED
}

enum ExamBlueprintSlotType {
    FIXED
    SELECTION
}

enum ExamPaperStatus {
    DRAFT
    IN_REVIEW
    APPROVED
    LOCKED
}

enum ExamScheduleStatus {
    DRAFT
    PUBLISHED
    COMPLETED
    MOVED
    CANCELLED
    DELETED
}

enum ExamCandidateStatus {
    ASSIGNED
    ATTENDED
    ABSENT
    COMPLETED
    EXEMPTED
    CANCELLED
}

enum ExamSessionStatus {
    IN_PROGRESS
    SUBMITTED
    INTERRUPTED
    GRADING
    GRADED
    EXPIRED
    GRADING_FAILED
}
enum ExamSecurePoolStatus {
    SEALED
    RELEASED
}

enum ExamSecurePoolReleaseMode {
    MANUAL
    AUTO_AFTER_CLOSE
}

enum ExamRecordingStreamType {
    CAMERA
    SCREEN
}

type QuestionSelectionSpec {
    questionType: QuestionType
    difficulty: QuestionDifficulty
    targetBandLevel: String
    skillCode: String
    topicId: ID
}

type ExamMember {
    id: ID!
    userId: ID!
    role: ExamMemberRole!
    grantedAt: String
    grantedBy: ID
    user: User
}

type ExamSecurePool {
    id: ID!
    examId: ID!
    status: ExamSecurePoolStatus!
    releaseMode: ExamSecurePoolReleaseMode!
    embargoUntil: String
    releasedAt: String
    releasedBy: ID
}

type ExamPaperItem {
    id: ID!
    blueprintSlotId: ID
    sectionId: ID!
    paperId: ID!
    questionId: ID
    order: Int!
    weight: Float
    """
    Loại ô trong blueprint sinh ra câu này. null khi câu không sinh từ blueprint,
    hoặc khi slot tương ứng đã bị xoá — cả hai trường hợp đều được phép gán câu tự do.
    """
    slotType: ExamBlueprintSlotType
    """Tiêu chí rút câu của ô SELECTION; null với ô FIXED và câu không sinh từ blueprint."""
    selectionSpec: QuestionSelectionSpec
    question: Question
}

type ExamPaperSection {
    id: ID!
    paperId: ID!
    order: Int!
    title: String
    instruction: String
    weight: Float
    sectionTimeLimitSeconds: Int
    createdAt: String
    updatedAt: String
    createdBy: ID
    updatedBy: ID
    items: [ExamPaperItem!]!
}

type ExamPaper {
    id: ID!
    examId: ID!
    blueprintVersionId: ID
    code: String!
    variant: Int!
    status: ExamPaperStatus!
    timeDurationSeconds: Int
    createdAt: String
    updatedAt: String
    createdBy: ID
    updatedBy: ID
    sections: [ExamPaperSection!]!
}

type Exam {
    id: ID!
    blueprintId: ID
    blueprintVersionId: ID
    blueprint: ExamBlueprint
    blueprintVersion: ExamBlueprintVersion
    code: String!
    name: String!
    description: String
    schoolId: ID!
    languageId: ID!
    kind: ExamKind!
    deliveryMode: ExamDeliveryMode
    status: ExamStatus!
    maxAttempt: Int
    examTimeDurationSecond: Int
    resultDecisionMethod: ResultDecisionMethod
    openAt: String
    closeAt: String
    assessmentPolicyId: ID
    requiresOtp: Boolean!
    requiredStreamType: ExamRequiredStreamType
    streamTypePermission: ExamStreamTypePermission
    papersLocked: Boolean
    createdAt: String
    updatedAt: String
    createdBy: ID
    updatedBy: ID
    members: [ExamMember!]!
    papers(status: ExamPaperStatus): [ExamPaper!]!
    # Ca thi của kỳ thi (đã loại ca xoá mềm), chạy qua DataLoader examSchedulesByExamId nên trang
    # danh sách kỳ thi dựng được thanh tiến độ "đã xếp lịch tới đâu" mà không N+1.
    schedules: [ExamSchedule!]!
    securePool: ExamSecurePool
    schoolClassId: ID
    candidateCount: Int!
}

type ExamStatusCounts {
    total: Int!
    draft: Int!
    scheduled: Int!
    inProgress: Int!
    closed: Int!
    resultsPublished: Int!
    cancelled: Int!
}

type ExamPage {
    content: [Exam!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type ExamBlueprintSlot {
    id: ID!
    sectionId: ID
    blueprintVersionId: ID!
    order: Int!
    weight: Float
    prepTimeSecondsOverride: Int
    responseTimeSecondsOverride: Int
    slotType: ExamBlueprintSlotType!
    fixedQuestionId: ID
    selectionSpec: QuestionSelectionSpec
    createdAt: String
    updatedAt: String
    createdBy: ID
    updatedBy: ID
    fixedQuestion: Question
}

type ExamBlueprintSection {
    id: ID!
    blueprintVersionId: ID!
    order: Int!
    title: String!
    instruction: String
    sectionTimeLimitSeconds: Int
    sectionWeight: Float
    createdAt: String
    updatedAt: String
    createdBy: ID
    updatedBy: ID
    slots: [ExamBlueprintSlot!]!
}

type ExamBlueprintVersion {
    id: ID!
    blueprintId: ID!
    version: Int!
    code: String!
    description: String
    status: ExamBlueprintVersionStatus!
    totalTimeLimitSeconds: Int
    effectiveFrom: String
    effectiveTo: String
    createdAt: String
    updatedAt: String
    createdBy: ID
    updatedBy: ID
    sections: [ExamBlueprintSection!]!
    sectionCount: Int!
    slotCount: Int!
    weightSum: Float!
}

type ExamBlueprint {
    id: ID!
    schoolId: ID!
    languageId: ID!
    schoolGradeLevelId: ID
    code: String!
    name: String!
    description: String
    isActive: Boolean!
    createdAt: String
    updatedAt: String
    createdBy: ID
    updatedBy: ID
    versions(status: ExamBlueprintVersionStatus): [ExamBlueprintVersion!]!
    versionCount: Int!
    currentVersion: ExamBlueprintVersion
    sectionCount: Int!
}

type ExamBlueprintPage {
    content: [ExamBlueprint!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type ExamScheduleProctor {
    id: ID!
    scheduleId: ID!
    teacher: User
}

type ExamSchedule {
    id: ID!
    examId: ID!
    exam: Exam
    schoolRoomId: ID
    room: SchoolRoom
    startDate: String
    endDate: String
    status: ExamScheduleStatus!
    movedToScheduleId: ID
    proctors: [ExamScheduleProctor!]!
    candidateCount: Int!
    requiredProctorCount: Int!
}

# Một giáo viên đang vướng lịch: đã gác ca `scheduleId` chạy [startDate, endDate).
# Chỉ để làm mờ sẵn người bận ở màn chọn giám thị — luật chặn thật chạy lúc ghi.
type ProctorBusySlot {
    teacherId: ID!
    scheduleId: ID!
    startDate: String
    endDate: String
}

type ExamCandidate {
    id: ID!
    examId: ID!
    studentId: ID!
    latestSessionId: ID
    attempts: [ExamAttemptSummary!]!
    officialAttempt: ExamAttemptSummary
    officialScore: Float
    assignedPaperId: ID
    scheduleId: ID
    status: ExamCandidateStatus!
    assignedAt: String
    updatedAt: String
    blockedAt: String
    student: User
    assignedPaper: ExamPaper
    schedule: ExamSchedule
    exam: Exam
}

type ProctorScheduleSummary {
    scheduleId: ID!
    examId: ID!
    examName: String
    schoolRoomId: ID
    roomName: String
    startDate: String
    endDate: String
    status: String
}

type ProctorCandidateSummary {
    candidateId: ID!
    studentId: ID!
    studentName: String
    studentEmail: String
    status: String
    blockedAt: String
    sessionId: ID
    sessionStatus: String
    sessionFlagged: Boolean!
}

type ExamAttemptSummary {
    sessionId: ID!
    startedAt: String
    submittedAt: String
    status: ExamSessionStatus!
    flagged: Boolean!
    flagReason: String
    totalScore: Float
    """
    Thang điểm của rubric đã chấm lượt này. Danh sách trộn nhiều kỳ thi, mỗi kỳ có thể
    dùng rubric khác thang -- client PHẢI đọc theo từng dòng, không suy từ cấu hình chung.
    Null khi chưa có kết quả hoặc điểm đang bị che.
    """
    scoringScaleMin: Float
    scoringScaleMax: Float
    rubricResultBandCode: String
    rubricResultBandName: String
    resultStatus: ExamCandidateResultStatus
}

enum ExamCandidateResultStatus {
    PENDING_REVIEW
    RELEASED
    APPEALED
    RE_GRADING
    FINAL
    INVALID
    RETAKE_REQUIRED
    PASSED
    FAILED
}

type ExamSession {
    id: ID!
    examId: ID!
    candidateId: ID!
    paperId: ID!
    startedAt: String
    submittedAt: String
    status: ExamSessionStatus!
    flagged: Boolean!
    flagReason: String
    candidateBlocked: Boolean!
}

type ExamSessionFollowup {
    examItemResponseId: ID!
    followupCount: Int!
    totalTurns: Int!
}

type ExamCandidateResultSection {
    sectionId: ID!
    title: String
    score: Float!
}

type ExamCandidateResultItem {
    paperItemId: ID!
    responseId: ID!
    sectionId: ID!
    itemScore: Float!
    weightedScore: Float!
}

type ExamCandidateResult {
    id: ID!
    sessionId: ID!
    examId: ID!
    paperId: ID!
    candidateId: ID!
    flagged: Boolean!
    flagReason: String
    scoreVisible: Boolean!
    totalScore: Float
    scoringScaleMin: Float
    scoringScaleMax: Float
    targetFrameworkBandId: ID
    targetFrameworkBandCode: String
    targetFrameworkBandLabel: String
    rubricResultBandId: ID
    rubricResultBandCode: String
    rubricResultBandName: String
    status: ExamCandidateResultStatus!
    sections: [ExamCandidateResultSection!]!
    items: [ExamCandidateResultItem!]!
}

type ExamItemResponseTurn {
    id: ID!
    examItemResponseId: ID!
    turnOrder: Int!
    turnType: String!
    promptText: String
    audioUrl: String
    transcript: String
    durationSeconds: Int
    wordCount: Int
    answeredAt: String
    createdAt: String
}

type ExamItemResponseDetails {
    id: ID!
    sessionId: ID!
    paperItemId: ID!
    audioUrl: String
    durationSeconds: Int
    transcript: String
    submittedAt: String
    turns: [ExamItemResponseTurn!]!
}

type ExamItemCriterionScore {
    id: ID!
    rubricCriterionId: ID
    criterionCode: String
    criterionName: String
    minScore: Float
    maxScore: Float
    rawScore: Float
    finalScore: Float
    rationale: String
}

type ExamItemEvaluationTurn {
    id: ID!
    turnOrder: Int
    turnType: String
    promptText: String
    audioUrl: String
    transcript: String
    wordCount: Int
    durationSeconds: Int
    asrConfidence: Float
    pronunciationOverall: String
    wordFeedback: String
}

"""
Bằng chứng của bản chấm AI, giữ lại kể cả khi giáo viên đã chấm lại (lúc đó bản AI mang
SUPERSEDED). Điểm và rationale hiển thị vẫn là của bản đang có hiệu lực ở cấp trên — khối
này chỉ là NGỮ CẢNH, không phải phán quyết. `null` khi bài chưa từng có bản AI.

Báo cáo phúc khảo `UNDER_REVIEW` (chưa công bố) không bao giờ lọt vào đây.
"""
type ExamItemAiEvaluationContext {
    evaluationId: ID!
    engineType: String
    gradedByModel: String
    promptVersion: String
    overallConfidence: Float
    requiresHumanReview: Boolean!
    reviewReasonCode: String
    markedInvalid: Boolean!
    requiresRetake: Boolean!
    evaluatedAt: String
    feedbackSummary: String
    "JSON string — EvaluationSignals"
    signals: String
    "JSON string — ValidityResult"
    validity: String
    "JSON string"
    suggestions: String
}

type ExamItemEvaluationDetails {
    id: ID!
    responseId: ID!
    paperItemId: ID!
    engineType: String
    gradedByModel: String
    promptVersion: String
    rawItemScore: Float
    itemScore: Float
    overallConfidence: Float
    markedInvalid: Boolean!
    requiresRetake: Boolean!
    requiresHumanReview: Boolean!
    reviewReasonCode: String
    status: String
    evaluatedAt: String
    feedbackSummary: String
    signals: String
    validity: String
    suggestions: String
    criteria: [ExamItemCriterionScore!]!
    "Luôn lấy từ bản AI — chỉ bản AI mới sinh lượt nói, bản chấm tay không có turn nào."
    turns: [ExamItemEvaluationTurn!]!
    ai: ExamItemAiEvaluationContext
}

type StudentExamResultSummary {
    candidateId: ID!
    examId: ID!
    examCode: String
    examName: String
    kind: ExamKind!
    sessionId: ID
    paperId: ID
    sessionStatus: String
    sessionFlagged: Boolean!
    startedAt: String
    submittedAt: String
    totalScore: Float
    """
    Thang điểm của rubric đã chấm lượt này. Danh sách trộn nhiều kỳ thi, mỗi kỳ có thể
    dùng rubric khác thang -- client PHẢI đọc theo từng dòng, không suy từ cấu hình chung.
    Null khi chưa có kết quả hoặc điểm đang bị che.
    """
    scoringScaleMin: Float
    scoringScaleMax: Float
    resultStatus: String
    rubricResultBandId: ID
    rubricResultBandCode: String
    rubricResultBandName: String
}
type ExamRecording {
    id: ID!
    examSessionId: ID!
    candidateId: ID
    streamType: String
    status: String
    sizeBytes: Int
    durationSeconds: Int
    source: String
    canonical: Boolean!
    createdAt: String
    assembledAt: String
}

"""
Bản ghi kèm LINK PHÁT được, dành cho màn chấm bài.

Tách khỏi `ExamRecording` thay vì thêm field vào đó: `records` là API của app giám thị trên
desktop (`ExamRecordingService`), chạy trong lúc thi và không cần link phát. Nhét thêm vào đó
nghĩa là mỗi lượt gọi của giám thị đều phải ký link cho mọi bản ghi, cho một thứ nó không dùng.
"""
type ExamRecordingPlayback {
    id: ID!
    streamType: String
    status: String
    source: String
    durationSeconds: Int
    """Bản nên mở trước cho streamType này khi có nhiều nguồn cùng ghi."""
    canonical: Boolean!
    """
    Link phát trực tiếp trong thẻ <video>, ký sẵn và HẾT HẠN sau 2 giờ.

    NULL khi bản ghi chưa có file trên S3 (đang PROCESSING, hoặc FAILED/ABANDONED) -- đó là
    trạng thái bình thường, không phải lỗi. Vì link có hạn, đừng lưu lại hay chia sẻ: hỏi lại
    query này mỗi lần mở trình phát.
    """
    playbackUrl: String
}

input UpdateExamScheduleInput {
    schoolRoomId: ID
    startDate: String
    endDate: String
}

extend type Query {
    exams(
        kind: ExamKind,
        status: ExamStatus,
        schoolId: ID,
        keyword: String,
        page: Int = 0,
        size: Int = 20
    ): ExamPage!

    exam(id: ID!): Exam

    examMyRole(examId: ID!): String

    examPaper(id: ID!): ExamPaper

    examStatusCounts(schoolId: ID, kind: ExamKind, dateFrom: String, dateTo: String): ExamStatusCounts!

    classTests(
        status: ExamStatus,
        schoolClassId: ID,
        keyword: String,
        page: Int = 0,
        size: Int = 20
    ): ExamPage!

    examBlueprints(
        schoolId: ID,
        isActive: Boolean,
        languageId: ID,
        examKind: String,
        keyword: String,
        page: Int = 0,
        size: Int = 20
    ): ExamBlueprintPage!

    examBlueprint(id: ID!): ExamBlueprint
    examBlueprintVersion(id: ID!): ExamBlueprintVersion

    examSchedules(examId: ID, status: ExamScheduleStatus, startDate: String, endDate: String): [ExamSchedule!]!
    myExamSchedules(examId: ID, status: ExamScheduleStatus, startDate: String, endDate: String): [ExamSchedule!]!
    proctorBusySlots(scheduleId: ID!, teacherIds: [ID!]!): [ProctorBusySlot!]!

    examCandidates(examId: ID!, scheduleId: ID, status: ExamCandidateStatus): [ExamCandidate!]!

    examSession(id: ID!): ExamSession

    examSessionResult(sessionId: ID!): ExamCandidateResult

    examSessionFollowups(sessionId: ID!): [ExamSessionFollowup!]!

    myExamResults: [StudentExamResultSummary!]!

    myProctorSchedules: [ProctorScheduleSummary!]!

    myProctorScheduleCandidates(scheduleId: ID!): [ProctorCandidateSummary!]!

    examItemResponse(answerId: ID!): ExamItemResponseDetails

    examItemResponseTurns(answerId: ID!): [ExamItemResponseTurn!]!

    examItemResponseEvaluation(answerId: ID!): ExamItemEvaluationDetails
    # Đổi tên `records` -> `recordings` (2026-08-07). Resolver luôn tên `recordings`
    # (ExamSessionController#recordings), nên field `records` KHÔNG có ai phục vụ -- báo cáo
    # schema inspection lúc khởi động liệt kê nó ở "Unmapped fields", và gọi vào sẽ vỡ vì kiểu
    # trả về non-null. Không client nào đang gọi nên đổi tên field là an toàn.
    recordings(examSessionId: ID!, streamType: ExamRecordingStreamType): [ExamRecording!]!

    """
    Bản ghi camera + màn hình của một phiên thi, kèm link phát -- cho màn chấm bài và trang kết
    quả phía giáo viên. Cùng luật quyền với `records` (school admin, hoặc giáo viên là chủ tịch
    hội đồng / giám thị của đúng ca thi).
    """
    examRecordingPlayback(examSessionId: ID!): [ExamRecordingPlayback!]!
}

extend type Mutation {
    updateExamSchedule(id: ID!, input: UpdateExamScheduleInput!): ID!
    # Toggle: flagged=true đánh dấu nghi vấn (reason bắt buộc), flagged=false bỏ đánh dấu.
    flagExamSession(sessionId: ID!, flagged: Boolean!, reason: String): ID!
    forceEndExamSession(sessionId: ID!, reason: String!): ID!
    unblockExamCandidate(candidateId: ID!, reason: String!): ID!
    # reviewFlaggedExamResult / releasePendingExamResult đã bị gỡ: người quyết là GIÁO VIÊN
    # ĐANG CẦM BÀI, qua REST /api/v1/grading-assignments/{id}/uphold | /regrade | /invalidate.
    # Chỉ áp dụng khi kết quả đang FINAL (kỳ thi đã RESULTS_PUBLISHED nhưng assessmentPolicy
    # không có passingScore) -- nhà trường tự chốt PASSED hoặc FAILED thủ công.
    decideExamCandidateResultOutcome(candidateResultId: ID!, decision: ExamCandidateResultStatus!): ID!
    retryGradingExamSession(sessionId: ID!): ID!
    # TEST-ONLY: chấm lại 1 phiên thi bằng AI bất kể trạng thái (kể cả đã GRADED) -- re-publish
    # grading request từ dữ liệu làm bài đã lưu, evaluation cũ bị ghi đè (upsert). Dùng để kiểm
    # thử pipeline chấm điểm, không phải luồng nghiệp vụ chính thức.
    regradeExamSessionForTest(sessionId: ID!): ID!
    updateExamCandidateStatus(candidateId: ID!, status: ExamCandidateStatus!): ID!
    updateExamCandidatesAttendance(scheduleId: ID!, candidateIds: [ID!]!): [ExamCandidate!]!
}