enum ExamKind {
    CENTRALIZED
    CLASS_TEST
}

enum ExamDeliveryMode {
    STUDENT_DEVICE
    LAB
}

enum ExamRequiredStreamType {
    CAMERA
    SCREEN
    CAMERA_AND_SCREEN
}

enum ExamStreamTypePermission {
    ANY
    ALL
}

enum ExamStatus {
    DRAFT
    SCHEDULED
    IN_PROGRESS
    CLOSED
    RESULTS_PUBLISHED
    CANCELLED
}

enum ResultDecisionMethod {
    HIGHEST
    LATEST
    AVERAGE
    FIRST
    LOWEST
}

enum ExamMemberRole {
    CHAIR
    AUTHOR
    REVIEWER
}

enum ExamBlueprintVersionStatus {
    DRAFT
    PUBLISHED
    ARCHIVED
}

enum ExamBlueprintSlotType {
    FIXED
    SELECTION
}

enum ExamPaperStatus {
    DRAFT
    IN_REVIEW
    APPROVED
    LOCKED
}

enum ExamScheduleStatus {
    DRAFT
    PUBLISHED
    COMPLETED
    MOVED
    CANCELLED
    DELETED
}

enum ExamCandidateStatus {
    ASSIGNED
    ATTENDED
    ABSENT
    COMPLETED
    EXEMPTED
    CANCELLED
}

enum ExamSessionStatus {
    IN_PROGRESS
    SUBMITTED
    INTERRUPTED
    GRADING
    GRADED
    EXPIRED
    GRADING_FAILED
}
enum ExamSecurePoolStatus {
    SEALED
    RELEASED
}

enum ExamSecurePoolReleaseMode {
    MANUAL
    AUTO_AFTER_CLOSE
}

enum ExamRecordingStreamType {
    CAMERA
    SCREEN
}

type QuestionSelectionSpec {
    questionType: QuestionType
    difficulty: QuestionDifficulty
    targetBandLevel: String
    skillCode: String
    topicId: ID
}

type ExamMember {
    id: ID!
    userId: ID!
    role: ExamMemberRole!
    grantedAt: String
    grantedBy: ID
    user: User
}

type ExamSecurePool {
    id: ID!
    examId: ID!
    status: ExamSecurePoolStatus!
    releaseMode: ExamSecurePoolReleaseMode!
    embargoUntil: String
    releasedAt: String
    releasedBy: ID
}

type ExamPaperItem {
    id: ID!
    blueprintSlotId: ID
    sectionId: ID!
    paperId: ID!
    questionId: ID
    order: Int!
    weight: Float
    """
    Loại ô trong blueprint sinh ra câu này. null khi câu không sinh từ blueprint,
    hoặc khi slot tương ứng đã bị xoá — cả hai trường hợp đều được phép gán câu tự do.
    """
    slotType: ExamBlueprintSlotType
    """Tiêu chí rút câu của ô SELECTION; null với ô FIXED và câu không sinh từ blueprint."""
    selectionSpec: QuestionSelectionSpec
    question: Question
}

type ExamPaperSection {
    id: ID!
    paperId: ID!
    order: Int!
    title: String
    instruction: String
    weight: Float
    sectionTimeLimitSeconds: Int
    createdAt: String
    updatedAt: String
    createdBy: ID
    updatedBy: ID
    items: [ExamPaperItem!]!
}

type ExamPaper {
    id: ID!
    examId: ID!
    blueprintVersionId: ID
    code: String!
    variant: Int!
    status: ExamPaperStatus!
    timeDurationSeconds: Int
    createdAt: String
    updatedAt: String
    createdBy: ID
    updatedBy: ID
    sections: [ExamPaperSection!]!
}

type Exam {
    id: ID!
    blueprintId: ID
    blueprintVersionId: ID
    blueprint: ExamBlueprint
    blueprintVersion: ExamBlueprintVersion
    code: String!
    name: String!
    description: String
    schoolId: ID!
    languageId: ID!
    kind: ExamKind!
    deliveryMode: ExamDeliveryMode
    status: ExamStatus!
    maxAttempt: Int
    examTimeDurationSecond: Int
    resultDecisionMethod: ResultDecisionMethod
    openAt: String
    closeAt: String
    assessmentPolicyId: ID
    requiresOtp: Boolean!
    """Ngưỡng tin cậy AI (phần trăm 0-100). null = không đặt, hệ thống dùng luật cứng."""
    aiConfidenceThresholdPercent: Float
    requiredStreamType: ExamRequiredStreamType
    streamTypePermission: ExamStreamTypePermission
    papersLocked: Boolean
    createdAt: String
    updatedAt: String
    createdBy: ID
    updatedBy: ID
    members: [ExamMember!]!
    papers(status: ExamPaperStatus): [ExamPaper!]!
    # Ca thi của kỳ thi (đã loại ca xoá mềm), chạy qua DataLoader examSchedulesByExamId nên trang
    # danh sách kỳ thi dựng được thanh tiến độ "đã xếp lịch tới đâu" mà không N+1.
    schedules: [ExamSchedule!]!
    securePool: ExamSecurePool
    schoolClassId: ID
    candidateCount: Int!
}

type ExamStatusCounts {
    total: Int!
    draft: Int!
    scheduled: Int!
    inProgress: Int!
    closed: Int!
    resultsPublished: Int!
    cancelled: Int!
}

type ExamPage {
    content: [Exam!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type ExamBlueprintSlot {
    id: ID!
    sectionId: ID
    blueprintVersionId: ID!
    order: Int!
    weight: Float
    prepTimeSecondsOverride: Int
    responseTimeSecondsOverride: Int
    slotType: ExamBlueprintSlotType!
    fixedQuestionId: ID
    selectionSpec: QuestionSelectionSpec
    createdAt: String
    updatedAt: String
    createdBy: ID
    updatedBy: ID
    fixedQuestion: Question
}

type ExamBlueprintSection {
    id: ID!
    blueprintVersionId: ID!
    order: Int!
    title: String!
    instruction: String
    sectionTimeLimitSeconds: Int
    sectionWeight: Float
    createdAt: String
    updatedAt: String
    createdBy: ID
    updatedBy: ID
    slots: [ExamBlueprintSlot!]!
}

type ExamBlueprintVersion {
    id: ID!
    blueprintId: ID!
    version: Int!
    code: String!
    description: String
    status: ExamBlueprintVersionStatus!
    totalTimeLimitSeconds: Int
    effectiveFrom: String
    effectiveTo: String
    createdAt: String
    updatedAt: String
    createdBy: ID
    updatedBy: ID
    sections: [ExamBlueprintSection!]!
    sectionCount: Int!
    slotCount: Int!
    weightSum: Float!
}

type ExamBlueprint {
    id: ID!
    schoolId: ID!
    languageId: ID!
    gradeLevelId: ID
    code: String!
    name: String!
    description: String
    isActive: Boolean!
    createdAt: String
    updatedAt: String
    createdBy: ID
    updatedBy: ID
    versions(status: ExamBlueprintVersionStatus): [ExamBlueprintVersion!]!
    versionCount: Int!
    currentVersion: ExamBlueprintVersion
    sectionCount: Int!
}

type ExamBlueprintPage {
    content: [ExamBlueprint!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type ExamScheduleProctor {
    id: ID!
    scheduleId: ID!
    teacher: User
}

type ExamSchedule {
    id: ID!
    examId: ID!
    exam: Exam
    schoolRoomId: ID
    room: SchoolRoom
    startDate: String
    endDate: String
    status: ExamScheduleStatus!
    movedToScheduleId: ID
    proctors: [ExamScheduleProctor!]!
    candidateCount: Int!
    requiredProctorCount: Int!
}

# Một giáo viên đang vướng lịch: đã gác ca `scheduleId` chạy [startDate, endDate).
# Chỉ để làm mờ sẵn người bận ở màn chọn giám thị — luật chặn thật chạy lúc ghi.
type ProctorBusySlot {
    teacherId: ID!
    scheduleId: ID!
    startDate: String
    endDate: String
}

# Một học sinh đang vướng lịch khi cân nhắc xếp vào `targetScheduleId`: đã được xếp ca
# `busyScheduleId` chạy [startDate, endDate).
# Chỉ để làm mờ sẵn lựa chọn bị trùng ở màn xếp thí sinh — luật chặn thật chạy lúc ghi.
type StudentBusySlot {
    studentId: ID!
    targetScheduleId: ID!
    busyScheduleId: ID!
    startDate: String
    endDate: String
}

type ExamCandidate {
    id: ID!
    examId: ID!
    studentId: ID!
    latestSessionId: ID
    attempts: [ExamAttemptSummary!]!
    officialAttempt: ExamAttemptSummary
    officialScore: Float
    assignedPaperId: ID
    scheduleId: ID
    status: ExamCandidateStatus!
    assignedAt: String
    updatedAt: String
    blockedAt: String
    student: User
    assignedPaper: ExamPaper
    schedule: ExamSchedule
    exam: Exam
}

type ProctorScheduleSummary {
    scheduleId: ID!
    examId: ID!
    examName: String
    schoolRoomId: ID
    roomName: String
    startDate: String
    endDate: String
    status: String
}

"""
Một kỳ thi nhìn từ màn GIÁM SÁT. Cố ý nhỏ hơn `Exam`: giám thị cần đúng chừng này để nhận ra phòng
của mình, và không được thấy blueprint/chính sách chấm/ngưỡng AI mà `Exam` mang theo.
"""
type MonitoredExamSummary {
    examId: ID!
    code: String
    name: String
    kind: String
    status: String
    "Mốc bắt đầu sớm nhất trong các ca người xem giám sát được — KHÔNG phải openAt của kỳ thi."
    windowStart: String
    windowEnd: String
    "Số ca đang chạy ngay lúc này. 0 nghĩa là kỳ thi lọt vào danh sách vì sắp bắt đầu."
    liveScheduleCount: Int!
}

type ProctorCandidateSummary {
    candidateId: ID!
    studentId: ID!
    studentName: String
    studentEmail: String
    status: String
    blockedAt: String
    sessionId: ID
    sessionStatus: String
    sessionFlagged: Boolean!
}

type ExamAttemptSummary {
    sessionId: ID!
    startedAt: String
    submittedAt: String
    status: ExamSessionStatus!
    flagged: Boolean!
    flagReason: String
    totalScore: Float
    """
    Thang điểm của rubric đã chấm lượt này. Danh sách trộn nhiều kỳ thi, mỗi kỳ có thể
    dùng rubric khác thang -- client PHẢI đọc theo từng dòng, không suy từ cấu hình chung.
    Null khi chưa có kết quả hoặc điểm đang bị che.
    """
    scoringScaleMin: Float
    scoringScaleMax: Float
    rubricResultBandCode: String
    rubricResultBandName: String
    resultStatus: ExamCandidateResultStatus
}

enum ExamCandidateResultStatus {
    PENDING_REVIEW
    RELEASED
    APPEALED
    RE_GRADING
    FINAL
    INVALID
    RETAKE_REQUIRED
    PASSED
    FAILED
}

type ExamSession {
    id: ID!
    examId: ID!
    candidateId: ID!
    paperId: ID!
    startedAt: String
    submittedAt: String
    status: ExamSessionStatus!
    flagged: Boolean!
    flagReason: String
    candidateBlocked: Boolean!
}

type ExamSessionFollowup {
    examItemResponseId: ID!
    followupCount: Int!
    totalTurns: Int!
}

type ExamCandidateResultSection {
    sectionId: ID!
    title: String
    score: Float!
}

type ExamCandidateResultItem {
    paperItemId: ID!
    responseId: ID!
    sectionId: ID!
    "Đề bài của câu. Null khi paper item không trỏ tới câu hỏi nào hoặc câu hỏi đã bị xoá."
    questionText: String
    "Null khi câu chưa được chấm -- bài vẫn trả về câu để client hiện bản ghi bài nói."
    itemScore: Float
    "Null khi câu chưa được chấm."
    weightedScore: Float
}

type ExamCandidateResult {
    id: ID!
    sessionId: ID!
    examId: ID!
    paperId: ID!
    candidateId: ID!
    flagged: Boolean!
    flagReason: String
    scoreVisible: Boolean!
    totalScore: Float
    scoringScaleMin: Float
    scoringScaleMax: Float
    targetFrameworkBandId: ID
    targetFrameworkBandCode: String
    targetFrameworkBandLabel: String
    rubricResultBandId: ID
    rubricResultBandCode: String
    rubricResultBandName: String
    status: ExamCandidateResultStatus!
    sections: [ExamCandidateResultSection!]!
    items: [ExamCandidateResultItem!]!
}

type ExamItemResponseTurn {
    id: ID!
    examItemResponseId: ID!
    turnOrder: Int!
    turnType: String!
    promptText: String
    audioUrl: String
    transcript: String
    durationSeconds: Int
    wordCount: Int
    answeredAt: String
    createdAt: String
}

type ExamItemResponseDetails {
    id: ID!
    sessionId: ID!
    paperItemId: ID!
    audioUrl: String
    durationSeconds: Int
    transcript: String
    submittedAt: String
    turns: [ExamItemResponseTurn!]!
}

type ExamItemCriterionScore {
    id: ID!
    rubricCriterionId: ID
    criterionCode: String
    criterionName: String
    minScore: Float
    maxScore: Float
    rawScore: Float
    finalScore: Float
    rationale: String
}

type ExamItemEvaluationTurn {
    id: ID!
    turnOrder: Int
    turnType: String
    promptText: String
    audioUrl: String
    transcript: String
    wordCount: Int
    durationSeconds: Int
    asrConfidence: Float
    pronunciationOverall: String
    wordFeedback: String
}

"""
Bằng chứng của bản chấm AI, giữ lại kể cả khi giáo viên đã chấm lại (lúc đó bản AI mang
SUPERSEDED). Điểm và rationale hiển thị vẫn là của bản đang có hiệu lực ở cấp trên — khối
này chỉ là NGỮ CẢNH, không phải phán quyết. `null` khi bài chưa từng có bản AI.

Báo cáo phúc khảo `UNDER_REVIEW` (chưa công bố) không bao giờ lọt vào đây.
"""
type ExamItemAiEvaluationContext {
    evaluationId: ID!
    engineType: String
    gradedByModel: String
    promptVersion: String
    overallConfidence: Float
    requiresHumanReview: Boolean!
    reviewReasonCode: String
    markedInvalid: Boolean!
    requiresRetake: Boolean!
    evaluatedAt: String
    feedbackSummary: String
    "JSON string — EvaluationSignals"
    signals: String
    "JSON string — ValidityResult"
    validity: String
    "JSON string"
    suggestions: String
}

type ExamItemEvaluationDetails {
    "Null khi câu CHƯA có bản chấm nào -- lúc đó chỉ `turns` có dữ liệu, mọi field điểm đều trống."
    id: ID
    responseId: ID!
    paperItemId: ID!
    engineType: String
    gradedByModel: String
    promptVersion: String
    rawItemScore: Float
    itemScore: Float
    overallConfidence: Float
    markedInvalid: Boolean!
    requiresRetake: Boolean!
    requiresHumanReview: Boolean!
    reviewReasonCode: String
    status: String
    evaluatedAt: String
    feedbackSummary: String
    signals: String
    validity: String
    suggestions: String
    criteria: [ExamItemCriterionScore!]!
    "Luôn lấy từ bản AI — chỉ bản AI mới sinh lượt nói, bản chấm tay không có turn nào."
    turns: [ExamItemEvaluationTurn!]!
    ai: ExamItemAiEvaluationContext
}

type StudentExamResultSummary {
    candidateId: ID!
    examId: ID!
    examCode: String
    examName: String
    kind: ExamKind!
    sessionId: ID
    paperId: ID
    sessionStatus: String
    sessionFlagged: Boolean!
    startedAt: String
    submittedAt: String
    totalScore: Float
    """
    Thang điểm của rubric đã chấm lượt này. Danh sách trộn nhiều kỳ thi, mỗi kỳ có thể
    dùng rubric khác thang -- client PHẢI đọc theo từng dòng, không suy từ cấu hình chung.
    Null khi chưa có kết quả hoặc điểm đang bị che.
    """
    scoringScaleMin: Float
    scoringScaleMax: Float
    resultStatus: String
    rubricResultBandId: ID
    rubricResultBandCode: String
    rubricResultBandName: String
}
type ExamRecording {
    id: ID!
    examSessionId: ID!
    candidateId: ID
    streamType: String
    status: String
    sizeBytes: Int
    durationSeconds: Int
    source: String
    canonical: Boolean!
    createdAt: String
    assembledAt: String
}

"""
Bản ghi kèm LINK PHÁT được, dành cho màn chấm bài.

Tách khỏi `ExamRecording` thay vì thêm field vào đó: `records` là API của app giám thị trên
desktop (`ExamRecordingService`), chạy trong lúc thi và không cần link phát. Nhét thêm vào đó
nghĩa là mỗi lượt gọi của giám thị đều phải ký link cho mọi bản ghi, cho một thứ nó không dùng.
"""
type ExamRecordingPlayback {
    id: ID!
    streamType: String
    status: String
    source: String
    durationSeconds: Int
    """Bản nên mở trước cho streamType này khi có nhiều nguồn cùng ghi."""
    canonical: Boolean!
    """
    Link phát trực tiếp trong thẻ <video>, ký sẵn và HẾT HẠN sau 2 giờ.

    NULL khi bản ghi chưa có file trên S3 (đang PROCESSING, hoặc FAILED/ABANDONED) -- đó là
    trạng thái bình thường, không phải lỗi. Vì link có hạn, đừng lưu lại hay chia sẻ: hỏi lại
    query này mỗi lần mở trình phát.
    """
    playbackUrl: String
}

"""
Một đợt vi phạm được phát hiện trong lúc giám sát thi.

Là BẰNG CHỨNG để người chấm tự phán đoán, không phải một con số tham gia tính điểm. Cảnh báo là
phát hiện của AI kèm độ tin cậy, chạy trên webcam và có dương tính giả; còn điểm tiêu chí đo năng
lực ngôn ngữ. Cho cảnh báo kéo điểm xuống nghĩa là phạt nghi vấn gian lận bằng cách giả vờ rằng
học viên nói kém hơn thực tế. Cần cẩu đúng là quyết định uphold/regrade/invalidate và cờ nghi vấn
trên phiên thi.
"""
type ExamProctoringAlert {
    id: ID!
    """Định danh sự kiện gốc. Dùng để khử trùng khi gộp lịch sử này với luồng cảnh báo trực tiếp."""
    eventId: String!
    examSessionId: ID!
    """
    Thí sinh, nếu nguồn phát biết được.

    NULL là câu trả lời hợp lệ chứ không phải dữ liệu hỏng: đường AI nối thẳng chỉ cầm id phiên thi
    nên không có cách nào biết thí sinh nào. Để trống vẫn trung thực hơn là điền một id sai, vì id
    sai sẽ gắn vi phạm này sang hồ sơ của người khác.
    """
    candidateId: ID
    streamId: String
    streamType: String
    alertType: String!
    level: String
    source: String
    detail: String
    confidence: Float
    """
    Thời điểm SỰ VIỆC xảy ra, dạng ISO-8601 tuyệt đối -- KHÔNG phải mốc tua trong video.

    Quy về offset cần thời điểm bắt đầu của bản ghi, thứ hiện chưa được lưu ở đâu.
    """
    capturedAt: String!
    """Thời điểm cảnh báo được phát đi. Lệch với capturedAt chính là độ trễ của đường truyền."""
    raisedAt: String!
}

input UpdateExamScheduleInput {
    schoolRoomId: ID
    startDate: String
    endDate: String
}

"""
Cảnh báo (KHÔNG chặn) ước lượng worst-case chi phí AI + khả năng chi trả còn lại -- xem
ClassTestTokenQuotaGuardService.estimateTokenQuota. Việc CHẶN thật vẫn xảy ra lúc publish/sửa/thêm
thí sinh, không phải ở query này.

Mọi số đều là VND theo GIÁ VỐN, không cộng phí dịch vụ: phí đã thu một lần lúc trường đặt đơn, còn
ví hạn mức lẫn ví tự nạp đều ghi bằng giá vốn.
"""
type ExamTokenEstimate {
    estimatedCostVnd: Float!
    """
    Tiền trường CÒN CHI ĐƯỢC cho ví EXAM = hạn mức kèm gói còn lại + số dư ví tự nạp (phần không
    âm). Cộng cả số dư vì ConsumeQuotaService trừ phần vượt hạn mức sang ví tự nạp, nên một trường
    cạn hạn mức mà đã nạp tiền thì vẫn chi trả được. null nếu trường chưa có subscription active
    hoặc chưa cấu hình ví EXAM.
    """
    remainingExamVnd: Float
    """
    Hạn mức CÁ NHÂN còn lại của giáo viên ra đề -- KHÔNG phải một ví cấp trường thứ hai (ví
    CLASS_TEST đã bị bỏ, xem QuotaType), và KHÔNG cộng số dư ví trường vì đây là trần chi nội bộ
    chứ không phải túi tiền. null nếu bài không phải CLASS_TEST, hoặc giáo viên không được cấp hạn
    mức riêng nên chỉ tiền của trường áp dụng.
    """
    remainingMyClassTestVnd: Float
    wouldExceedExam: Boolean!
    wouldExceedMyClassTest: Boolean!
}

extend type Query {
    exams(
        kind: ExamKind,
        status: ExamStatus,
        schoolId: ID,
        keyword: String,
        page: Int = 0,
        size: Int = 20
    ): ExamPage!

    exam(id: ID!): Exam

    examMyRole(examId: ID!): String

    examPaper(id: ID!): ExamPaper

    "Cảnh báo (KHÔNG chặn) ước lượng worst-case chi phí AI + hạn mức còn lại -- xem lúc tạo/sửa bài trước khi publish"
    examTokenEstimate(examId: ID!): ExamTokenEstimate!

    examStatusCounts(schoolId: ID, kind: ExamKind, dateFrom: String, dateTo: String): ExamStatusCounts!

    classTests(
        status: ExamStatus,
        schoolClassId: ID,
        keyword: String,
        page: Int = 0,
        size: Int = 20
    ): ExamPage!

    examBlueprints(
        schoolId: ID,
        isActive: Boolean,
        languageId: ID,
        examKind: String,
        keyword: String,
        page: Int = 0,
        size: Int = 20
    ): ExamBlueprintPage!

    examBlueprint(id: ID!): ExamBlueprint
    examBlueprintVersion(id: ID!): ExamBlueprintVersion

    examSchedules(examId: ID, status: ExamScheduleStatus, startDate: String, endDate: String): [ExamSchedule!]!
    myExamSchedules(examId: ID, status: ExamScheduleStatus, startDate: String, endDate: String): [ExamSchedule!]!
    proctorBusySlots(scheduleId: ID!, teacherIds: [ID!]!): [ProctorBusySlot!]!
    studentBusySlots(scheduleIds: [ID!]!, studentIds: [ID!]!): [StudentBusySlot!]!

    examCandidates(examId: ID!, scheduleId: ID, status: ExamCandidateStatus): [ExamCandidate!]!

    examSession(id: ID!): ExamSession

    examSessionResult(sessionId: ID!): ExamCandidateResult

    examSessionFollowups(sessionId: ID!): [ExamSessionFollowup!]!

    myExamResults: [StudentExamResultSummary!]!

    myProctorSchedules: [ProctorScheduleSummary!]!

    """
    Kỳ thi đang diễn ra hoặc sắp diễn ra mà người đang đăng nhập giám sát được.

    Dùng thay cho `exams` ở màn giám sát. `exams` là đường vào của màn QUẢN LÝ kỳ thi, giới hạn
    theo thành viên hội đồng — mà hội đồng không bắt buộc, nên giám thị của một kỳ thi do nhà
    trường tự dựng sẽ không thấy phòng mình phải gác. Nới `exams` để chữa việc đó lại mở luôn
    dashboard kỳ thi cho giám thị, nên quyền giám sát tách hẳn ra đây.
    """
    monitorableExams: [MonitoredExamSummary!]!

    "Một kỳ thi đọc bằng quyền giám sát, cho phần đầu trang danh sách ca thi."
    monitorableExam(examId: ID!): MonitoredExamSummary

    myProctorScheduleCandidates(scheduleId: ID!): [ProctorCandidateSummary!]!

    """
    Lịch sử cảnh báo giám sát của cả ca thi, xếp theo thời gian xảy ra.

    Kênh cảnh báo trực tiếp là Redis pub/sub (fire-and-forget), nên nó chỉ kể được những gì xảy ra
    SAU khi giám thị kết nối. Query này là phần còn lại: vào ca muộn, tải lại trang, hay mở thêm một
    người giám sát thứ hai đều thấy đủ như nhau.
    """
    scheduleProctoringAlerts(scheduleId: ID!): [ExamProctoringAlert!]!

    examItemResponse(answerId: ID!): ExamItemResponseDetails

    examItemResponseTurns(answerId: ID!): [ExamItemResponseTurn!]!

    examItemResponseEvaluation(answerId: ID!): ExamItemEvaluationDetails
    # Đổi tên `records` -> `recordings` (2026-08-07). Resolver luôn tên `recordings`
    # (ExamSessionController#recordings), nên field `records` KHÔNG có ai phục vụ -- báo cáo
    # schema inspection lúc khởi động liệt kê nó ở "Unmapped fields", và gọi vào sẽ vỡ vì kiểu
    # trả về non-null. Không client nào đang gọi nên đổi tên field là an toàn.
    recordings(examSessionId: ID!, streamType: ExamRecordingStreamType): [ExamRecording!]!

    """
    Bản ghi camera + màn hình của một phiên thi, kèm link phát -- cho màn chấm bài và trang kết
    quả phía giáo viên. Cùng luật quyền với `records` (school admin, hoặc giáo viên là chủ tịch
    hội đồng / giám thị của đúng ca thi).
    """
    examRecordingPlayback(examSessionId: ID!): [ExamRecordingPlayback!]!

    """
    Cảnh báo giám sát của một phiên thi, xếp theo thời gian xảy ra.

    Cùng luật quyền với `examRecordingPlayback` (school admin, hoặc giáo viên là chủ tịch hội đồng /
    giám thị / người đang cầm bài): hai thứ này là cùng một loại bằng chứng về cùng một con người.
    """
    examSessionProctoringAlerts(examSessionId: ID!): [ExamProctoringAlert!]!
}

extend type Mutation {
    updateExamSchedule(id: ID!, input: UpdateExamScheduleInput!): ID!
    # Toggle: flagged=true đánh dấu nghi vấn (reason bắt buộc), flagged=false bỏ đánh dấu.
    flagExamSession(sessionId: ID!, flagged: Boolean!, reason: String): ID!
    forceEndExamSession(sessionId: ID!, reason: String!): ID!
    unblockExamCandidate(candidateId: ID!, reason: String!): ID!
    # reviewFlaggedExamResult / releasePendingExamResult đã bị gỡ: người quyết là GIÁO VIÊN
    # ĐANG CẦM BÀI, qua REST /api/v1/grading-assignments/{id}/uphold | /regrade | /invalidate.
    # Chỉ áp dụng khi kết quả đang FINAL (kỳ thi đã RESULTS_PUBLISHED nhưng assessmentPolicy
    # không có passingScore) -- nhà trường tự chốt PASSED hoặc FAILED thủ công.
    decideExamCandidateResultOutcome(candidateResultId: ID!, decision: ExamCandidateResultStatus!): ID!
    retryGradingExamSession(sessionId: ID!): ID!
    # TEST-ONLY: chấm lại 1 phiên thi bằng AI bất kể trạng thái (kể cả đã GRADED) -- re-publish
    # grading request từ dữ liệu làm bài đã lưu, evaluation cũ bị ghi đè (upsert). Dùng để kiểm
    # thử pipeline chấm điểm, không phải luồng nghiệp vụ chính thức.
    regradeExamSessionForTest(sessionId: ID!): ID!
    updateExamCandidateStatus(candidateId: ID!, status: ExamCandidateStatus!): ID!
    updateExamCandidatesAttendance(scheduleId: ID!, candidateIds: [ID!]!): [ExamCandidate!]!
}