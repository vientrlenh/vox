enum FrameworkVersionStatus { 
    DRAFT 
    PUBLISHED 
    ARCHIVED 
}

enum SignalImportance { 
    HIGH 
    MEDIUM 
    LOW 
}

type Framework {
    id: ID!
    code: String!
    name: String!
    description: String
    isActive: Boolean!
    createdAt: String
    updatedAt: String
}

type FrameworkPage {
    content: [Framework!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type FrameworkVersion {
    id: ID!
    frameworkId: ID!
    code: String!
    name: String!
    description: String
    version: Int!
    effectiveFrom: String!
    effectiveTo: String
    status: FrameworkVersionStatus!
    createdAt: String
    updatedAt: String
    criteria: [FrameworkCriterion!]!
    resultBands: [FrameworkResultBand!]!
}

type FrameworkVersionPage {
    content: [FrameworkVersion!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type FrameworkCriterion {
    id: ID!
    frameworkVersionId: ID!
    code: String!
    name: String!
    description: String
    order: Int!
    bands: [FrameworkCriterionBand!]!
}

type FrameworkCriterionBand {
    id: ID!
    frameworkCriterionId: ID!
    frameworkResultBandId: ID!
    descriptor: String
    positiveSignals: FrameworkCriterionSignals
    negativeSignals: FrameworkCriterionSignals
}

type FrameworkCriterionSignals {
    values: [Signal!]!
}

type Signal {
    code: String!
    description: String!
    importance: SignalImportance!
    evidenceHint: String
}

type FrameworkResultBand {
    id: ID!
    frameworkVersionId: ID!
    code: String!
    label: String!
    description: String
    order: Int!
}

input UpdateFrameworkVersionInput {
    code: String!
    name: String!
    description: String
    effectiveFrom: String!
    effectiveTo: String
}

input UpdateFrameworkCriterionInput {
    code: String!
    name: String!
    description: String
    order: Int!
}

input UpdateFrameworkCriterionBandInput {
    descriptor: String
    positiveSignals: [SignalInput!]
    negativeSignals: [SignalInput!]
}

input SignalInput {
    code: String!
    description: String!
    importance: SignalImportance!
    evidenceHint: String
}

input UpdateFrameworkResultBandInput {
    code: String!
    label: String!
    description: String
    order: Int!
}

extend type Query {
    frameworks(page: Int = 1, size: Int = 20, search: String, isActive: Boolean): FrameworkPage!
    framework(id: ID!): Framework
    frameworkVersions(frameworkId: ID!, page: Int = 1, size: Int = 20): FrameworkVersionPage!
    frameworkVersion(id: ID!): FrameworkVersion
    # Query gốc lấy FrameworkCriterion (System Admin, không giới hạn trạng thái Version)
    frameworkCriteria(frameworkVersionId: ID!): [FrameworkCriterion!]!
    frameworkCriterion(id: ID!): FrameworkCriterion
    schoolFrameworks(page: Int = 1, size: Int = 20): FrameworkPage!
    schoolFrameworkVersions(frameworkId: ID!, page: Int = 1, size: Int = 20): FrameworkVersionPage!
    schoolFrameworkVersion(id: ID!): FrameworkVersion
    # Query gốc lấy FrameworkCriterion (School Admin, chỉ Version đã PUBLISHED)
    schoolFrameworkCriteria(frameworkVersionId: ID!): [FrameworkCriterion!]!
    schoolFrameworkCriterion(id: ID!): FrameworkCriterion
}

extend type Mutation {
    updateFrameworkVersion(frameworkId: ID!, versionId: ID!, input: UpdateFrameworkVersionInput!): ID!
    updateFrameworkCriterion(frameworkId: ID!, versionId: ID!, criterionId: ID!, input: UpdateFrameworkCriterionInput!): ID!
    updateFrameworkCriterionBand(frameworkId: ID!, versionId: ID!, criterionId: ID!, bandId: ID!, input: UpdateFrameworkCriterionBandInput!): ID!
    updateFrameworkResultBand(frameworkId: ID!, versionId: ID!, bandId: ID!, input: UpdateFrameworkResultBandInput!): ID!
}
