enum ImportType {
    USER
    SCHOOL_CLASS
    QUESTION
    SCHOOL_CLASS_USER
    SCHOOL_DIRECTORY
    SCHOOL_GRADE
    SCHOOL_ROOM
    RUBRIC_VERSION
    RUBRIC_CRITERION
    RUBRIC_RESULT_BAND
    ASSESSMENT_POLICY
    QUESTION_BANK
    QUESTION_TOPIC
}

enum ImportSessionStatus {
    PREVIEWED
    VALIDATING
    IMPORTING
    QUEUED
    COMPLETED
    FAILED
    EXPIRED
    CANCELLED
}

enum ImportRowStatus {
    PENDING
    VALID
    INVALID
    IMPORTED
    SKIPPED
    FAILED
}

type ImportMappingEntry {
    originalHeader: String!
    systemField: String!
}

type ImportDataEntry {
    key: String!
    value: String
}

type ImportRowError {
    field: String
    message: String!
}

type ImportSession {
    id: ID!
    # A system-wide import session (created by a System Admin) belongs to no school, so
    # schoolId must be nullable - declaring it as ID! would let null-bubbling turn the whole
    # ImportSession into null.
    schoolId: ID
    type: ImportType!
    fileName: String!
    originalHeaders: [String!]!
    suggestedMapping: [ImportMappingEntry!]!
    confirmedMapping: [ImportMappingEntry!]!
    validRows: Int!
    invalidRows: Int!
    importedRows: Int!
    skippedRows: Int!
    totalRows: Int!
    failureReason: String
    status: ImportSessionStatus!
    importedEntityId: ID
    expiresAt: DateTime
    createdAt: DateTime
    updatedAt: DateTime
}

type ImportSessionSummary {
    id: ID!
    schoolId: ID
    type: ImportType!
    fileName: String!
    totalRows: Int!
    validRows: Int!
    invalidRows: Int!
    importedRows: Int!
    skippedRows: Int!
    status: ImportSessionStatus!
    expiresAt: DateTime
    createdAt: DateTime
    updatedAt: DateTime
}

type ImportSessionPage {
    content: [ImportSessionSummary!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type ImportRow {
    id: ID!
    sessionId: ID!
    rowNumber: Int!
    rawData: [ImportDataEntry!]!
    mappedData: [ImportDataEntry!]!
    errors: [ImportRowError!]!
    status: ImportRowStatus!
}

type ImportRowPage {
    content: [ImportRow!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

extend type Query {
    importSession(id: ID!): ImportSession
    importSessions(page: Int = 1, size: Int = 20, type: ImportType, status: ImportSessionStatus): ImportSessionPage!
    importRows(sessionId: ID!, page: Int = 1, size: Int = 20, status: ImportRowStatus): ImportRowPage!
}
