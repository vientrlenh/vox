# ==================================================================
# Classes of a teacher (read-only)
#
# The types below are only produced by the three TEACHER-gated root queries at the end of
# this file, and no other type points to them. That way they do not inherit the field
# resolvers of `SchoolClass` / `SchoolClassUser` (which are gated at SCHOOL_ADMIN and
# reachable from many other branches of the graph).
# ==================================================================

type MyClass {
    id: ID!
    schoolId: ID!
    languageId: ID!
    schoolGradeId: ID!
    code: String!
    name: String!
    description: String
    status: SchoolClassStatus!
    createdAt: DateTime
    updatedAt: DateTime
    schoolGrade: SchoolGrade
    language: SupportedLanguage
    activeMemberCount: Int!
}

type MyClassPage {
    content: [MyClass!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type MyClassMember {
    id: ID!
    userId: ID!
    schoolClassId: ID!
    isActive: Boolean!
    joinedAt: DateTime
    leftAt: DateTime
    user: MyClassMemberUser
}

# roleCodes is deliberately exposed as scalars instead of nesting the `Role` type: this keeps
# MyClassMember a leaf branch and opens no additional edge in the graph for the TEACHER role.
type MyClassMemberUser {
    id: ID!
    fullName: String
    email: String
    phone: String
    roleCodes: [String!]!
}

type MyClassMemberPage {
    content: [MyClassMember!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

extend type Query {
    myClasses(schoolId: ID!, search: String, status: SchoolClassStatus, page: Int! = 1, size: Int! = 10): MyClassPage!
    myClass(id: ID!): MyClass
    myClassMembers(schoolClassId: ID!, roleCode: String, search: String, page: Int! = 1, size: Int! = 20): MyClassMemberPage!
}
