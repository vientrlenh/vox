type Notification {
    id: ID!
    userId: ID!
    eventId: ID
    eventType: String
    title: String
    body: String
    payload: String
    readAt: String
    createdAt: String
}

type NotificationDevice {
    id: ID!
    userId: ID!
    deviceId: ID!
    platform: String
    installationId: String
    createdAt: String
    lastSeenAt: String
}


type NotificationPreference {
    id: ID!
    userId: ID!
    category: String
    pushEnabled: Boolean
}

type NotificationCursorPage {
    content: [Notification!]!
    nextCursor: ID
    hasNext: Boolean
}

extend type Query {
    myNotifications(cursor: ID, limit: Int! = 20): NotificationCursorPage
    myUnreadNotificationCount: Int!
    "Một thông báo của chính người đang đăng nhập. Dùng cho luồng mở từ thông báo đẩy, nơi client chỉ cầm mỗi id."
    myNotification(id: ID!): Notification
}
