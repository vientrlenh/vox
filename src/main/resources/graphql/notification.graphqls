enum NotificationDevicePlatform {
    WEB
    ANDROID
    IOS
}

enum NotificationCategory {
    ASSESSMENT_RESULT
    ASSESSMENT_APPEAL
    GRADING
    ASSESSMENT_SCHEDULE
    ASSESSMENT_BLUEPRINT
    BILLING
    SYSTEM
}

type Notification {
    id: ID!
    userId: ID!
    eventId: ID
    eventType: String
    title: String
    body: String
    payload: String
    readAt: DateTime
    createdAt: DateTime
}

type NotificationDevice {
    id: ID!
    userId: ID!
    deviceId: ID!
    platform: NotificationDevicePlatform
    installationId: String
    createdAt: DateTime
    lastSeenAt: DateTime
}


type NotificationPreference {
    id: ID!
    userId: ID!
    category: NotificationCategory
    pushEnabled: Boolean
}

type NotificationCursorPage {
    content: [Notification!]!
    nextCursor: ID
    hasNext: Boolean
}

extend type Query {
    myNotifications(cursor: ID, limit: Int! = 20): NotificationCursorPage
    myUnreadNotificationCount: Int!
    "One notification of the signed-in user. Used by the push-notification flow, where the client only holds the id."
    myNotification(id: ID!): Notification
}
