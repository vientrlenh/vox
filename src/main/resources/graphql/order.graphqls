type Order {
    id: ID! 
    schoolId: ID 
    type: OrderType!
    description: String 
    subtotalAmountVnd: Float 
    totalAmountVnd: Float 
    chargedFeeVnd: Float 
    discountAmountVnd: Float 
    status: OrderStatus
    createdAt: DateTime
    updatedAt: DateTime
    """
    The payment deadline, fixed when the order is created. The frontend uses it to count down for a
    PENDING order -- do NOT compute it from updatedAt + a constant: updatedAt changes when an admin
    edits a note, and this is also the deadline that was sent to the gateway.
    """
    expiresAt: DateTime
    "Empty for a TOPUP order -- a top-up buys no item to list."
    items: [OrderItem!]
}

type OrderItem {
    id: ID! 
    orderId: ID! 
    type: OrderItemType 
    itemId: ID! 
    unitPriceVnd: Float 
    amountVnd: Float 
    quantity: Int
}

type OrderPage {
    content: [Order!]!
    page: Int! 
    size: Int!
    totalElements: Int! 
    totalPages: Int!
}

enum OrderType {
    SUBSCRIPTION_REQUEST
    "An order from a school that is currently on a DIFFERENT plan. Renewing the same old plan is still SUBSCRIPTION_REQUEST."
    SUBSCRIPTION_UPGRADE
    TOPUP
}

enum OrderItemType {
    SUBSCRIPTION
}

enum OrderStatus {
    PENDING
    SUCCESS
    FAILED
    CANCELLED
    EXPIRED
}

extend type Query {
    """
    The order history of the school the caller belongs to (SCHOOL_ADMIN). It takes no schoolId -- it comes from the token.

    It INCLUDES PENDING orders, and that is mandatory, not a display choice: placing a new
    subscription order is rejected while the school still has a pending one, so hiding the pending
    order amounts to telling the school to cancel something they cannot see.
    """
    myOrders(page: Int! = 1, size: Int! = 20): OrderPage!

    "Orders across the whole system (SYSTEM_ADMIN). A filter that is left empty does not filter by that criterion."
    orders(
        schoolId: ID,
        status: OrderStatus,
        type: OrderType,
        "Search by SCHOOL NAME."
        keyword: String,
        page: Int! = 1,
        size: Int! = 20
    ): OrderPage!

    order(id: ID!): Order
}

