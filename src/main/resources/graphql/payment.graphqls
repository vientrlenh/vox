"""
ONE payment ATTEMPT of an order, not the lifecycle of the order.

An order can have several rows -- a failed payment followed by a retry is two different attempts --
but at most one PAID row and at most one PENDING row. Failed attempts are INTENTIONALLY not filtered
out: when a school asks "why was I charged only once when I pressed pay twice", this list is the
answer.
"""
type Payment {
    id: ID!
    orderId: ID!
    amountVnd: Float!
    "E_BANKING or CARD. Every order currently goes through the third-party gateway, so it is always E_BANKING."
    method: PaymentMethod
    provider: PaymentProvider
    "The lifecycle of THIS attempt. The reason why no money came in lives on Order.status."
    status: PaymentStatus!
    """
    The transaction code on the gateway side. Exposed so that the school and support can look up the
    same transaction on the PayOS/SePay dashboard when the money has moved but the order has not
    received it.
    """
    providerOrderRef: String
    """
    The payment link, ONLY present on an attempt that is still PENDING -- the session of a settled
    attempt is already closed on the gateway side. The frontend uses exactly this field for the
    "continue paying" button instead of calling the link-creation API again, because every newly
    issued link is a new order code on the gateway side.
    """
    checkoutUrl: String
    "The moment the GATEWAY recorded the money, different from createdAt (when we issued the link). Null while the attempt has not brought in money."
    paidAt: DateTime
    createdAt: DateTime
}

enum PaymentStatus {
    PENDING
    PAID
    FAILED
}

enum PaymentMethod {
    E_BANKING
    CARD
}

enum PaymentProvider {
    PAYOS
    SEPAY
}

# See the note in invoice.graphqls about why this uses extend.
extend type Order {
    "The payment attempts, NEWEST FIRST. Empty when the school has never pressed pay."
    payments: [Payment!]
}
