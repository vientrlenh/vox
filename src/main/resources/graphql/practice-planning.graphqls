    extend type Query {
    practiceTopicOffers(excludeTopicIds: [ID!], round: Int = 1, bucket: TopicOfferBucket = FOR_YOU): [PracticeTopicOffer!]!
    searchPracticeTopics(keyword: String!): TopicSearchResult!

    """
    Find topics by MEANING (vector). Complements `searchPracticeTopics`, does not replace it.

    Returns empty when the AI service is not available -- the client must tolerate that and still show the results
    of `searchPracticeTopics`. `matchPercent` here is semantic similarity, used to show the
    "close in meaning" label.
    """
    searchPracticeTopicsSemantic(keyword: String!): [PracticeTopicOffer!]!
    mySavedTopics: [PracticeTopicOffer!]!
    myPracticeDashboardStats: PracticeDashboardStats!
    "Polls the paper-building result started by buildPracticePaper (see PracticePaperDraft)."
    practicePaperDraft(draftId: ID!): PracticePaperDraft!
}

extend type Mutation {
    """
    Starts building the paper. Returns IMMEDIATELY: if the question bank already has suitable questions then
    status=READY with the paper included; if the AI has to generate new questions (slow) then
    status=PREPARING and the client polls with practicePaperDraft(draftId).
    """
    buildPracticePaper(input: StartPracticeSessionInput!): PracticePaperDraft!
    pickRandomTopic: PracticeTopicOffer!
    saveTopic(topicId: ID!): Boolean!
    unsaveTopic(topicId: ID!): Boolean!
    """
    The student dismisses a topic card that is being offered ("I don't like this").

    Records a negative interest signal of 0.15 -- exactly the level of "abandoned out of boredom" -- then recomputes the interest
    score immediately. Different from `excludeTopicIds` of practiceTopicOffers: that only hides the card in the current
    browsing round, while this TEACHES the system so it takes effect on every later open.
    """
    dismissTopicOffer(topicId: ID!): Boolean!
}

type PracticePaperDraft {
    draftId: ID!
    status: PracticePaperDraftStatus!
    "Only present when status=FAILED -- a readable message to show directly to the student."
    reason: String
    "Only present when status=READY."
    paper: PracticePaper
    "Only present when status=FAILED. A machine-readable error code (e.g. BUSINESS_RULE_VIOLATION) so the client can tell a transient error from a business error that is not worth retrying."
    errorCode: String
}

enum PracticePaperDraftStatus {
    PREPARING
    READY
    FAILED
}

input StartPracticeSessionInput {
    topicId: ID!
    """
    The level the student CHOOSES for this session, taken from the level scale of the framework in effect. Previously the system
    inferred the level from graded work + recent performance; now it is the learner's choice, and the level
    only means "the difficulty I want today", not a statement about proficiency.
    """
    targetFrameworkBandId: ID!
    origin: String!
    fromSubAttribute: String
    offeredTopicIds: [ID!]
    previousOfferedTopicIds: [ID!]
}

type PracticeTopicOffer {
    topicId: ID!
    name: String!
    dimension: String!
    savedByMe: Boolean!
    matchPercent: Int
    minutes: Int!
    rationale: String
    reasons: [String!]!
}

"""
Only one basket remains. BY_GOAL and BY_WEAKNESS were removed together with the weakness profile: topic ranking is now based
entirely on interests, remaining question stock and curriculum match.

The enum is kept (instead of dropping the parameter) so old clients sending `bucket: FOR_YOU` do not get a schema error.
"""
enum TopicOfferBucket {
    FOR_YOU
}

type PracticeDashboardStats {
    sessionsDone: Int!
    averageScore: Float!
    streakDays: Int!
}

type TopicSearchResult {
    topics: [PracticeTopicOffer!]!
    canGenerate: Boolean!
}

type PracticePaper {
    id: ID!
    topicId: ID!
    origin: String!
    plannedSeconds: Int!
    reservedQuotaSeconds: Int!
    "Speaking ceiling for the whole session (seconds): the narrower of the plan quota and the level ceiling. Different from plannedSeconds above -- that one is the total planned for the questions in THIS paper."
    sessionBudgetSeconds: Int!
    questions: [PracticePaperQuestion!]!
}

type PracticePaperQuestion {
    questionId: ID!
    slot: Int!
    questionText: String!
    criterionCode: String!
    subAttribute: String
    difficultyRank: Int!
    maxResponseSeconds: Int!
    minResponseSeconds: Int!
    suggestedIdeas: [String!]!
}
