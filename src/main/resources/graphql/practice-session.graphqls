extend type Query {
    practiceSession(sessionId: ID!): PracticeSession
    myPracticeHistory(limit: Int = 20): [PracticeSession!]!
    "Học sinh xem lại bài của CHÍNH MÌNH. Cùng nội dung với studentPracticeSessionDetail nhưng khác quyền -- bên kia dành cho giáo viên xem bài học sinh mình dạy."
    myPracticeSessionDetail(sessionId: ID!): TeacherPracticeSessionDetail!
    studentPracticeSessionDetail(sessionId: ID!): TeacherPracticeSessionDetail!
}

extend type Mutation {
    startPracticeSession(paperId: ID!): PracticeSession!
    submitPracticeTurn(input: SubmitPracticeTurnInput!): SubmitTurnResult!
    heartbeatPracticeSession(sessionId: ID!): Boolean!
    endPracticeSession(input: EndPracticeSessionInput!): PracticeSession!
}

input TurnCorrectionInput {
    category: String!
    originalText: String!
    correctedText: String!
    explanation: String!
    correctAudioUrl: String
    confidence: Float!
}

input SubmitPracticeTurnInput {
    sessionId: ID!
    questionId: ID!
    turnOrder: Int!
    turnType: String!
    promptText: String
    audioUrl: String!
    transcript: String!
    durationSeconds: Int!
    wordFeedbackJson: String
    turnScore: Float
    questionComplete: Boolean!
    corrections: [TurnCorrectionInput!]
}

input EndPracticeSessionInput {
    sessionId: ID!
    helpRequestCount: Int!
    longPauseCount: Int!
}

type PracticeSession {
    id: ID!
    paperId: ID!
    topicId: ID!
    topicName: String!
    origin: String!
    status: String!
    abandonDiagnosis: String
    overallScore: Float
    gradedSeconds: Int!
    startedAt: String!
    endedAt: String
}

type TurnCorrection {
    category: String!
    originalText: String!
    correctedText: String!
    explanation: String!
    correctAudioUrl: String
}

type SubmitTurnResult {
    responseId: ID!
    turnId: ID!
    remainingGradedSeconds: Int!
    evaluationQueued: Boolean!
    corrections: [TurnCorrection!]!
    "Lượt này tiêu nốt hạn mức còn lại -- lượt VẪN được ghi và chấm, nhưng phiên phải đóng sau khi trả kết quả."
    quotaExhausted: Boolean!
    "Tổng số giây học sinh ĐÃ NÓI trong phiên, đã tính cả lượt này. Chỉ đếm khoảng VAD nghe thấy tiếng -- lúc AI nói hay học sinh nghĩ đều không tính."
    sessionSpokenSeconds: Int!
    "Trần nói của cả phiên (giây), cùng con số với PracticePaper.sessionBudgetSeconds."
    sessionBudgetSeconds: Int!
}

type CriterionScore {
    criterionCode: String!
    score: Float
    matchedBandCode: String
}

type TeacherPracticeTurnView {
    turnOrder: Int!
    transcript: String!
    audioUrl: String!
    wordFeedbackJson: String
    turnScore: Float
    corrections: [TurnCorrection!]!
}

type TeacherPracticeSessionDetail {
    sessionId: ID!
    topicName: String!
    startedAt: String!
    durationSeconds: Int!
    itemCount: Int!
    overallScore: Float
    criterionScores: [CriterionScore!]!
    completed: Boolean!
    "Số câu đã nói nhưng chưa có bản chấm. > 0 nghĩa là kết quả còn đang được tổng hợp -- màn tổng kết dựa vào đây để biết nên chờ hay nên hiện luôn."
    pendingEvaluationCount: Int!
    "Trung bình độ khó (difficulty_rank) các câu đã trả lời. Điểm một mình không đọc được: nó neo vào bậc mục tiêu còn độ khó câu lại bám theo bậc hiện tại của học sinh."
    difficultyRank: Float
    turns: [TeacherPracticeTurnView!]!
}
