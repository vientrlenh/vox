extend type Query {
    myPracticeHistory(limit: Int = 20): [PracticeSession!]!
    "A student reviews their OWN work. Same content as studentPracticeSessionDetail but with different permissions -- the other one is for a teacher to view the work of the students they teach."
    myPracticeSessionDetail(sessionId: ID!): TeacherPracticeSessionDetail!
    studentPracticeSessionDetail(sessionId: ID!): TeacherPracticeSessionDetail!
}

extend type Mutation {
    startPracticeSession(paperId: ID!): PracticeSession!
    endPracticeSession(input: EndPracticeSessionInput!): PracticeSession!
}

input EndPracticeSessionInput {
    sessionId: ID!
    helpRequestCount: Int!
    longPauseCount: Int!
}

type PracticeSession {
    id: ID!
    paperId: ID!
    topicId: ID!
    topicName: String!
    origin: String!
    status: String!
    abandonDiagnosis: String
    overallScore: Float
    gradedSeconds: Int!
    startedAt: DateTime!
    endedAt: DateTime
    """Number of answers spoken but not graded yet. > 0 means overallScore is still PROVISIONAL."""
    pendingEvaluations: Int!
}

type TurnCorrection {
    category: String!
    originalText: String!
    correctedText: String!
    explanation: String!
    correctAudioUrl: String
}

type CriterionScore {
    criterionCode: String!
    score: Float
}

type TeacherPracticeTurnView {
    turnOrder: Int!
    transcript: String!
    audioUrl: String!
    wordFeedbackJson: String
    turnScore: Float
    corrections: [TurnCorrection!]!
}

type TeacherPracticeSessionDetail {
    sessionId: ID!
    topicName: String!
    startedAt: DateTime!
    durationSeconds: Int!
    itemCount: Int!
    overallScore: Float
    criterionScores: [CriterionScore!]!
    completed: Boolean!
    "Number of answers spoken but without a grading yet. > 0 means the result is still being compiled -- the summary screen relies on this to decide whether to wait or show it right away."
    pendingEvaluationCount: Int!
    """Number of answers whose grading failed and whose attempts are used up -- they will NEVER get a score, so do not wait any longer."""
    gradingGaveUpCount: Int!
    "The scoring scale of THIS session itself: 0-100 for sessions from V13 (practice does not use a rubric), or the scale of the applied rubric for older sessions. The client must read this field instead of hard-coding the denominator -- both kinds of session will coexist for a long time."
    scoreScaleMin: Float!
    scoreScaleMax: Float!
    "Average difficulty (difficulty_rank) of the answered questions. The score alone cannot be interpreted: it is anchored to the target band while the question difficulty follows the student's current band."
    difficultyRank: Float
    turns: [TeacherPracticeTurnView!]!
}
