extend type Query {
    myWeaknessProfile: WeaknessProfile!
    myLearnerProfile: LearnerProfile
    interestQuizItems: [InterestQuizItem!]!
    "Thang bậc của khung đang áp cho học sinh -- nguồn cho ô chọn độ khó trước mỗi phiên."
    myPracticeBandOptions: [PracticeBandOption!]!
}

extend type Mutation {
    submitInterestQuiz(input: SubmitInterestQuizInput!): LearnerProfile!
    submitFlsaSelfReport(answers: [Int!]!): LearnerProfile!
    setPracticeGoal(goalType: PracticeGoalType!): LearnerProfile!
}

"""
Chỉ còn mức TIÊU CHÍ. Nhãn lỗi chi tiết (sub-attribute) vẫn được đo và vẫn dùng để chọn
tiêu chí/nhãn khi sinh câu hỏi, chỉ là không phơi ra màn hình nữa -- trang hồ sơ điểm yếu
đã bỏ.
"""
type WeaknessProfile {
    criteria: [CriterionWeakness!]!
    sessionsAnalysed: Int!
}

type CriterionWeakness {
    criterionCode: String!
    criterionName: String!
    weakness: Float!
    observationCount: Int!
    reliable: Boolean!
}

enum PracticeGoalType {
    EXAM_PREP
    ABILITY_IMPROVEMENT
}

input InterestQuizAnswerInput {
    itemId: ID!
    mostStatementIndex: Int!
    leastStatementIndex: Int!
}

input SubmitInterestQuizInput {
    answers: [InterestQuizAnswerInput!]!
}

type InterestQuizItem {
    id: ID!
    statements: [String!]!
}

type LearnerProfile {
    goalType: PracticeGoalType!
    flsaScore: Float
    "Bậc mục tiêu của chính sách chấm -- dùng làm bậc chọn sẵn ở màn hình chọn độ khó."
    targetFrameworkBandCode: String!
    targetFrameworkBandLabel: String!
    quizCompletedAt: String
}

"""
Một bậc trên thang của khung đang áp, để học sinh chọn độ khó trước khi vào phiên.
Không có bậc nào được đánh dấu là "bậc của em" -- hệ thống không xếp bậc năng lực,
chỉ ghi lại độ khó em chọn cho từng phiên.
"""
type PracticeBandOption {
    id: ID!
    code: String!
    label: String!
    description: String
    order: Int!
}
