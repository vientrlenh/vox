extend type Query {
    myLearnerProfile: LearnerProfile
    interestQuizItems: [InterestQuizItem!]!
    "Các khung đánh giá còn hiệu lực, mỗi khung là bản đã ban hành mới nhất -- ô chọn khung đứng TRƯỚC ô chọn bậc."
    myPracticeFrameworkOptions: [PracticeFrameworkOption!]!
    """
    Thang bậc để chọn độ khó trước mỗi phiên.

    frameworkVersionId: khung vừa chọn ở ô phía trên. Bỏ trống thì lấy khung đang hiệu lực
    toàn hệ, giữ nguyên hành vi cho client cũ.
    """
    myPracticeBandOptions(frameworkVersionId: ID): [PracticeBandOption!]!
}

extend type Mutation {
    submitInterestQuiz(input: SubmitInterestQuizInput!): LearnerProfile!
    setPracticeGoal(goalType: PracticeGoalType!): LearnerProfile!
    """
    Làm lại quiz sở thích.

    Bộ cũ chưa nộp xong thì trả lại đúng bộ đó để làm tiếp -- KHÔNG sinh mới, tránh vứt phần
    em ấy đã làm. Nộp xong rồi mới tắt bộ cũ và sinh bộ mới.
    """
    regenerateInterestQuiz: [InterestQuizItem!]!
}

enum PracticeGoalType {
    EXAM_PREP
    ABILITY_IMPROVEMENT
}

input InterestQuizAnswerInput {
    itemId: ID!
    mostStatementIndex: Int!
    leastStatementIndex: Int!
}

input SubmitInterestQuizInput {
    answers: [InterestQuizAnswerInput!]!
}

type InterestQuizItem {
    id: ID!
    statements: [String!]!
}

type LearnerProfile {
    goalType: PracticeGoalType!
    """
    Bậc mục tiêu của chính sách chấm -- dùng làm bậc chọn sẵn ở màn hình chọn độ khó.

    NULL khi trường chưa có chính sách nào phủ tới lớp của học sinh. Trước đây trường hợp này
    ném lỗi, làm hỏng cả những thao tác GHI trả về kiểu này (nộp quiz, đặt mục tiêu) -- xem chú
    thích ở JpaLearnerProfileQueryRepository.findCurrent. Client tự chọn bậc mặc định khi thiếu.
    """
    targetFrameworkBandCode: String
    targetFrameworkBandLabel: String
    quizCompletedAt: String
}

"""
Một bậc trên thang của khung đang áp, để học sinh chọn độ khó trước khi vào phiên.
Không có bậc nào được đánh dấu là "bậc của em" -- hệ thống không xếp bậc năng lực,
chỉ ghi lại độ khó em chọn cho từng phiên.
"""
type PracticeBandOption {
    id: ID!
    code: String!
    label: String!
    description: String
    order: Int!
}

"""
Một khung đánh giá học sinh có thể chọn. versionId là bản đã ban hành mới nhất của khung, do
server tự chọn -- học sinh không phải biết tới khái niệm phiên bản.
"""
type PracticeFrameworkOption {
    versionId: ID!
    code: String!
    name: String!
    description: String
    bandCount: Int!
}
