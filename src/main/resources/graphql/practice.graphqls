extend type Query {
    myLearnerProfile: LearnerProfile
    interestQuizItems: [InterestQuizItem!]!
    "Assessment frameworks currently in effect, each one being its latest published version -- the framework selector comes BEFORE the band selector."
    myPracticeFrameworkOptions: [PracticeFrameworkOption!]!
    """
    The band scale for choosing the difficulty before each session.

    frameworkVersionId: the framework just chosen in the selector above. When omitted, the
    system-wide framework in effect is used, which keeps the behavior for older clients.
    """
    myPracticeBandOptions(frameworkVersionId: ID): [PracticeBandOption!]!
}

extend type Mutation {
    submitInterestQuiz(input: SubmitInterestQuizInput!): LearnerProfile!
    setPracticeGoal(goalType: PracticeGoalType!): LearnerProfile!
    """
    Redo the interest quiz.

    While the old set is not yet submitted, that same set is returned to continue -- NO new one
    is generated, so the part the student already did is not thrown away. The old set is
    deactivated and a new one generated only after the old one has been submitted.
    """
    regenerateInterestQuiz: [InterestQuizItem!]!
}

enum PracticeGoalType {
    ASSESSMENT_PREP
    ABILITY_IMPROVEMENT
}

input InterestQuizAnswerInput {
    itemId: ID!
    mostStatementIndex: Int!
    leastStatementIndex: Int!
}

input SubmitInterestQuizInput {
    answers: [InterestQuizAnswerInput!]!
}

type InterestQuizItem {
    id: ID!
    statements: [String!]!
}

type LearnerProfile {
    goalType: PracticeGoalType!
    """
    The target band of the grading policy -- used as the preselected band on the difficulty
    selection screen.

    NULL when the school has no policy covering the student's class yet. This case used to throw,
    which broke even the WRITE operations that return this type (submitting the quiz, setting the
    goal) -- see the note on JpaLearnerProfileQueryRepository.findCurrent. The client picks a
    default band itself when it is missing.
    """
    targetFrameworkBandCode: String
    targetFrameworkBandLabel: String
    quizCompletedAt: DateTime
}

"""
One band on the scale of the framework in effect, so the student can choose the difficulty
before entering a session. No band is marked as "the student's band" -- the system does not
rank ability levels, it only records the difficulty the student chose for each session.
"""
type PracticeBandOption {
    id: ID!
    code: String!
    label: String!
    description: String
    order: Int!
}

"""
An assessment framework the student can choose. versionId is the latest published version of
the framework, picked by the server -- the student does not need to know the concept of versions.
"""
type PracticeFrameworkOption {
    versionId: ID!
    code: String!
    name: String!
    description: String
    bandCount: Int!
}
