enum QuestionType {
    READ_ALOUD
    SHORT_ANSWER
    LONG_ANSWER
    OPINION
    DESCRIPTION
}

type QuestionBank {
    id: ID!
    bankName: String!
    description: String
    isActive: Boolean!
    createdAt: String!
    updatedAt: String!
    createdBy: ID
    updatedBy: ID
}

type QuestionBankPage {
    content: [QuestionBank!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type QuestionTopic {
    id: ID!
    questionBankId: ID!
    code: String!
    name: String!
    description: String
    status: String!
    createdAt: String
    updatedAt: String
}

type QuestionTopicPage {
    content: [QuestionTopic!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type QuestionAsset {
    id: ID!
    questionId: ID!
    title: String
    durationSeconds: Int
    altText: String
    type: String!
    url: String
    transcript: String
    description: String
    order: Int!
}

type QuestionEvaluationGuide {
    id: ID!
    questionId: ID!
    expectedContent: String
    keyPoints: String
    acceptableResponses: String
    offTopicExamples: String
    scoringHints: String
    commonMistakes: String
}

type Question {
    id: ID!
    questionTopicId: ID!
    code: String!
    instructionText: String
    questionText: String!
    promptText: String
    preparationText: String
    type: String!
    preparationTimeSeconds: Int!
    minResponseSeconds: Int!
    maxResponseSeconds: Int!
    scope: String!
    visibility: String!
    sourceQuestionId: ID
    locked: Boolean!
    status: String!
    createdAt: String
    updatedAt: String
    questionTopic: QuestionTopic
    assets: [QuestionAsset!]
    evaluationGuide: QuestionEvaluationGuide
}

type QuestionPage {
    content: [Question!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

extend type Query {
    questionBanks(page: Int = 0, size: Int = 20): QuestionBankPage!
    questionBank(id: ID!): QuestionBank

    questionTopics(bankId: ID!, page: Int = 0, size: Int = 20): QuestionTopicPage!
    questionTopic(id: ID!): QuestionTopic

    questions(page: Int = 0, size: Int = 20): QuestionPage!
    questionsByTopic(topicId: ID!, page: Int = 0, size: Int = 20): QuestionPage!
    question(id: ID!): Question

    # Teacher queries (QuestionController)
    teacherMyQuestions(page: Int = 0, size: Int = 20): QuestionPage!
    teacherReviewQueue(page: Int = 0, size: Int = 20): QuestionPage!

    # School queries (QuestionController)
    schoolReviewQueue(page: Int = 0, size: Int = 20): QuestionPage!

    # Admin queries (QuestionController)
    adminQuestions(page: Int = 0, size: Int = 20, includeArchived: Boolean, status: String, keyword: String): QuestionPage!
    adminReviewQueue(page: Int = 0, size: Int = 20): QuestionPage!

    # Teacher queries (QuestionTopicController)
    teacherBankTopics(bankId: ID!, page: Int = 0, size: Int = 20): QuestionTopicPage!
    teacherTopicQuestions(bankId: ID!, topicId: ID!, page: Int = 0, size: Int = 20, status: String, keyword: String): QuestionPage!

    # School queries (QuestionTopicController)
    schoolBankTopics(bankId: ID!, page: Int = 0, size: Int = 20): QuestionTopicPage!
    schoolTopicQuestions(bankId: ID!, topicId: ID!, page: Int = 0, size: Int = 20, status: String, keyword: String): QuestionPage!

    # Admin queries (QuestionTopicController)
    adminBankTopics(bankId: ID!, page: Int = 0, size: Int = 20, includeArchived: Boolean): QuestionTopicPage!

    # Admin queries (QuestionBankController)
    adminBankQuestions(bankId: ID!, page: Int = 0, size: Int = 20, includeArchived: Boolean, status: String, keyword: String): QuestionPage!
}
