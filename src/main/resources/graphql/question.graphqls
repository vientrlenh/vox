enum QuestionType {
    READ_ALOUD
    SHORT_ANSWER
    LONG_ANSWER
    OPINION
    DESCRIPTION
}

enum QuestionStatus {
    DRAFT
    SUBMITTED_FOR_REVIEW
    REVISION_REQUESTED
    APPROVED
    REJECTED
    PUBLISHED
    ARCHIVED
}

type QuestionBank {
    id: ID!
    bankName: String!
    description: String
    isActive: Boolean!
    createdAt: String!
    updatedAt: String!
    createdBy: ID
    updatedBy: ID
}

type QuestionBankPage {
    content: [QuestionBank!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type QuestionTopic {
    id: ID!
    bankId: ID!
    topicName: String!
    description: String
    bank: QuestionBank
}

type QuestionTopicDto {
    id: ID!
    questionBankId: ID!
    code: String!
    name: String!
    description: String
    status: String!
    createdAt: String
    updatedAt: String
}

type QuestionTopicDtoPage {
    content: [QuestionTopicDto!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type QuestionTopicPage {
    content: [QuestionTopic!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type Question {
    id: ID!
    topicId: ID!
    questionText: String!
    audioUrl: String
    standardLevelId: ID!
    standardLevelCode: String
    frameworkCode: String
    frameworkName: String
    questionType: QuestionType!
    durationSeconds: Int!
    isActive: Boolean!
    createdAt: String!
    topic: QuestionTopic
}

type QuestionDto {
    id: ID!
    questionTopicId: ID!
    code: String!
    instructionText: String
    questionText: String!
    promptText: String
    preparationText: String
    type: String!
    preparationTimeSeconds: Int!
    minResponseSeconds: Int!
    maxResponseSeconds: Int!
    scope: String!
    visibility: String!
    sourceQuestionId: ID
    locked: Boolean!
    status: String!
    createdAt: String
    updatedAt: String
}

type QuestionDtoPage {
    content: [QuestionDto!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type QuestionAssetDto {
    id: ID!
    questionId: ID!
    title: String
    durationSeconds: Int
    altText: String
    type: String!
    url: String
    transcript: String
    description: String
    order: Int!
}

type QuestionEvaluationGuideDto {
    id: ID!
    questionId: ID!
    expectedContent: String
    keyPoints: String
    acceptableResponses: String
    offTopicExamples: String
    scoringHints: String
    commonMistakes: String
}

type QuestionDetailDto {
    id: ID!
    questionTopicId: ID!
    code: String!
    instructionText: String
    questionText: String!
    promptText: String
    preparationText: String
    type: String!
    preparationTimeSeconds: Int!
    minResponseSeconds: Int!
    maxResponseSeconds: Int!
    scope: String!
    visibility: String!
    sourceQuestionId: ID
    locked: Boolean!
    status: String!
    createdAt: String
    updatedAt: String
    questionTopic: QuestionTopicDto
    evaluationGuide: QuestionEvaluationGuideDto
    assets: [QuestionAssetDto!]
}

type QuestionPage {
    content: [Question!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

extend type Query {
    questionBanks(page: Int = 0, size: Int = 20): QuestionBankPage!
    questionBank(id: ID!): QuestionBank

    questionTopics(bankId: ID!, page: Int = 0, size: Int = 20): QuestionTopicPage!
    questionTopic(id: ID!): QuestionTopic

    questions(page: Int = 0, size: Int = 20): QuestionPage!
    questionsByTopic(topicId: ID!, page: Int = 0, size: Int = 20): QuestionPage!
    question(id: ID!): Question

    # Common
    questionDetail(questionId: ID!): QuestionDetailDto

    # Teacher queries (QuestionController)
    teacherMyQuestions(page: Int = 0, size: Int = 20): QuestionDtoPage!
    teacherReviewQueue(page: Int = 0, size: Int = 20): QuestionDtoPage!

    # School queries (QuestionController)
    schoolReviewQueue(page: Int = 0, size: Int = 20): QuestionDtoPage!

    # Admin queries (QuestionController)
    adminQuestions(page: Int = 0, size: Int = 20, includeArchived: Boolean, status: String, keyword: String): QuestionDtoPage!
    adminReviewQueue(page: Int = 0, size: Int = 20): QuestionDtoPage!

    # Teacher queries (QuestionTopicController)
    teacherBankTopics(bankId: ID!, page: Int = 0, size: Int = 20): QuestionTopicDtoPage!
    teacherTopicQuestions(bankId: ID!, topicId: ID!, page: Int = 0, size: Int = 20, status: String, keyword: String): QuestionDtoPage!

    # School queries (QuestionTopicController)
    schoolBankTopics(bankId: ID!, page: Int = 0, size: Int = 20): QuestionTopicDtoPage!
    schoolTopicQuestions(bankId: ID!, topicId: ID!, page: Int = 0, size: Int = 20, status: String, keyword: String): QuestionDtoPage!

    # Admin queries (QuestionTopicController)
    adminBankTopics(bankId: ID!, page: Int = 0, size: Int = 20, includeArchived: Boolean): QuestionTopicDtoPage!

    # Admin queries (QuestionBankController)
    adminBankQuestions(bankId: ID!, page: Int = 0, size: Int = 20, includeArchived: Boolean, status: String, keyword: String): QuestionDtoPage!
}
