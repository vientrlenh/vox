enum QuestionBankOwnerType {
    SYSTEM
    SCHOOL
}

enum QuestionBankStatus {
    DRAFT
    PUBLISHED
    ARCHIVED
}

enum QuestionTopicStatus {
    DRAFT
    PUBLISHED
    ARCHIVED
}

enum QuestionType {
    READ_ALOUD
    SHORT_ANSWER
    LONG_ANSWER
    OPINION
    DESCRIPTION
}

enum QuestionSharing {
    PRIVATE
    SCHOOL_SHARED
}

enum QuestionStatus {
    DRAFT
    SUBMITTED_FOR_REVIEW
    REVISION_REQUESTED
    APPROVED
    REJECTED
    PUBLISHED
    ARCHIVED
}

enum QuestionConfidentiality {
    OPEN
    EXAM_RESTRICTED
    RELEASED
}

enum QuestionAssetType {
    AUDIO
    IMAGE
    VIDEO
    TEXT_PASSAGE
}

enum QuestionCollaboratorPermission {
    READ_ONLY
    CAN_USE
    CAN_EDIT
}

enum QuestionDifficulty {
    EASY
    MEDIUM
    HARD
}

enum QuestionScope {
    MINE
    COLLABORATING
    REVIEWING
    ALL
}

type QuestionBankGrade {
    id: ID!
    questionBankId: ID!
    schoolGradeId: ID!
    attachedAt: String
    attachedBy: ID
    schoolGrade: SchoolGrade
}

type QuestionBank {
    id: ID!
    languageId: ID!
    schoolId: ID
    code: String!
    name: String!
    description: String
    ownerType: QuestionBankOwnerType!
    status: QuestionBankStatus!
    createdAt: String
    updatedAt: String
    createdBy: ID
    updatedBy: ID
    grades: [QuestionBankGrade!]!
}

type QuestionBankPage {
    content: [QuestionBank!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type QuestionTopic {
    id: ID!
    questionBankId: ID!
    code: String!
    name: String!
    description: String
    status: QuestionTopicStatus!
    createdAt: String
    updatedAt: String
    createdBy: ID
    updatedBy: ID
    bank: QuestionBank!
}

type QuestionTopicPage {
    content: [QuestionTopic!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type QuestionAsset {
    id: ID!
    questionId: ID!
    title: String
    durationSeconds: Int
    altText: String
    type: QuestionAssetType!
    url: String
    transcript: String
    description: String
    transcriptManuallyEdited: Boolean!
    descriptionManuallyEdited: Boolean!
    order: Int!
}

type QuestionEvaluationGuide {
    id: ID!
    questionId: ID!
    expectedContent: String
    keyPoints: String
    acceptableResponses: String
    offTopicExamples: String
    scoringHints: String
    commonMistakes: String
}

type QuestionCollaborator {
    id: ID!
    userId: ID!
    questionId: ID!
    permission: QuestionCollaboratorPermission!
    assignedAt: String
    user: User
}

type Question {
    id: ID!
    questionBankId: ID!
    questionTopicId: ID!
    code: String!
    instructionText: String
    questionText: String!
    promptText: String
    preparationText: String
    type: QuestionType!
    preparationTimeSeconds: Int!
    minResponseSeconds: Int!
    maxResponseSeconds: Int!
    sharing: QuestionSharing
    sourceQuestionId: ID
    locked: Boolean!
    status: QuestionStatus!
    confidentiality: QuestionConfidentiality!
    securePoolId: ID
    createdAt: String
    updatedAt: String
    createdBy: ID
    updatedBy: ID
    createdByUser: User
    topic: QuestionTopic!
    bank: QuestionBank!
    assets: [QuestionAsset!]!
    evaluationGuide: QuestionEvaluationGuide
    collaborators: [QuestionCollaborator!]!
    usableInExam: Boolean!
}

type QuestionPage {
    content: [Question!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

extend type Query {
    questionBanks(
        ownerType: QuestionBankOwnerType,
        status: QuestionBankStatus,
        languageId: ID,
        schoolId: ID,
        schoolGradeId: ID,
        keyword: String,
        page: Int = 0,
        size: Int = 20
    ): QuestionBankPage!
    questionBank(id: ID!): QuestionBank

    questionTopics(
        questionBankId: ID,
        status: QuestionTopicStatus,
        keyword: String,
        page: Int = 0,
        size: Int = 20
    ): QuestionTopicPage!
    questionTopic(id: ID!): QuestionTopic

    questions(
        questionBankId: ID,
        questionTopicId: ID,
        topicName: String,
        status: QuestionStatus,
        type: QuestionType,
        sharing: QuestionSharing,
        scope: QuestionScope = ALL,
        keyword: String,
        page: Int = 0,
        size: Int = 20
    ): QuestionPage!
    questionsForExamPaper(
        questionBankId: ID,
        questionTopicId: ID,
        topicName: String,
        status: QuestionStatus,
        type: QuestionType,
        sharing: QuestionSharing,
        scope: QuestionScope = ALL,
        keyword: String,
        page: Int = 0,
        size: Int = 20
    ): QuestionPage!
    question(id: ID!): Question
}
