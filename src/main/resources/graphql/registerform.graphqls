enum RegisterFormStatus {
    PENDING
    AUTO_APPROVED
    APPROVED
    REJECTED
    EXPIRED
}

type RegisterForm {
    id: ID!
    contactFullName: String
    identityNumber: String
    contactPhone: String
    contactEmail: String
    dateOfBirth: Date
    contactAddress: String
    schoolDomain: String
    schoolName: String
    schoolAddress: String
    postalCode: String
    position: String
    studentCount: Int
    reason: String
    status: RegisterFormStatus
    documents: [RegisterFormDocument!]
}

type RegisterFormPage {
    content: [RegisterForm!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type RegisterFormDocument {
    id: ID!
    registerFormId: ID
    url: String
    createdAt: DateTime
}

extend type Query {
    registerForms(page: Int! = 1, size: Int! = 20): RegisterFormPage!
    registerForm(id: ID!): RegisterForm
}