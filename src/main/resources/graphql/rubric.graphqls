enum RubricStatus {
    DRAFT
    PUBLISHED
    ARCHIVED
}

enum RubricOwnerType {
    SYSTEM
    SCHOOL
}

enum RubricTotalScoreMethod {
    WEIGHTED_AVERAGE
    SUM
}

input UpdateRubricInput {
    name: String
    description: String
}

input UpdateRubricVersionInput {
    name: String
    description: String
    effectiveFrom: DateTime
    effectiveTo: DateTime
    scoringScaleMin: Float
    scoringScaleMax: Float
    totalScoreMethod: RubricTotalScoreMethod
}

input UpdateRubricCriterionInput {
    name: String
    description: String
    examplesJson: String # Receives a JSON string from the frontend.
    weight: Float
    minScore: Float
    maxScore: Float
    order: Int
    isRequired: Boolean
}

input UpdateRubricResultBandInput {
    name: String
    description: String
    scoreMin: Float
    scoreMax: Float
    order: Int
}


input SearchRubricFilter {
    keyword: String     # Search by name or code
    frameworkId: ID     # Filter by framework
    languageId: ID      # Filter by language
}

input SearchRubricVersionFilter {
    keyword: String     # Search by version name or code
    status: RubricStatus # Filter by status
}

input SearchRubricCriterionFilter {
    keyword: String     # Search by criterion name or code
    isRequired: Boolean # Filter by required or not
}

input SearchRubricResultBandFilter {
    keyword: String     # Search by name or code
}


#========================= RUBRIC =====================================
# Whatever the controller returns, the same applies here
# ViewRubricDetailsUseCase
# receives from the arguments - and it is added in the extend schoolId: ID!, id: ID!
type Rubric {
    id: ID!
    code: String!
    name: String!
    description: String
    languageId: ID!
    frameworkId: ID!
    ownerType: RubricOwnerType!
    versions(page: Int = 1, size: Int = 10, status: RubricStatus): RubricVersionPage!
    language: SupportedLanguage
    framework: Framework
}
#Page
type RubricPage {
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
    content: [Rubric!]!
}
#===================RUBRIC VERSION ==================================

type RubricVersion {
    id: ID!
    rubricId: ID!
    version: Int!
    code: String!
    name: String!
    description: String
    status: RubricStatus!
    effectiveFrom: DateTime!
    effectiveTo: DateTime
    scoringScaleMin: Float!
    scoringScaleMax: Float!
    totalScoreMethod: RubricTotalScoreMethod!
    createdAt: DateTime
    """
    The template version this one was copied from; NULL if the owner wrote it themselves.

    Lets the version page say "Copied from the system's template criteria set" instead of leaving
    the copy looking exactly like a self-written one. There is no foreign key: the template may have
    been archived or deleted while the copy lives on normally, so do not treat this as a relation
    that is guaranteed to resolve.
    """
    sourceRubricVersionId: ID
    criteria(page: Int = 1, size: Int = 10): RubricCriterionPage!
    resultBands(page: Int = 1, size: Int = 10): RubricResultBandPage!
}
type RubricVersionPage {
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
    content: [RubricVersion!]!
}

#=====================================RUBRIC CRITERION===========================
type RubricCriterion {
    id: ID!
    rubricVersionId: ID!
    frameworkCriterionId: ID!
    code: String!
    name: String!
    description: String
    examplesJson: String  # Returns the JSON string as is for the frontend to parse
    weight: Float!
    minScore: Float!
    maxScore: Float!
    order: Int!
    isRequired: Boolean!
    createdAt: DateTime
    updatedAt: DateTime
    createdBy: ID
    updatedBy: ID
}

type RubricCriterionPage {
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
    content: [RubricCriterion!]!

}


#====================RUBRIC RESULT BAND =========================
type RubricResultBand {
    id: ID!
    rubricVersionId: ID!
    code: String!
    name: String!
    description: String
    scoreMin: Float!
    scoreMax: Float!
    order: Int!
    createdAt: DateTime
    updatedAt: DateTime
    createdBy: ID
    updatedBy: ID
}

type RubricResultBandPage {
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
    content: [RubricResultBand!]!
}


# 2. Mutation definitions
extend type Mutation {
    updateSystemRubric(id: ID!, input: UpdateRubricInput!): ID!
    updateSchoolRubric(schoolId: ID!, id: ID!, input: UpdateRubricInput!): ID!

    # RUBRIC VERSION
    updateSystemRubricVersion(versionId: ID!, input: UpdateRubricVersionInput!): ID!
    updateSchoolRubricVersion(schoolId: ID!, versionId: ID!, input: UpdateRubricVersionInput!): ID!

    # RUBRIC CRITERION
    updateSystemRubricCriterion(criterionId: ID!, input: UpdateRubricCriterionInput!): ID!
    updateSchoolRubricCriterion(schoolId: ID!, criterionId: ID!, input: UpdateRubricCriterionInput!): ID!

    # RUBRIC CRITERION RESULT BAND
    updateSystemRubricResultBand(resultBandId: ID!, input: UpdateRubricResultBandInput!): ID!
    updateSchoolRubricResultBand(schoolId: ID!, resultBandId: ID!, input: UpdateRubricResultBandInput!): ID!
}

extend type Query {
    # RUBRIC
    # for a rubric version, call viewSchoolRubric -> rubric
    # => it has already checked the school
    # a system admin who wants to see a version => viewSystemRubric
    # a school admin => viewSchoolRubric
    # only the first two are used
    viewSystemRubric(id: ID!): Rubric
    viewSchoolRubric(schoolId: ID!, id: ID!): Rubric
    viewSystemRubrics(page: Int = 1, size: Int = 10): RubricPage!
    viewSchoolRubrics(schoolId: ID!, page: Int = 1, size: Int = 10): RubricPage!
    # Search entry point for the System Admin
    searchSystemRubrics(filter: SearchRubricFilter, page: Int = 1, size: Int = 10): RubricPage!
    """
    Catalog of the system's TEMPLATE criteria sets, for a School to browse before copying them.

    Returns the same `Rubric` type as the other entry points, so going deeper into versions /
    criteria / result bands reuses the existing resolvers as they are (already batched through
    DataLoader). Filter for published versions with the existing argument:
    `versions(status: PUBLISHED)`.

    Kept separate from `searchSystemRubrics` instead of widening its permissions, so that the next
    time someone tightens or loosens one entry point they do not accidentally change the other.
    """
    systemRubricTemplates(filter: SearchRubricFilter, page: Int = 1, size: Int = 10): RubricPage!
    # Search entry point for the School Admin (schoolId is required)
    searchSchoolRubrics(schoolId: ID!, filter: SearchRubricFilter, page: Int = 1, size: Int = 10): RubricPage!
    # Search entry point for the Teacher (schoolId is derived from the token, only rubrics of their own school)
    searchTeacherRubrics(filter: SearchRubricFilter, page: Int = 1, size: Int = 10): RubricPage!

    # RUBRIC VERSION
    viewSchoolRubricVersion(schoolId: ID!, versionId: ID!): RubricVersion
    viewSystemRubricVersion(versionId: ID!): RubricVersion
    viewSchoolRubricVersions(schoolId: ID!, rubricId: ID!, status: RubricStatus, page: Int = 1, size: Int = 10): RubricVersionPage!
    viewSystemRubricVersions(rubricId: ID!, status: RubricStatus, page: Int = 1, size: Int = 10): RubricVersionPage!
    # A teacher can only see PUBLISHED versions of rubrics belonging to their own school (schoolId is derived from the token)
    viewTeacherRubricVersions(rubricId: ID!, page: Int = 1, size: Int = 10): RubricVersionPage!
    searchSystemRubricVersions(rubricId: ID!, filter: SearchRubricVersionFilter, page: Int = 1, size: Int = 10): RubricVersionPage!
    searchSchoolRubricVersions(schoolId: ID!, rubricId: ID!, filter: SearchRubricVersionFilter, page: Int = 1, size: Int = 10): RubricVersionPage!


    # RUBRIC CRITERION
    viewSystemRubricCriterion(criterionId: ID!): RubricCriterion
    viewSchoolRubricCriterion(schoolId: ID!, criterionId: ID!): RubricCriterion
    viewSystemRubricCriteria(versionId: ID!, page: Int = 1, size: Int = 10): RubricCriterionPage!
    viewSchoolRubricCriteria(schoolId: ID!, versionId: ID!, page: Int = 1, size: Int = 10): RubricCriterionPage!
    searchSystemRubricCriteria(versionId: ID!, filter: SearchRubricCriterionFilter, page: Int = 1, size: Int = 10): RubricCriterionPage!
    searchSchoolRubricCriteria(schoolId: ID!, versionId: ID!, filter: SearchRubricCriterionFilter, page: Int = 1, size: Int = 10): RubricCriterionPage!


    # RUBRIC CRITERION RESULT BAND
    viewSystemRubricResultBand(resultBandId: ID!): RubricResultBand
    viewSchoolRubricResultBand(schoolId: ID!, resultBandId: ID!): RubricResultBand
    viewSystemRubricResultBands(versionId: ID!, page: Int = 1, size: Int = 10): RubricResultBandPage!
    viewSchoolRubricResultBands(schoolId: ID!, versionId: ID!, page: Int = 1, size: Int = 10): RubricResultBandPage!

    # System Admin
    searchSystemRubricResultBands(versionId: ID!, filter: SearchRubricResultBandFilter, page: Int = 1, size: Int = 10): RubricResultBandPage!
    # School Admin
    searchSchoolRubricResultBands(schoolId: ID!, versionId: ID!, filter: SearchRubricResultBandFilter, page: Int = 1, size: Int = 10): RubricResultBandPage!
}
