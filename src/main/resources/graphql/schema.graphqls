type RegisterForm {
    id: ID
    contactFullName: String
    identityNumber: String
    contactPhone: String
    contactEmail: String
    dateOfBirth: String
    contactAddress: String
    schoolDomain: String
    schoolName: String
    schoolAddress: String
    postalCode: String
    position: String
    studentCount: Int
    reason: String
    status: String
}

type RegisterFormPage {
    content: [RegisterForm!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type SchoolUser {
    id: ID
    email: String
    phone: String
    fullName: String
    roleCode: String
    status: String
    schoolId: ID
    studentId: String
    createdAt: String
}

type SchoolUserPage {
    content: [SchoolUser!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type Query {
    registerForms(page: Int = 0, size: Int = 20): RegisterFormPage!
    registerForm(id: ID!): RegisterForm
    schoolUsers(schoolId: ID!, page: Int = 1, size: Int = 20): SchoolUserPage!
    schoolUser(schoolId: ID!, userId: ID!): SchoolUser
}
