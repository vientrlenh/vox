type School {
    id: ID!
    code: String!
    name: String
    description: String
    contactPhone: String 
    contactEmail: String
    domain: String 
    address: String 
    studentCount: Int 
    isActive: Boolean
    createdAt: String 
    updatedAt: String
    classes(page: Int = 1, size: Int = 10): [SchoolClass!]
}

type SchoolPage {
    content: [School!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type SchoolClass {
    id: ID!
    schoolId: ID!
    languageId: ID!
    schoolGradeId: ID!
    code: String!
    name: String!
    description: String
    targetSchoolLevelVersionId: ID!
    status: String!
    createdAt: String
    updatedAt: String
    createdBy: ID
    updatedBy: ID
}

type SchoolClassPage {
    content: [SchoolClass!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

extend type Query {
    schools(page: Int = 1, size: Int = 20): SchoolPage!
    schoolClasses(page: Int = 1, size: Int = 20): SchoolClassPage!
    schoolClass(id: ID!): SchoolClass
}
