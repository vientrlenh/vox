enum SchoolClassStatus {
    INACTIVE
    ACTIVE
    ARCHIVED
}

enum SchoolGradeStatus {
    INACTIVE
    ACTIVE
    ARCHIVED
}

enum GradeLevelStatus {
    ACTIVE
    INACTIVE
}

enum SchoolDirectoryOrigin {
    OFFICIAL_IMPORT
    ADMIN_CREATED
    USER_SUBMITTED
}

enum UserStatus {
    ACTIVE
    INACTIVE
    LOCKED
    DISABLED
}

type School {
    id: ID!
    code: String!
    name: String
    description: String
    contactPhone: String
    contactEmail: String
    domain: String
    address: String
    studentCount: Int
    isActive: Boolean
    createdAt: DateTime
    updatedAt: DateTime
    classes(page: Int = 1, size: Int = 10): [SchoolClass!]
    users(page: Int = 1, size: Int = 10): [SchoolUser!]
}



# Renamed to match GraphQL naming (Input instead of Request)
input UpdateSchoolInput {
    name: String
    description: String
    contactPhone: String
    contactEmail: String
    domain: String
    address: String
    studentCount: Int
}

type SchoolPage {
    content: [School!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}


# ==================================================================
# School Room
# ==================================================================
type SchoolRoom {
    id: ID!
    schoolId: ID!
    code: String!
    name: String!
    description: String
    isActive: Boolean!
    createdAt: DateTime
    createdBy: String
    updatedAt: DateTime
    updateBy: String
}

input UpdateSchoolRoomInput {
    name: String
    description: String
}

type SchoolRoomPageResult {
    totalElements: Int!
    totalPages: Int!
    page: Int!
    size: Int!
    content: [SchoolRoom!]!
}

#==========SCHOOL CLASS=========


type SchoolClass {
    id: ID!
    schoolId: ID!
    languageId: ID!
    schoolGradeId: ID!
    code: String!
    name: String!
    description: String
    status: SchoolClassStatus!
    createdAt: DateTime
    updatedAt: DateTime
    school: School
    schoolGrade: SchoolGrade
    language: SupportedLanguage
}

type SchoolGrade {
    id: ID!
    schoolId: ID!
    code: String
    name: String
    description: String
    startDate: Date
    endDate: Date
    status: SchoolGradeStatus
    createdAt: DateTime
    updatedAt: DateTime
}

type SchoolClassPage {
    content: [SchoolClass!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type SchoolClassUser {
    id: ID!
    userId: ID!
    schoolClassId: ID!
    isActive: Boolean!
    joinedAt: DateTime
    leftAt: DateTime
    assignedBy: ID
    user: User
}

type SchoolClassUserPage {
    content: [SchoolClassUser!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type UpdateSchoolClassResponse {
    schoolClassId: ID!
}

input UpdateSchoolClassInput {
    name: String
    description: String
    status: SchoolClassStatus
}

type UpdateSchoolUserResponse {
    schoolUserId: ID!
}

input UpdateSchoolUserInput {
    fullName: String
    phone: String
    address: String
    dateOfBirth: Date
    """
    Avatar path issued by the system; null to remove the avatar.
    This is the ONLY way to set a student's avatar -- updateProfile refuses to let students change it,
    because the portrait here is identity data that proctors use when taking attendance.
    """
    avatarUrl: String
}

type SchoolUser {
    id: ID!
    schoolId: ID
    userId: ID
    startDate: DateTime
    endDate: DateTime
    user: User
}

type SchoolUserPage {
    content: [SchoolUser!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

input UpdateSchoolGradeInput {
    name: String
    description: String
    startDate: Date
    endDate: Date
}

type SchoolGradePage {
    content: [SchoolGrade!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

# Grade level catalog shared by the whole system -- no longer has a schoolId.
type GradeLevel {
    id: ID!
    code: String!
    name: String!
    description: String
    order: Int!
    status: GradeLevelStatus!
    createdAt: DateTime
    updatedAt: DateTime
}

type GradeLevelPage {
    content: [GradeLevel!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

input UpdateGradeLevelInput {
    name: String
    description: String
    order: Int
}


type SchoolDirectory {
    id: ID!
    code: String
    name: String 
    provinceCode: String 
    provinceName: String
    districtName: String
    domain: String
    address: String
    origin: SchoolDirectoryOrigin
    verified: Boolean
    createdAt: DateTime
    updatedAt: DateTime
}

type SchoolDirectoryCursorPage {
    content: [SchoolDirectory!]!
    nextCursor: ID
    hasNext: Boolean
}

type SchoolDirectoryPage {
    content: [SchoolDirectory!]!
    page: Int! 
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

# AI quota debt (SchoolDebtEventType / SchoolDebtEvent / SchoolDebtEventPage / schoolDebtEvents) moved to
# school-balance.graphqls: debt is the other side of the wallet balance -- the same wallet, one side tells
# where the money went and the other tells why the school is locked -- so reading the two together is
# easier to understand. The schema after Spring GraphQL merges the files does NOT change, so no caller
# has to be updated.

extend type Query {
    schoolRoom(id: ID!): SchoolRoom
    schoolRooms(schoolId: ID!, page: Int, size: Int): SchoolRoomPageResult
    schools(page: Int = 1, size: Int = 20, search: String, isActive: Boolean): SchoolPage!
    school(id: ID!): School
    schoolClasses(page: Int = 1, size: Int = 20, search: String, status: SchoolClassStatus, languageId: ID, schoolGradeId: ID): SchoolClassPage!
    schoolUsersBySchool(schoolId: ID!, page: Int! = 1, size: Int! = 20, search: String, roleId: ID, roleCode: String, status: UserStatus, excludeClassId: ID): SchoolUserPage!
    schoolUsersForRequester(schoolId: ID!, page: Int! = 1, size: Int! = 20, search: String, roleId: ID, status: UserStatus): SchoolUserPage!
    schoolStudentsBySchool(schoolId: ID!, page: Int! = 1, size: Int! = 20, search: String, status: UserStatus): SchoolUserPage!
    schoolTeachersBySchool(schoolId: ID!, page: Int! = 1, size: Int! = 20, search: String, status: UserStatus): SchoolUserPage!
    schoolUser(schoolId: ID!, userId: ID!): SchoolUser
    schoolClass(id: ID!): SchoolClass
    schoolClassUsers(schoolClassId: ID!, page: Int = 1, size: Int = 20): SchoolClassUserPage!
    schoolClassesByUser(schoolId: ID!, userId: ID!, status: SchoolClassStatus, page: Int = 1, size: Int = 20): SchoolClassPage!
    mySchoolClasses(schoolId: ID!, status: SchoolClassStatus, page: Int! = 1, size: Int! = 10): SchoolClassPage!
    schoolGrades(schoolId: ID!, gradeLevelId: ID, status: SchoolGradeStatus, page: Int, size: Int): SchoolGradePage
    schoolGrade(schoolId: ID!, id: ID!): SchoolGrade
    gradeLevels(page: Int! = 1, size: Int! = 20, search: String, status: GradeLevelStatus): GradeLevelPage!
    gradeLevel(gradeLevelId: ID!): GradeLevel
    schoolDirectoryCursorPage(cursor: ID, limit: Int! = 10): SchoolDirectoryCursorPage
    schoolDirectoryPage(page: Int! = 1, size: Int! = 20): SchoolDirectoryPage
    schoolDirectory(id: ID!): SchoolDirectory 
    "Ids of the schools that currently have an assessment running -- used to disable the suspend-plan button up front."
    schoolsWithOngoingAssessment: [ID!]
}

extend type Mutation {
    updateSchoolClass(id: ID!, input: UpdateSchoolClassInput!): UpdateSchoolClassResponse!
    updateSchoolUser(schoolId: ID!, userId: ID!, input: UpdateSchoolUserInput!): UpdateSchoolUserResponse!
    updateSchoolGrade(id: ID!, input: UpdateSchoolGradeInput!): ID!
    updateGradeLevel(gradeLevelId: ID!, input: UpdateGradeLevelInput!): ID!
    updateSchoolRoom(id: ID!, input: UpdateSchoolRoomInput!): ID!
    updateSchool(id: ID!, input: UpdateSchoolInput!): ID!
}

#================ SCHOOL GRADE =============


