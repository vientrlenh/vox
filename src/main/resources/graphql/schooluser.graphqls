type SchoolUser {
    id: ID
    email: String
    phone: String
    fullName: String
    roleCode: String
    status: String
    schoolId: ID
    studentId: String
    createdAt: String
}

type SchoolUserPage {
    content: [SchoolUser!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

extend type Query {
    schoolUsers(schoolId: ID!, page: Int = 1, size: Int = 20): SchoolUserPage!
    schoolUser(schoolId: ID!, userId: ID!): SchoolUser
}