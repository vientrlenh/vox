enum ScoringRuleConditionType {
    DURATION_LESS_THAN
    DURATION_GREATER_THAN
    WORD_COUNT_LESS_THAN
    WORD_COUNT_GREATER_THAN
    CRITERION_SCORE_LESS_THAN
    CRITERION_SCORE_GREATER_THAN
    FINAL_SCORE_LESS_THAN
    FINAL_SCORE_GREATER_THAN
    TASK_RELEVANCE_LESS_THAN
    OFF_TOPIC_RATIO_GREATER_THAN
    CODE_SWITCHING_RATIO_GREATER_THAN
    ASR_CONFIDENCE_LESS_THAN
    AI_CONFIDENCE_LESS_THAN
    AUDIO_QUALITY_LESS_THAN
    SILENCE_RATIO_GREATER_THAN
    SPEECH_RATE_LESS_THAN
    SPEECH_RATE_GREATER_THAN
}

enum ScoringRuleActionType {
    CAP_FINAL_SCORE
    CAP_CRITERION_SCORE
    ADD_FINAL_SCORE_DELTA
    ADD_CRITERION_SCORE_DELTA
    CAP_FRAMEWORK_RESULT_BAND
    SET_FRAMEWORK_RESULT_BAND
    REQUIRE_HUMAN_REVIEW
    MARK_RESPONSE_INVALID
    REQUIRE_RETAKE
    ADD_FEEDBACK_TAG
    ADD_REVIEW_REASON
}

enum ScoringRuleSeverity {
    INFO
    WARNING
    BLOCKING
}

type ScoringRule {
    id: ID!
    policyId: ID!
    code: String!
    name: String!
    description: String
    conditionType: ScoringRuleConditionType!
    conditionParamsJson: String!
    actionType: ScoringRuleActionType!
    actionParamsJson: String!
    priority: Int!
    severity: ScoringRuleSeverity!
    stopProcessing: Boolean!
    isActive: Boolean!
    createdAt: DateTime
    updatedAt: DateTime
}

type ScoringRulePage {
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
    content: [ScoringRule!]!
}

extend type Query {
    # View/search the (paged) Scoring Rule list of one system Assessment Policy.
    # Viewable in every Policy status (including PUBLISHED/ARCHIVED) to support history lookups.
    searchSystemScoringRules(policyId: ID!, keyword: String, isActive: Boolean, page: Int = 1, size: Int = 10): ScoringRulePage!

    # View/search the (paged) Scoring Rule list of one school Assessment Policy.
    searchSchoolScoringRules(schoolId: ID!, policyId: ID!, keyword: String, isActive: Boolean, page: Int = 1, size: Int = 10): ScoringRulePage!

    # View the whole (paged) Scoring Rule list of one system Assessment Policy.
    viewAllSystemScoringRules(policyId: ID!, page: Int = 1, size: Int = 10): ScoringRulePage!

    # View the whole (paged) Scoring Rule list of one school Assessment Policy.
    viewAllSchoolScoringRules(schoolId: ID!, policyId: ID!, page: Int = 1, size: Int = 10): ScoringRulePage!

    # View the details of one Scoring Rule of a system Assessment Policy.
    viewSystemScoringRuleDetails(policyId: ID!, ruleId: ID!): ScoringRule!

    # View the details of one Scoring Rule of a school Assessment Policy.
    viewSchoolScoringRuleDetails(schoolId: ID!, policyId: ID!, ruleId: ID!): ScoringRule!
}

# Input to update a Scoring Rule. There is no "code" because the code is immutable and cannot change after creation.
# conditionParamsJson/actionParamsJson are raw JSON strings whose structure must match the chosen conditionType/actionType.
input UpdateScoringRuleInput {
    name: String!
    description: String
    conditionType: ScoringRuleConditionType!
    conditionParamsJson: String!
    actionType: ScoringRuleActionType!
    actionParamsJson: String!
    priority: Int!
    severity: ScoringRuleSeverity!
    stopProcessing: Boolean!
    isActive: Boolean!
}

extend type Mutation {
    # Update a Scoring Rule of a system Assessment Policy.
    # Only editable while the Policy is DRAFT (to avoid silently changing the scoring rules
    # of a PUBLISHED Policy that is already used to grade real assessments).
    updateSystemScoringRule(policyId: ID!, ruleId: ID!, input: UpdateScoringRuleInput!): ID!

    # Update a Scoring Rule of a school Assessment Policy (the same condition applies: the Policy must be DRAFT).
    updateSchoolScoringRule(schoolId: ID!, policyId: ID!, ruleId: ID!, input: UpdateScoringRuleInput!): ID!
}