# Phạm vi file này: GÓI (SubscriptionPlan) và ĐĂNG KÝ CỦA TRƯỜNG (SchoolSubscription) cùng hạn mức
# đi kèm. Hóa đơn / đơn hàng / thanh toán KHÔNG nằm ở đây -- chúng là tổng hợp riêng (Order,
# PaymentRecord, Invoice, SchoolBalance) và sẽ có schema riêng.
#
# Tiền tệ: mọi trường VND đều là Float vì dự án chưa khai báo scalar riêng nào. VND không có đơn vị
# lẻ nên giá trị luôn nguyên, và numeric(15,0) tối đa vẫn nằm dưới 2^53 nên client JS đọc không mất
# độ chính xác. Đổi sang scalar BigDecimal là việc chung của cả 24 schema, không làm lẻ ở đây.

enum SubscriptionPlanStatus {
    DRAFT
    ACTIVE
    ARCHIVED
}

enum SubscriptionPlanPeriod {
    DAY
    MONTH
    YEAR
}

enum SchoolSubscriptionStatus {
    ACTIVE
    EXPIRED
    CANCELLED
    "System Admin cưỡng chế mất quyền dùng NGAY -- khác CANCELLED chỉ tắt gia hạn, vẫn dùng được tới hết endDate"
    SUSPENDED
}

"""
Hai VÍ hạn mức cấp trường, đều tính bằng VND. Mỗi hoạt động chỉ trừ vào ĐÚNG MỘT ví, và tiêu hết ví
này không đụng tới ví kia -- để một tuần luyện nói nhiều bất thường không ăn mất ngân sách kỳ thi.

CLASS_TEST đã bị bỏ: nó là TRẦN CHI nằm trong ví EXAM chứ không phải ví thứ ba, và bị trừ trùng
cùng một khoản với EXAM cho mỗi bài kiểm tra trên lớp. Trần theo từng giáo viên vẫn còn, ở
SchoolSubscriptionQuotaUserAllocation với quotaType = EXAM.
"""
enum QuotaType {
    "Chấm thi -- cả kỳ thi tập trung lẫn bài kiểm tra trên lớp đều trừ vào đây"
    EXAM
    "Học sinh tự luyện nói"
    PRACTICE
}

type SubscriptionPlanQuota {
    id: ID!
    subscriptionPlanId: ID!
    quotaType: QuotaType!
    """
    Định mức bao gồm trong giá gói, quy ra VND. Không còn tokenUnitPrice đi kèm: đơn giá "VND cho
    mỗi $1" trước đây là tỷ giá đã cộng lãi nên hiển thị ra sai lệch với tỷ giá thật. Phần dùng vượt
    định mức trừ thẳng vào số dư của trường theo tỷ giá ghi ở từng lượt dùng.
    """
    includedAmountVnd: Float!
}

type SubscriptionPlan {
    id: ID!
    name: String!
    tagline: String
    priceVnd: Float!
    """
    Chu kỳ gói = periodType x periodCount (vd. MONTH x 12). Thay cho validityDays cũ: gói tính theo
    tháng/năm thì hạn phải rơi đúng ngày tương ứng, cộng thô theo số ngày sẽ lệch dần.
    """
    periodType: SubscriptionPlanPeriod!
    periodCount: Int!
    maxTimePerAttemptMin: Int!
    status: SubscriptionPlanStatus!
    version: Int!
    createdAt: String
    updatedAt: String
    createdBy: ID
    updatedBy: ID
    "Gói thay thế khi gói này đã ARCHIVED -- theo dây chuyền này để tìm gói còn bán được"
    replacedByPlanId: ID
    quotas: [SubscriptionPlanQuota!]!
}

type SubscriptionPlanPage {
    content: [SubscriptionPlanListItem!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

"""
Một dòng trong danh sách gói: chính gói, kèm nhãn "phổ biến nhất".

Nhãn đó nằm ở ĐÂY chứ không phải trên SubscriptionPlan vì nó không phải thuộc tính của gói -- nó là
kết quả so gói này với mọi gói khác, chỉ có nghĩa trong ngữ cảnh một danh sách. Hỏi một gói lẻ
(subscriptionPlan) thì câu hỏi "có phải phổ biến nhất không" không có ngữ cảnh để trả lời.
"""
type SubscriptionPlanListItem {
    subscription: SubscriptionPlan!
    """
    Gói đang có nhiều trường dùng nhất TOÀN HỆ THỐNG (không phải nhiều nhất trong trang hiện tại),
    và không đếm theo số lần thanh toán: gói được thay thế sinh ra id mới nên lịch sử giao dịch nằm
    lại ở gói cũ đã ARCHIVED. false ở mọi gói khi chưa trường nào đăng ký.
    """
    isMostPopular: Boolean!
}

type SchoolSubscription {
    id: ID!
    schoolId: ID!
    subscriptionPlanId: ID!
    startDate: String
    endDate: String
    status: SchoolSubscriptionStatus!
    "Giá đã trả tại thời điểm mua -- chốt cứng, không đổi theo giá gói sau này"
    pricePaidSnapshot: Float!
    cancelledAt: String
    createdAt: String
    # 3 cột suspended_* bị xóa trắng khi gỡ đình chỉ nên chỉ phản ánh lần đình chỉ ĐANG hiệu lực,
    # không phải lịch sử. Lịch sử bền vững nằm ở school_subscription_events (V2 mục 12), do
    # ForceSuspend/UnsuspendSubscriptionUseCase ghi -- không phải FinancialEvent, thứ đã bị bỏ.
    suspendedAt: String
    suspendedReason: String
    suspendedBy: ID
    plan: SubscriptionPlan
    school: School
}

type SchoolSubscriptionPage {
    content: [SchoolSubscription!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type SchoolSubscriptionQuotaRecord {
    id: ID!
    schoolSubscriptionId: ID!
    quotaType: QuotaType!
    "Định mức được cấp cho kỳ này, quy ra VND"
    totalAllocatedAmountVnd: Float!
    """
    Đã dùng bao nhiêu VND trong định mức trên. KHÔNG BAO GIỜ vượt totalAllocatedAmountVnd: phần chi
    vượt hạn mức được ConsumeQuotaService chuyển sang ví tự nạp của trường thành một bút toán
    OVERAGE_CHARGE, chứ không đẩy con số này lên quá trần.
    """
    usedAmountVnd: Float!
    """
    Phần của totalAllocatedAmountVnd do TRƯỜNG tự nạp từ ví sang, thay vì do gói cấp (V12).

    Sau lần nạp đầu tiên thì totalAllocatedAmountVnd đã trộn hai nguồn, nên đây là con số duy nhất
    trả lời được "gói cho bao nhiêu, trường bỏ thêm bao nhiêu". Cũng là phần DUY NHẤT sống sót qua
    lần gia hạn kế tiếp: định mức gói được cấp lại theo gói mới, còn phần này được mang sang theo
    số CHƯA TIÊU (quy ước: tiền gói tiêu trước, tiền tự nạp tiêu sau).
    """
    fundedFromBalanceVnd: Float!
    # KHÔNG còn isLocked ở đây. Nó từng là phép so usedAmountVnd > totalAllocatedAmountVnd, mà điều
    # kiện đó giờ không thể xảy ra nữa (xem trên). "Trường có đang bị khóa không" là một sự thật cấp
    # TRƯỜNG -- số dư ví tự nạp âm, xem SchoolSubscriptionDebtGuardService -- chứ không phải thuộc
    # tính của từng ví hạn mức, nên không có chỗ đúng cho nó trên type này.
}

"""
Gia hạn ngay bây giờ thì trường nhận được gì -- xem TRƯỚC khi đặt đơn.

KHÔNG có phần bù trừ ngày thừa: kỳ mới NỐI TIẾP kỳ đang chạy chứ không đè lên, nên trường gia hạn
sớm không mất ngày nào và cũng không có gì để bù. startsAt nói rõ kỳ mới bắt đầu lúc nào.
"""
type SchoolSubscriptionRenewalPreview {
    "true = gói gia hạn khác gói đang dùng, tức trường đang bị chuyển sang gói thay thế. FE nên làm nổi bật."
    planChanged: Boolean!
    "Gói trường đang/vừa dùng"
    currentPlan: SubscriptionPlan!
    "Gói sẽ được mua khi gia hạn -- id của nó chính là acceptedPlanId phải gửi lên khi đặt đơn"
    renewalPlan: SubscriptionPlan!
    "Kỳ mới bắt đầu chạy khi nào: ngay bây giờ nếu không còn kỳ nào hiệu lực, hoặc ngày hết hạn của kỳ hiện tại"
    startsAt: String!
    "Giá gói gia hạn, CHƯA gồm phí dịch vụ -- phí cộng vào lúc đặt đơn"
    amountDue: Float!
}

"""
Hạn mức CÁ NHÂN của một người dùng trong một ví cấp trường -- trần chi nhà trường đặt lên phần ví
người này được tiêu, KHÔNG phải một ví riêng: tiền vẫn nằm ở ví cấp trường.

quotaType = EXAM chỉ có ở giáo viên (trần cho bài kiểm tra trên lớp họ ra đề), PRACTICE chỉ có ở học
sinh. Thay cho cặp MyClassTestQuotaAllocation/MyPracticeQuotaAllocation cũ -- cùng một khái niệm thì
một kiểu là đủ.
"""
type SchoolSubscriptionQuotaUserAllocation {
    id: ID!
    userId: ID!
    schoolSubscriptionId: ID!
    quotaType: QuotaType!
    allocatedAmountVnd: Float!
    usedAmountVnd: Float!
}

type QuotaPricing {
    estimatedCostPerExamSecondUsd: Float!
    estimatedCostPerPracticeSecondUsd: Float!
    usdToVndRate: Float!
}

input SubscriptionPlanQuotaInput {
    quotaType: QuotaType!
    includedAmountVnd: Float!
}

input UpdateSubscriptionPlanInput {
    name: String
    tagline: String
    priceVnd: Float
    "periodType KHÔNG sửa được sau khi tạo (cột period_type là updatable = false) -- muốn đổi thì tạo gói mới rồi trỏ replacedByPlanId"
    periodCount: Int
    maxTimePerAttemptMin: Int
    quotas: [SubscriptionPlanQuotaInput!]
}

extend type Query {
    subscriptionPlans(page: Int = 1, size: Int = 20): SubscriptionPlanPage!
    subscriptionPlan(id: ID!): SubscriptionPlan
    quotaPricing: QuotaPricing!

    schoolSubscriptions(
        keyword: String,
        subscriptionPlanId: ID,
        status: SchoolSubscriptionStatus,
        page: Int = 1,
        size: Int = 20
    ): SchoolSubscriptionPage!
    schoolSubscription(schoolId: ID!): SchoolSubscription
    schoolSubscriptionHistory(schoolId: ID!): [SchoolSubscription!]!

    subscriptionUsage(schoolId: ID!): [SchoolSubscriptionQuotaRecord!]!
    "null = giáo viên không có hạn mức cá nhân riêng, tức chỉ ví EXAM của trường áp dụng"
    myExamQuotaAllocation: SchoolSubscriptionQuotaUserAllocation
    "null = trường CHƯA phân hạn mức PRACTICE riêng cho học sinh này, tức bị chặn hoàn toàn"
    myPracticeQuotaAllocation: SchoolSubscriptionQuotaUserAllocation

    """
    Gia hạn ngay bây giờ thì trường nhận được gì. KHÔNG nhận tham số: gói cần gia hạn là gói gần nhất
    của chính trường đang đăng nhập.

    Phải gọi query này TRƯỚC khi đặt đơn gia hạn: renewalPlan.id chính là acceptedPlanId phải gửi lên
    ở POST /api/v1/orders/renewal. Gói đang dùng có thể đã bị lưu trữ và được gán gói thay thế, khi đó
    gia hạn tự chuyển sang gói mới -- trường phải nhìn thấy và đồng ý trước.
    """
    schoolSubscriptionRenewalPreview: SchoolSubscriptionRenewalPreview!
}

extend type Mutation {
    "Trả id gói vừa sửa, không trả cả object: client tự query lại nếu cần -- xem UpdateSubscriptionPlanUseCase."
    updateSubscriptionPlan(id: ID!, input: UpdateSubscriptionPlanInput!): ID!
}

"""
Một người trong màn chia hạn mức cá nhân của trường.

Hạn mức cá nhân là TRẦN CHI mà trường tự chia nội bộ, không phải một túi tiền riêng: nó không giữ
tiền và không sinh bút toán nào. Người KHÔNG có dòng phân bổ thì không bị chặn theo cá nhân, chỉ ví
hạn mức của trường áp dụng -- xem ConsumeQuotaService.
"""
type SchoolQuotaUserAllocation {
    userId: ID!
    """
    null = CHƯA CHIA (không có dòng trong DB), khác hẳn 0 -- hai trạng thái này cho hành vi NGƯỢC
    NHAU ở cửa chặn.

    Chưa chia thì không bị chặn theo cá nhân: giáo viên tiêu thoải mái trong ví trường
    (remainingUserAllocation trả null thì cửa chặn bỏ qua), còn học sinh thì ngược lại -- LEAST(...)
    trong findPracticeSpendableFundsVnd kéo về 0 nên không luyện được lượt nào. Có dòng và bằng 0 thì
    bị chặn hẳn, ở cả hai loại.

    Client phải hiện hai nhãn khác nhau. Gộp thành cùng một số 0 sẽ giấu mất việc nửa số giáo viên
    của trường đang không có trần chi nào.
    """
    allocatedAmountVnd: Float
    usedAmountVnd: Float!
    """
    Người được chia. Nối qua data loader userById nên một trang N dòng chỉ tốn thêm ĐÚNG MỘT truy vấn
    users, không phải N. null khi tài khoản đã bị xoá khỏi hệ thống nhưng dòng phân bổ còn lại.
    """
    user: User
}

"""
Một TRANG của màn chia hạn mức, kèm hai con số tổng cho cả tập.

distributedAmountVnd phải do máy chủ tính trên TOÀN BỘ tập: giao diện chỉ cầm một trang, nên cộng
cột phân bổ của trang đó ra số sai ngay từ trang thứ hai.
"""
type SchoolQuotaUserAllocationPage {
    "Ví hạn mức cấp trường -- EXAM khi chia cho giáo viên, PRACTICE khi chia cho học sinh."
    pool: SchoolSubscriptionQuotaRecord!
    """
    Tổng đã chia cho những người CÒN đủ điều kiện, trên toàn bộ tập chứ không phải chỉ trang này.
    Người đã nghỉ việc / ra trường / đổi vai trò KHÔNG được cộng vào -- xem orphanedAmountVnd.
    """
    distributedAmountVnd: Float!
    """
    Phần đang đứng tên những người KHÔNG còn đủ điều kiện. Không tính vào trần và không hiện ở bất kỳ
    trang nào của bảng, nên phải nói thành lời: nếu không, tổng trên màn hình và tổng các dòng lệch
    nhau mà không ai giải thích được. Thường là 0.
    """
    orphanedAmountVnd: Float!
    """
    Trần phân phối của trường cho loại hạn mức này, 0..1. Mặc định 1.0 = chia được toàn bộ ví.
    Thuộc về TRƯỜNG nên sống xuyên qua mọi lần gia hạn -- xem school_quota_policies (V5).
    """
    distributableRatio: Float!
    """
    Phần ví được phép chia ra = pool x distributableRatio. Tính sẵn ở máy chủ vì đây chính là con số
    dùng để từ chối một lần chia vượt trần; client tự nhân lần nữa là mở đường cho hai bên lệch nhau.
    """
    distributableAmountVnd: Float!
    """
    Số tiền trường THẬT SỰ còn trả được cho loại hạn mức này = hạn mức kèm gói còn lại + số dư ví tự
    nạp (kẹp 0).

    KHÁC HẲN distributableAmountVnd: trần đó tính trên total_allocated và KHÔNG hề nhỏ đi khi ví bị
    tiêu, nên một trường đã tiêu cạn ví vẫn chia tiếp được tới hết trần. Dùng để CẢNH BÁO, không phải
    để chặn -- trần chi cá nhân phải ổn định suốt kỳ, còn việc chặn thì đã nằm đúng chỗ ngay trước lúc
    tốn tiền (ClassTestTokenQuotaGuardService / findPracticeSpendableFundsVnd).
    """
    spendableFundsVnd: Float!
    """
    Phần ví TỰ NẠP của trường (school_balances) CÓ THỂ ăn thêm ngoài distributableAmountVnd khi nới
    trần cá nhân của MỘT người -- không phải một túi tiền dành riêng, và dùng CHUNG cho cả EXAM lẫn
    PRACTICE. Đã kẹp về 0, âm là nợ của trường (không phải phần chia được thêm).
    """
    walletBalanceVnd: Float!
    content: [SchoolQuotaUserAllocation!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

extend type Query {
    """
    Hạn mức thi đã chia cho từng GIÁO VIÊN, có phân trang.

    Thay cho GET /v1/schools/{schoolId}/teachers/exam-quota: đường REST đó trả về mọi giáo viên
    trong một lượt và không mang tên người dùng, nên cột "Họ tên" ở client luôn rỗng.
    """
    schoolExamQuotaUserAllocations(
        schoolId: ID!,
        "Lọc theo TÊN. Bỏ trống thì không lọc."
        search: String,
        page: Int! = 1,
        size: Int! = 20
    ): SchoolQuotaUserAllocationPage!

    "Hạn mức luyện nói đã chia cho từng HỌC SINH, có phân trang."
    schoolPracticeQuotaUserAllocations(
        schoolId: ID!,
        search: String,
        page: Int! = 1,
        size: Int! = 20
    ): SchoolQuotaUserAllocationPage!
}
