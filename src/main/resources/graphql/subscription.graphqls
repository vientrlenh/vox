# Phạm vi file này: GÓI (SubscriptionPlan) và ĐĂNG KÝ CỦA TRƯỜNG (SchoolSubscription) cùng hạn mức
# đi kèm. Hóa đơn / đơn hàng / thanh toán KHÔNG nằm ở đây -- chúng là tổng hợp riêng (Order,
# PaymentRecord, Invoice, SchoolBalance) và sẽ có schema riêng.
#
# Tiền tệ: mọi trường VND đều là Float vì dự án chưa khai báo scalar riêng nào. VND không có đơn vị
# lẻ nên giá trị luôn nguyên, và numeric(15,0) tối đa vẫn nằm dưới 2^53 nên client JS đọc không mất
# độ chính xác. Đổi sang scalar BigDecimal là việc chung của cả 24 schema, không làm lẻ ở đây.

enum SubscriptionPlanStatus {
    DRAFT
    ACTIVE
    ARCHIVED
}

enum SubscriptionPlanPeriod {
    DAY
    MONTH
    YEAR
}

enum SchoolSubscriptionStatus {
    ACTIVE
    EXPIRED
    CANCELLED
    "System Admin cưỡng chế mất quyền dùng NGAY -- khác CANCELLED chỉ tắt gia hạn, vẫn dùng được tới hết endDate"
    SUSPENDED
}

enum QuotaType {
    GRADING
    CLASS_TEST
    PRACTICE
}

enum SchoolDebtEventType {
    LOCKED
    CAP_EXCEEDED
    CLEARED
}

type SubscriptionPlanQuota {
    id: ID!
    subscriptionPlanId: ID!
    quotaType: QuotaType!
    """
    Định mức bao gồm trong giá gói, quy ra VND. Không còn tokenUnitPrice đi kèm: đơn giá "VND cho
    mỗi $1" trước đây là tỷ giá đã cộng lãi nên hiển thị ra sai lệch với tỷ giá thật. Phần dùng vượt
    định mức trừ thẳng vào số dư của trường theo tỷ giá ghi ở từng lượt dùng.
    """
    includedAmountVnd: Float!
}

type SubscriptionPlan {
    id: ID!
    name: String!
    tagline: String
    priceVnd: Float!
    """
    Chu kỳ gói = periodType x periodCount (vd. MONTH x 12). Thay cho validityDays cũ: gói tính theo
    tháng/năm thì hạn phải rơi đúng ngày tương ứng, cộng thô theo số ngày sẽ lệch dần.
    """
    periodType: SubscriptionPlanPeriod!
    periodCount: Int!
    maxTimePerAttemptMin: Int!
    status: SubscriptionPlanStatus!
    version: Int!
    createdAt: String
    updatedAt: String
    createdBy: ID
    updatedBy: ID
    "Gói thay thế khi gói này đã ARCHIVED -- theo dây chuyền này để tìm gói còn bán được"
    replacedByPlanId: ID
    """
    Gói đang có nhiều trường dùng nhất TOÀN HỆ THỐNG (không phải nhiều nhất trong trang hiện tại),
    và không đếm theo số lần thanh toán: gói được thay thế sinh ra id mới nên lịch sử giao dịch nằm
    lại ở gói cũ đã ARCHIVED. Rỗng ở mọi gói khi chưa trường nào đăng ký.
    """
    isMostPopular: Boolean!
    quotas: [SubscriptionPlanQuota!]!
}

type SubscriptionPlanPage {
    content: [SubscriptionPlan!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type SchoolSubscription {
    id: ID!
    schoolId: ID!
    subscriptionPlanId: ID!
    startDate: String
    endDate: String
    status: SchoolSubscriptionStatus!
    "Giá đã trả tại thời điểm mua -- chốt cứng, không đổi theo giá gói sau này"
    pricePaidSnapshot: Float!
    cancelledAt: String
    createdAt: String
    # 3 cột suspended_* bị xóa trắng khi gỡ đình chỉ nên chỉ phản ánh lần đình chỉ ĐANG hiệu lực,
    # không phải lịch sử. Nơi lưu lịch sử bền vững hiện chưa có (FinancialEvent đã bị bỏ).
    suspendedAt: String
    suspendedReason: String
    suspendedBy: ID
    plan: SubscriptionPlan
}

type SchoolSubscriptionPage {
    content: [SchoolSubscription!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type SchoolSubscriptionQuotaRecord {
    id: ID!
    schoolSubscriptionId: ID!
    quotaType: QuotaType!
    "Định mức được cấp cho kỳ này, quy ra VND"
    totalAllocatedAmountVnd: Float!
    "Đã dùng bao nhiêu VND trong định mức trên"
    usedAmountVnd: Float!
    """
    usedAmountVnd > totalAllocatedAmountVnd -- với GRADING/CLASS_TEST đây là điều kiện khóa cấp
    trường (không cho publish/sửa bài, không cho vào thi mới cho tới khi hết nợ). Với PRACTICE chỉ
    mang tính thông tin vì ConsumeQuotaUseCase đã chặn cứng từ trước.
    """
    isLocked: Boolean!
}

# null = giáo viên gọi query không có hạn mức CLASS_TEST cá nhân riêng, chỉ pool của trường áp dụng.
type MyClassTestQuotaAllocation {
    allocatedAmountVnd: Float!
    usedAmountVnd: Float!
}

# null = học sinh gọi query không có hạn mức PRACTICE cá nhân riêng, chỉ pool của trường áp dụng.
type MyPracticeQuotaAllocation {
    allocatedAmountVnd: Float!
    usedAmountVnd: Float!
}

"""
Sổ audit "nguyên nhân nợ hạn mức AI" -- mỗi dòng là đúng 1 bucket quota của trường vừa đổi trạng
thái (vượt hạn mức / vượt trần cảnh báo / hết nợ), kèm session và số USD đã gây ra transition đó.
Xem SchoolDebtEvent (domain model) / SchoolDebtNotificationService.
"""
type SchoolDebtEvent {
    id: ID!
    schoolId: ID!
    # CỐ Ý giữ tên subscriptionId: cột này đang chứa id của ĐĂNG KÝ, dù domain model đặt tên trường
    # là subscriptionPlanId. Model mới là chỗ sai; đừng đổi tên ở đây trước khi model được sửa,
    # không thì phải đổi hai lần theo hai hướng ngược nhau.
    subscriptionId: ID!
    eventType: SchoolDebtEventType!
    quotaType: QuotaType!
    triggerExamSessionId: ID
    triggerAmountUsd: Float
    totalAllocatedUsd: Float!
    usedQuantityUsd: Float!
    overageUsd: Float!
    occurredAt: String
}

type SchoolDebtEventPage {
    content: [SchoolDebtEvent!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type QuotaPricing {
    estimatedCostPerExamSecondUsd: Float!
    estimatedCostPerPracticeSecondUsd: Float!
    usdToVndRate: Float!
}

input SubscriptionPlanQuotaItemInput {
    quotaType: QuotaType!
    includedAmountVnd: Float!
}

input UpdateSubscriptionPlanInput {
    name: String
    tagline: String
    priceVnd: Float
    "periodType KHÔNG sửa được sau khi tạo (cột period_type là updatable = false) -- muốn đổi thì tạo gói mới rồi trỏ replacedByPlanId"
    periodCount: Int
    maxTimePerAttemptMin: Int
    quotas: [SubscriptionPlanQuotaItemInput!]
}

extend type Query {
    subscriptionPlans(page: Int = 0, size: Int = 20): SubscriptionPlanPage!
    subscriptionPlan(id: ID!): SubscriptionPlan
    quotaPricing: QuotaPricing!

    schoolSubscriptions(
        keyword: String,
        subscriptionPlanId: ID,
        status: SchoolSubscriptionStatus,
        page: Int = 0,
        size: Int = 20
    ): SchoolSubscriptionPage!
    schoolSubscription(schoolId: ID!): SchoolSubscription
    schoolSubscriptionHistory(schoolId: ID!): [SchoolSubscription!]!

    subscriptionUsage(schoolId: ID!): [SchoolSubscriptionQuotaRecord!]!
    myClassTestQuotaAllocation: MyClassTestQuotaAllocation
    myPracticeQuotaAllocation: MyPracticeQuotaAllocation

    schoolDebtEvents(schoolId: ID!, page: Int = 0, size: Int = 20): SchoolDebtEventPage!
}

extend type Mutation {
    updateSubscriptionPlan(id: ID!, input: UpdateSubscriptionPlanInput!): SubscriptionPlan!
}
