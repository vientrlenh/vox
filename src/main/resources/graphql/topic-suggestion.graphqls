extend type Mutation {
    respondToTopicSuggestion(suggestionId: ID!, accept: Boolean!): Boolean!
    generateTopicFromKeyword(keyword: String!): TopicFromKeywordResult!
}

extend type Query {
    """
    Chủ đề AI gợi ý đang chờ học sinh nhận/bỏ.

    Trước đây là field `suggestions` gắn vào `InterestProfile` -- type đó đã bỏ cùng trang
    hồ sơ sở thích, nên chuyển thành query mức trên. Hiện CHƯA có màn hình nào gọi: luồng
    nhận/bỏ gợi ý vốn nằm trong trang vừa xoá. Giữ lại vì đây là một tính năng hoàn chỉnh,
    không phải mảnh vụn -- cần quyết định riêng chứ không xoá kèm.
    """
    myPendingTopicSuggestions: [TopicSuggestion!]!
}

type TopicSuggestion {
    id: ID!
    suggestedTopicName: String!
    interestDimension: String!
    confidence: Float!
    reasonText: String!
    status: String!
}

type TopicFromKeywordResult {
    topic: PracticeTopicOffer
    outcome: TopicFromKeywordOutcome!
}

enum TopicFromKeywordOutcome {
    CREATED
    MATCHED_EXISTING
    REJECTED_UNSUITABLE
    OUT_OF_EXAM_SCOPE
}
