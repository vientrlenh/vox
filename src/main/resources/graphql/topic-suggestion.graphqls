# REMOVED 2026-08-06: mutation respondToTopicSuggestion, query myPendingTopicSuggestions and
# type TopicSuggestion. The whole cluster only served topic suggestions inferred FROM WHAT THE STUDENT SAID in a
# practice session -- that path was removed in the backend, so nothing creates PENDING rows to review any more.
#
# generateTopicFromKeyword below is a DIFFERENT path and still works: the student types a keyword on their own,
# and when nothing is found the AI drafts a new topic.

extend type Mutation {
    generateTopicFromKeyword(keyword: String!): TopicFromKeywordResult!
}

type TopicFromKeywordResult {
    topic: PracticeTopicOffer
    outcome: TopicFromKeywordOutcome!
}

enum TopicFromKeywordOutcome {
    CREATED
    MATCHED_EXISTING
    REJECTED_UNSUITABLE
    OUT_OF_ASSESSMENT_SCOPE
}
