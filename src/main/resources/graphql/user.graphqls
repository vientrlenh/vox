enum Gender {
    MALE
    FEMALE
}

type User {
    id: ID!
    email: String!
    phone: String!
    fullName: String
    gender: Gender
    dateOfBirth: Date
    address: String 
    avatarUrl: String
    createdAt: DateTime
    updatedAt: DateTime
    roles: [Role!]
    school: School
}

type UserPage {
    content: [User!]!
    page: Int!
    size: Int!
    totalElements: Int!
}

type Role {
    id: ID!
    code: String!
    name: String
    createdAt: DateTime
    updatedAt: DateTime
    users(page: Int! = 1, size: Int! = 10): [User!]
}

type RolePage {
    content: [Role!]!
    page: Int!
    size: Int!
    totalElements: Int!
}

type UserRole {
    id: ID!
    userId: ID!
    roleId: ID!
    createdAt: DateTime
    user: User
    role: Role
}


extend type Query {
    users(page: Int! = 1, size: Int! = 20): UserPage!
    user(id: ID!): User
    roles(page: Int! = 1, size: Int! = 20): RolePage!
    role(id: ID!): Role
    profile: User
}

"""
Every field is optional and has PATCH semantics: NOT sending a field = keep it unchanged, sending null = clear it.
The mapper tells the two cases apart with Map.containsKey, see UpdateProfileCommandMapper.
So avatarUrl: null is the operation that removes the avatar -- there is no separate removeAvatar mutation.

avatarUrl is the URL the client gets after uploading the image ITSELF to its own storage (currently
Firebase Storage). The backend only stores the reference and never receives the file. The URL must be https
and, if app.avatar.allowed-hosts is configured, its host must be in that list.
"""
input UpdateProfileInput {
    fullName: String
    phone: String
    address: String
    dateOfBirth: Date
    avatarUrl: String
}

extend type Mutation {
    "Edits the caller's own profile. Takes no userId -- to edit another user use updateSchoolUser."
    updateProfile(input: UpdateProfileInput!): User!
}